+}
+
+/* DMALL theme: royal blue (#0058f8 family) on pale blue-white, soft rounded cards. Colors sampled from the DMALL illustration set. */
+.theme-dmall {
+    --colorPrimary: #1f6bff;
+    --colorPrimaryShadow: transparent;
+    --colorPrimaryLight: #b8d0f8;
+    --colorPrimaryDark: #0058f8;
+    --colorOnPrimary: #ffffff;
+    --colorOnPrimaryLight: #0b2a66;
+    --colorSurface: #eef4ff;
+    --colorOnSurface: #16294d;
+    --colorTextPrimary: #16294d;
+    --colorTextLight: #5b6b8c;
+    --colorBorder: rgba(31, 107, 255, .16);
+    --colorBackground: #ffffff;
+    --colorWindowBackground: #eef4ff;
+}
+
+.theme-dmall .card {
+    border-radius: 16px;
+    border-color: rgba(31, 107, 255, .12);
+    box-shadow: 0 8px 28px rgba(31, 107, 255, .08), 0 1px 3px rgba(22, 41, 77, .06);
+}
+
+.theme-dmall .btn {
+    border-radius: 10px;
+}
+
+.theme-dmall .btn-primary {
+    background-image: linear-gradient(135deg, #3880f8 0%, #0058f8 100%);
+    border-color: #0058f8;
+}
+
+.theme-dmall .btn-primary:hover,
+.theme-dmall .btn-primary:focus {
+    background-image: linear-gradient(135deg, #0058f8 0%, #0049cf 100%);
+}
+
+.theme-dmall .page-header h4 {
+    color: #0b2a66;
+}
+
+.theme-dmall .nav-tabs .nav-link.active {
+    color: var(--colorPrimaryDark);
+    border-bottom: 3px solid var(--colorPrimary);
+    background: transparent;
+}
+
+.theme-dmall .table thead th {
+    background-color: #eef4ff;
+    color: #0b2a66;
+}
+
+/* Illustration beside the Intelligent Hub tab it belongs to (DMALL inspired artwork) */
+.hub-art {
+    float: right;
+    width: 150px;
+    max-width: 28vw;
+    margin: -6px 0 8px 16px;
+    border-radius: 14px;
+    pointer-events: none;
+}
+
+.theme-customizer .color .indigator.theme-dmall {
+    background-image: linear-gradient(135deg, #3880f8 0%, #0058f8 100%) !important;
+}

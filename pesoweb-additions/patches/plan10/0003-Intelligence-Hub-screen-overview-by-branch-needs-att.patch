+<!-- Main Content -->
+<div class="main-content">
+	<div class="page-header">
+		<div class="page-block">
+			<div class="row align-items-center">
+				<div class="col-auto">
+					<div class="page-header-title">
+						<h4>{{app.Localize('Intelligence Hub')}}</h4>
+					</div>
+					<ul class="breadcrumb">
+						<li class="breadcrumb-item">
+							<a [routerLink]="['/']">
+								<i class="fa fa-home me-1"></i>
+								{{app.Localize('Home')}}
+							</a>
+						</li>
+						<li class="breadcrumb-item">{{app.Localize('Intelligence Hub')}}</li>
+					</ul>
+				</div>
+				<div class="col">
+					<div class="float-end">
+						<button type="button" class="btn btn-outline-secondary" (click)="load()" [disabled]="loading">
+							<i class="fa fa-rotate me-1"></i>{{app.Localize('Refresh')}}
+						</button>
+					</div>
+				</div>
+			</div>
+		</div>
+	</div>
+
+	<div class="alert alert-danger" *ngIf="error">{{error}}</div>
+	<div class="alert alert-success" *ngIf="message">{{message}}</div>
+

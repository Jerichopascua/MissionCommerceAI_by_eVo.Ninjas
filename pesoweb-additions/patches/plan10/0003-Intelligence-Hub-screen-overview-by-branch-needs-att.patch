+		<div class="hub-note">
+			{{company ? company.companyName : ''}} &middot; {{totals.branches}} {{app.Localize('branches')}} &middot;
+			{{app.Localize('Today so far, updated')}} {{overview ? (overview.generatedAt | date:'shortTime') : ''}}.
+			{{app.Localize('Performance by branch, what needs attention, and every AI setting, in one place.')}}
+		</div>
+	</div>
+
+	<ul class="nav nav-tabs mb-3">
+		<li class="nav-item"><a class="nav-link" [class.active]="tab==='overview'" style="cursor:pointer" (click)="tab='overview'">{{app.Localize('Overview')}}</a></li>
+		<li class="nav-item"><a class="nav-link" [class.active]="tab==='settings'" style="cursor:pointer" (click)="tab='settings'">{{app.Localize('AI Settings')}}</a></li>
+	</ul>
+
+	<!-- ============================ OVERVIEW ============================ -->
+	<div *ngIf="tab==='overview'">
+		<div class="row g-3 mb-3">
+			<div class="col-6 col-lg-2"><div class="hub-tile"><div class="label">{{app.Localize('Sales today')}}</div><div class="value">{{money(totals.salesToday)}}</div></div></div>
+			<div class="col-6 col-lg-2"><div class="hub-tile"><div class="label">{{app.Localize('Transactions')}}</div><div class="value">{{totals.transactionsToday}}</div></div></div>
+			<div class="col-6 col-lg-2"><div class="hub-tile" [class.alert]="totals.openExceptions>0"><div class="label">{{app.Localize('Open exceptions')}}</div><div class="value">{{totals.openExceptions}}</div></div></div>
+			<div class="col-6 col-lg-2"><div class="hub-tile"><div class="label">{{app.Localize('Expiry at risk')}}</div><div class="value">{{money(totals.expiryAtRiskPesos)}}</div></div></div>
+			<div class="col-6 col-lg-2"><div class="hub-tile good"><div class="label">{{app.Localize('Active markdowns')}}</div><div class="value">{{totals.activeMarkdowns}}</div></div></div>
+			<div class="col-6 col-lg-2"><div class="hub-tile" [class.alert]="waiting>0"><div class="label">{{app.Localize('AI proposals waiting')}}</div><div class="value">{{waiting}}</div></div></div>
+		</div>
+
+		<div class="hub-section">
+			<h5>{{app.Localize('Compare your branches')}}</h5>
+			<div class="hub-note mb-2">{{app.Localize('The same numbers for every branch, side by side. A branch is flagged when it has an open exception, expired stock not written off, or a cash difference.')}}</div>
+			<div class="table-responsive">
+				<table class="table align-middle">
+					<thead>
+						<tr>
+							<th>{{app.Localize('Branch')}}</th><th class="bar-cell">{{app.Localize('Sales today')}}</th><th class="text-end">{{app.Localize('Transactions')}}</th>
+							<th class="text-end">{{app.Localize('Cash difference')}}</th><th class="text-end">{{app.Localize('Expiry at risk')}}</th><th class="text-end">{{app.Localize('Expired, not written off')}}</th>
+							<th class="text-end">{{app.Localize('Markdowns')}}</th><th class="text-end">{{app.Localize('Exceptions')}}</th><th>{{app.Localize('Status')}}</th>
+						</tr>
+					</thead>
+					<tbody>
+						<tr *ngFor="let b of branchRows">
+							<td>{{b.name}}</td>
+							<td class="bar-cell"><div>{{money(b.salesToday)}}</div><div class="bar"><span [style.width.%]="salesShare(b)"></span></div></td>
+							<td class="text-end">{{b.transactionsToday}}</td>
+							<td class="text-end">{{money(b.cashVarianceToday)}}</td>
+							<td class="text-end">{{money(b.expiryAtRiskPesos)}}</td>
+							<td class="text-end">{{money(b.expiredUnwrittenPesos)}}</td>
+							<td class="text-end">{{b.activeMarkdowns}}</td>
+							<td class="text-end">{{b.openExceptions}}</td>
+							<td><span class="pill" [class.ok]="!branchNeedsCheck(b)" [class.check]="branchNeedsCheck(b)">{{branchNeedsCheck(b) ? app.Localize('Check') : app.Localize('OK')}}</span></td>
+						</tr>
+						<tr *ngIf="!branchRows.length"><td colspan="9" class="text-center text-muted py-4">{{app.Localize('No branch data yet.')}}</td></tr>
+					</tbody>
+				</table>
+			</div>
+		</div>
+
+		<div class="hub-section">
+			<h5>{{app.Localize('Needs attention')}}</h5>
+			<div class="hub-note mb-2">{{app.Localize('Each line is a plain rule on today\'s numbers. Click through to the screen where it is handled.')}}</div>
+			<div class="rule-row" *ngFor="let r of attention">
+				<span class="pill" [class.check]="r.bad" [class.info]="r.info" [class.ok]="!r.bad && !r.info">{{r.bad ? app.Localize('Act') : (r.info ? app.Localize('Watch') : app.Localize('Clear'))}}</span>
+				<div class="flex-grow-1">{{r.title}}</div>
+				<div class="fw-bold">{{r.count}}</div>
+				<a *ngIf="r.link" [routerLink]="[r.link]" class="small">{{r.linkText}}</a>
+			</div>
+		</div>
+	</div>
+
+	<!-- ============================ AI SETTINGS ============================ -->
+	<div *ngIf="tab==='settings'">
+		<div class="hub-section">
+			<h5>{{app.Localize('This company')}}: {{featuresOn}} {{app.Localize('of')}} {{features.length}} {{app.Localize('AI features on')}}</h5>
+			<div class="hub-note mb-2">{{app.Localize('Switching one off takes effect at once: PesoWeb refuses what that AI proposes. To run one now, or to see its last result, open AI Control.')}}
+				<a [routerLink]="['/ai/control']">{{app.Localize('AI Control')}}</a></div>
+			<div class="table-responsive">
+				<table class="table align-middle mb-0">
+					<tbody>
+						<tr *ngFor="let f of features">
+							<td style="width:260px"><b>{{f.name}}</b></td>
+							<td><span class="pill" [class.ok]="f.buildState==='Built'" [class.info]="f.buildState==='Partial'" [class.check]="f.buildState==='NotBuilt'">{{f.buildState==='Built' ? 'Built' : (f.buildState==='Partial' ? 'Partly built' : 'Not built yet')}}</span></td>
+							<td class="hub-note">{{f.description}}</td>
+							<td class="text-end">
+								<div class="form-check form-switch d-inline-block">
+									<input class="form-check-input" type="checkbox" role="switch" [checked]="f.enabled" [disabled]="busy===f.key" (change)="toggleFeature(f)">
+								</div>
+							</td>
+						</tr>
+					</tbody>
+				</table>
+			</div>
+			<div class="hub-note mt-2">{{app.Localize('Margin floors, approval lanes and auto-approve are set in')}} <a [routerLink]="['/pricing/approvals']">{{app.Localize('Approval Center, Settings')}}</a>.</div>
+		</div>
+
+		<div class="hub-section">
+			<h5>{{app.Localize('Branches')}}</h5>
+			<div class="hub-note mb-2">{{app.Localize('Per branch: whether the AI may mark prices down there, and the hour of the day before which it may not. A person can still mark down by hand. Both rules are enforced by PesoWeb.')}}</div>
+			<div class="table-responsive">
+				<table class="table align-middle mb-0">
+					<thead><tr><th>{{app.Localize('Branch')}}</th><th>{{app.Localize('AI markdowns')}}</th><th>{{app.Localize('Not before')}}</th><th></th></tr></thead>
+					<tbody>
+						<tr *ngFor="let b of branches">
+							<td>{{b.name}}</td>
+							<td>
+								<div class="form-check form-switch">
+									<input class="form-check-input" type="checkbox" role="switch" [(ngModel)]="b.pricingEnabled">
+									<label class="form-check-label small">{{b.pricingEnabled ? app.Localize('On') : app.Localize('Off')}}</label>
+								</div>
+							</td>
+							<td style="width:200px">
+								<select class="form-select form-select-sm" [(ngModel)]="b.clearanceStartHour">
+									<option [ngValue]="null">{{app.Localize('Any time')}}</option>
+									<option *ngFor="let h of hours" [ngValue]="h">{{h < 10 ? '0' + h : h}}:00</option>
+								</select>
+							</td>
+							<td class="text-end"><button type="button" class="btn btn-sm btn-primary" (click)="saveBranch(b)" [disabled]="busy==='b' + b.warehouseId">{{app.Localize('Save')}}</button></td>
+						</tr>
+						<tr *ngIf="!branches.length"><td colspan="4" class="text-center text-muted py-3">{{app.Localize('No branches.')}}</td></tr>
+					</tbody>
+				</table>
+			</div>
+		</div>
+
+		<div class="hub-section" *ngIf="isHead">
+			<h5>{{app.Localize('All companies')}} ({{allCompanies.length}})</h5>
+			<div class="hub-note mb-2">{{app.Localize('Head company only. Every company\'s AI settings in one table (read only). Type to filter by name, email or number.')}}</div>
+			<input type="text" class="form-control mb-2" style="max-width:320px" [(ngModel)]="search" placeholder="Filter companies">
+			<div class="table-responsive">
+				<table class="table align-middle mb-0">
+					<thead>
+						<tr><th>#</th><th>{{app.Localize('Company')}}</th><th>{{app.Localize('AI features on')}}</th><th>{{app.Localize('Pricing autonomy')}}</th><th class="text-end">{{app.Localize('Hard floor')}}</th><th class="text-end">{{app.Localize('Soft floor')}}</th>
+							<th>{{app.Localize('Auto-approve')}}</th><th class="text-end">{{app.Localize('Waiting')}}</th><th class="text-end">{{app.Localize('Branches')}}</th><th class="text-end">{{app.Localize('Branches AI off')}}</th></tr>
+					</thead>
+					<tbody>
+						<tr *ngFor="let c of companyRows">
+							<td>{{c.tenantId}}</td>
+							<td>{{c.company}}<div class="hub-note">{{c.email}}</div></td>
+							<td><span class="pill" [class.ok]="c.featuresOn===c.featuresTotal" [class.info]="c.featuresOn<c.featuresTotal">{{c.featuresOn}} / {{c.featuresTotal}}</span></td>
+							<td>{{c.autonomyMode}}<span class="hub-note" *ngIf="!c.policyConfigured"> ({{app.Localize('no policy')}})</span></td>
+							<td class="text-end">{{c.policyConfigured ? c.hardMarginFloorPct + '%' : '-'}}</td>
+							<td class="text-end">{{c.policyConfigured ? c.softMarginFloorPct + '%' : '-'}}</td>

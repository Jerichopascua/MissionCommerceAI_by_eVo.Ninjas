+					</tbody>
+				</table>
+			</div>
+			<div class="hub-note mt-2" *ngIf="allCompanies.length > 60">{{app.Localize('Showing the first 60 matches. Filter to narrow it down.')}}</div>
+		</div>
+	</div>
+</div>
diff --git a/ClientApp/src/app/ai/aihub/aihub.component.ts b/ClientApp/src/app/ai/aihub/aihub.component.ts

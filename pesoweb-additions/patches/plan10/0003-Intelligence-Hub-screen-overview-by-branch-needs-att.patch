+import { Component, Inject, OnInit } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { AppService } from '../../services/app.service';
+
+// The Intelligence Hub: one place that shows how the company is doing right now (by branch), what needs attention, and the AI settings
+// at every level: this company, each branch, and (for the head company) every company.
+@Component({
+  selector: 'app-aihub',
+  templateUrl: './aihub.component.html',
+  styles: [`
+    .hub-hero { background: linear-gradient(120deg, #e8f1ff 0%, #f6faff 55%, #fff6ec 100%); border: 1px solid #dbe7fb; border-radius: 16px; padding: 22px 26px; margin-bottom: 18px; }
+    .hub-hero h2 { font-weight: 700; margin: 0 0 4px; }
+    .hub-tile { border: 1px solid #e3ebf8; border-radius: 14px; background: #fff; padding: 14px 16px; height: 100%; }
+    .hub-tile .label { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: #6b7a90; }
+    .hub-tile .value { font-size: 26px; font-weight: 700; }
+    .hub-tile.alert { border-color: #f3c6c6; background: #fff7f7; }
+    .hub-tile.good { border-color: #cfe8d8; background: #f6fcf8; }
+    .hub-section { border: 1px solid #e3ebf8; border-radius: 14px; background: #fff; padding: 16px 18px; margin-bottom: 18px; }
+    .hub-section h5 { font-weight: 700; margin-bottom: 2px; }
+    .hub-note { font-size: 13px; color: #6b7a90; }
+    .bar-cell { min-width: 120px; }
+    .bar-cell .bar { height: 8px; border-radius: 6px; background: #dce9ff; }
+    .bar-cell .bar > span { display: block; height: 8px; border-radius: 6px; background: #3b82f6; }
+    .rule-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid #eef2f9; }
+    .rule-row:first-of-type { border-top: 0; }
+    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
+    .pill.ok { background: #e6f6ec; color: #1a7f43; }
+    .pill.check { background: #fdecec; color: #b42323; }
+    .pill.info { background: #e8f1ff; color: #1f55b5; }
+  `]
+})
+export class AiHubComponent implements OnInit {
+  public tab = 'overview';
+  public loading = false;
+  public error = '';
+  public message = '';
+
+  public overview: any = null;            // this company, today, by branch
+  public waiting = 0;                     // AI proposals waiting in the Approval Center
+  public features: any[] = [];
+  public branches: any[] = [];
+  public isHead = false;
+  public allCompanies: any[] = [];        // head company: every company's AI settings
+  public search = '';
+  public busy = '';
+  public hours = Array.from({ length: 24 }, (_, i) => i);
+
+  constructor(
+    private http: HttpClient,
+    @Inject('BASE_URL') private baseUrl: string,
+    public app: AppService
+  ) { }
+
+  ngOnInit(): void { this.load(); }
+
+  public load(): void {
+    this.loading = true;
+    this.error = '';
+    this.http.get<any>(this.baseUrl + 'api/ai/hub/overview').subscribe({
+      next: (o) => { this.overview = o; this.loading = false; },
+      error: (e) => { this.error = this.messageOf(e, 'Could not load the overview.'); this.loading = false; }
+    });
+    this.http.get<any>(this.baseUrl + 'api/pricing/approvals').subscribe({ next: (q) => (this.waiting = q.summary ? q.summary.waiting : 0), error: () => { } });
+    this.http.get<any[]>(this.baseUrl + 'api/ai/control').subscribe({ next: (f) => (this.features = f), error: () => { } });
+    this.http.get<any[]>(this.baseUrl + 'api/ai/branch-settings').subscribe({ next: (b) => (this.branches = b), error: () => { } });
+    // Only the head company is allowed this one; everyone else gets a refusal and simply does not see the section.
+    this.http.get<any[]>(this.baseUrl + 'api/ai/settings-overview').subscribe({
+      next: (rows) => { this.allCompanies = rows; this.isHead = true; },
+      error: () => { this.isHead = false; }
+    });
+  }
+
+  // ---- overview -------------------------------------------------------------------------------------------------------
+  public get company(): any {
+    return this.overview && this.overview.tenants && this.overview.tenants.length ? this.overview.tenants[0] : null;
+  }
+
+  public get totals(): any {
+    return this.company ? this.company.totals : { salesToday: 0, transactionsToday: 0, openExceptions: 0, expiryAtRiskPesos: 0, activeMarkdowns: 0, cashVarianceToday: 0, expiredUnwrittenPesos: 0, branches: 0 };
+  }
+
+  public get branchRows(): any[] {
+    const rows = this.company ? [...this.company.branches] : [];
+    return rows.sort((a, b) => b.salesToday - a.salesToday);
+  }
+
+  public salesShare(b: any): number {
+    const max = Math.max(1, ...this.branchRows.map(x => x.salesToday));
+    return Math.round(b.salesToday / max * 100);
+  }
+
+  public branchNeedsCheck(b: any): boolean {
+    return b.openExceptions > 0 || b.expiredUnwrittenPesos > 0 || Math.abs(b.cashVarianceToday) > 0.005;
+  }
+
+  // The rules behind "needs attention": each is a plain check on today's numbers, with the screen to go to.
+  public get attention(): any[] {
+    const t = this.totals;
+    const list: any[] = [];
+    list.push({ title: 'AI price proposals waiting for a decision', count: this.waiting, link: '/pricing/approvals', linkText: 'Open the Approval Center', bad: this.waiting > 0 });
+    list.push({ title: 'Open exceptions', count: t.openExceptions, link: '', linkText: '', bad: t.openExceptions > 0 });
+    list.push({ title: 'Expired stock not yet written off', count: this.money(t.expiredUnwrittenPesos), link: '/inventory/nearexpiry', linkText: 'Open near-expiry monitoring', bad: t.expiredUnwrittenPesos > 0 });
+    list.push({ title: 'Stock close to expiry (at cost)', count: this.money(t.expiryAtRiskPesos), link: '/inventory/nearexpiry', linkText: 'Open near-expiry monitoring', bad: false, info: t.expiryAtRiskPesos > 0 });
+    list.push({ title: 'Cash shifts closed with a difference today', count: this.money(t.cashVarianceToday), link: '', linkText: '', bad: Math.abs(t.cashVarianceToday) > 0.005 });
+    return list;
+  }
+
+  public money(n: number): string {
+    return '₱' + Number(n || 0).toLocaleString(undefined, { maximumFractionDigits: 0 });
+  }
+
+  // ---- AI settings: this company ---------------------------------------------------------------------------------------
+  public get featuresOn(): number { return this.features.filter(f => f.enabled).length; }
+
+  public toggleFeature(f: any): void {
+    if (this.busy) { return; }
+    this.busy = f.key; this.error = ''; this.message = '';
+    this.http.put<any[]>(this.baseUrl + 'api/ai/control/' + f.key, { enabled: !f.enabled }).subscribe({
+      next: (r) => { this.features = r; this.busy = ''; this.message = f.name + (f.enabled ? ' is now off.' : ' is now on.'); },
+      error: (e) => { this.busy = ''; this.error = this.messageOf(e, 'Could not change the switch.'); this.load(); }
+    });
+  }
+
+  // ---- AI settings: branches -------------------------------------------------------------------------------------------
+  public saveBranch(b: any): void {
+    if (this.busy) { return; }
+    this.busy = 'b' + b.warehouseId; this.error = ''; this.message = '';
+    const hour = b.clearanceStartHour === '' || b.clearanceStartHour === undefined ? null : b.clearanceStartHour;
+    this.http.put<any[]>(this.baseUrl + 'api/ai/branch-settings/' + b.warehouseId, { pricingEnabled: b.pricingEnabled, clearanceStartHour: hour }).subscribe({
+      next: (r) => { this.branches = r; this.busy = ''; this.message = 'Saved the AI settings for ' + b.name + '.'; },
+      error: (e) => { this.busy = ''; this.error = this.messageOf(e, 'Could not save the branch settings.'); }
+    });
+  }
+
+  // ---- AI settings: every company (head company) -----------------------------------------------------------------------
+  public get companyRows(): any[] {
+    const q = this.search.trim().toLowerCase();
+    return this.allCompanies.filter(c => !q || (c.company || '').toLowerCase().includes(q) || (c.email || '').toLowerCase().includes(q) || String(c.tenantId) === q)
+      .slice(0, 60);
+  }
+
+  private messageOf(e: any, fallback: string): string {
+    return (e && e.error && (e.error.message || e.error.title)) || fallback;
+  }
+}

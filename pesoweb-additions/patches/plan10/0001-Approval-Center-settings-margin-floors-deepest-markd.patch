From 1cdf8dfbb9e840ee741d3b2e158ce1402368a587 Mon Sep 17 00:00:00 2001
From: unknown <jericho.pascua@gmail.com>
Date: Tue, 6 Oct 2026 15:04:39 +0800
Subject: [PATCH 1/3] Approval Center settings: margin floors, deepest markdown
 and change-rate limit can be set on screen

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../approvalcenter/approvalcenter.component.html | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/ClientApp/src/app/pricing/approvalcenter/approvalcenter.component.html b/ClientApp/src/app/pricing/approvalcenter/approvalcenter.component.html
index ea8e48a..e6381c0 100644
--- a/ClientApp/src/app/pricing/approvalcenter/approvalcenter.component.html
+++ b/ClientApp/src/app/pricing/approvalcenter/approvalcenter.component.html
@@ -81,6 +81,22 @@
 						<option value="Off">Off</option>
 					</select>
 				</div>
+				<div class="col-md-3">
+					<label class="form-label">{{app.Localize('Hard margin floor: never below cost plus (%)')}}</label>
+					<input type="number" class="form-control" [(ngModel)]="policy.hardMarginFloorPct">
+				</div>
+				<div class="col-md-3">
+					<label class="form-label">{{app.Localize('Soft margin floor: below this needs a person (%)')}}</label>
+					<input type="number" class="form-control" [(ngModel)]="policy.softMarginFloorPct">
+				</div>
+				<div class="col-md-3">
+					<label class="form-label">{{app.Localize('Deepest markdown allowed (%)')}}</label>
+					<input type="number" class="form-control" [(ngModel)]="policy.maxDiscountPct">
+				</div>
+				<div class="col-md-3">
+					<label class="form-label">{{app.Localize('Most price changes per product per hour')}}</label>
+					<input type="number" class="form-control" [(ngModel)]="policy.maxChangesPerSkuPerHour">
+				</div>
 				<div class="col-md-3">
 					<label class="form-label">{{app.Localize('Store manager lane: moves up to (%)')}}</label>
 					<input type="number" class="form-control" [(ngModel)]="policy.storeLaneMaxPct">
-- 
2.46.0.windows.1


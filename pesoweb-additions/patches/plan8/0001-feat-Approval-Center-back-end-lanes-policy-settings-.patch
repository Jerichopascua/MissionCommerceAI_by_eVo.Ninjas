@@ -0,0 +1,342 @@
+using GoPosify.Models;
+using GoPosify.Services;
+using Microsoft.EntityFrameworkCore;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class ApprovalLanesTests
+{
+    private static PricingPolicy P() => PricingFixtures.Policy();   // store lane up to 5%, owner lane above 8%
+
+    [Fact]
+    public void A_small_learned_safe_change_goes_to_the_store_lane()
+        => Assert.Equal(ApprovalLanes.Store, ApprovalLanes.Route(P(), 4m, false, false, ApprovalLanes.Learned));
+
+    [Theory]
+    [InlineData(6, false, false, "learned")]       // bigger than the store size
+    [InlineData(3, true, false, "learned")]        // a top seller
+    [InlineData(3, false, true, "learned")]        // below the soft floor
+    [InlineData(3, false, false, "assumed")]       // only an assumed sensitivity
+    public void Anything_riskier_leaves_the_store_lane(decimal pct, bool top, bool belowSoft, string confidence)
+        => Assert.NotEqual(ApprovalLanes.Store, ApprovalLanes.Route(P(), pct, top, belowSoft, confidence));
+
+    [Fact]
+    public void A_big_move_on_a_top_seller_or_below_the_soft_floor_goes_to_the_owner()
+    {
+        Assert.Equal(ApprovalLanes.Owner, ApprovalLanes.Route(P(), 10m, true, false, ApprovalLanes.Learned));
+        Assert.Equal(ApprovalLanes.Owner, ApprovalLanes.Route(P(), -12m, false, true, ApprovalLanes.Learned));
+        Assert.Equal(ApprovalLanes.Pricing, ApprovalLanes.Route(P(), 10m, false, false, ApprovalLanes.Learned));
+    }
+
+    [Fact]
+    public void The_size_is_absolute_so_a_decrease_routes_like_an_increase()
+        => Assert.Equal(ApprovalLanes.Store, ApprovalLanes.Route(P(), -4m, false, false, ApprovalLanes.Learned));
+
+    [Fact]
+    public void Thresholds_come_from_the_policy()
+    {
+        var p = P();
+        p.StoreLaneMaxPct = 2m;
+        Assert.NotEqual(ApprovalLanes.Store, ApprovalLanes.Route(p, 4m, false, false, ApprovalLanes.Learned));
+    }
+
+    [Fact]
+    public void Auto_approve_needs_the_setting_autonomy_the_store_lane_and_a_small_move()
+    {
+        var p = P();
+        Assert.False(ApprovalLanes.EligibleForAutoApprove(p, ApprovalLanes.Store, 3m));          // off by default
+        p.ListPriceAutoApprove = true;
+        Assert.True(ApprovalLanes.EligibleForAutoApprove(p, ApprovalLanes.Store, 3m));
+        Assert.False(ApprovalLanes.EligibleForAutoApprove(p, ApprovalLanes.Store, 6m));          // over the auto limit
+        Assert.False(ApprovalLanes.EligibleForAutoApprove(p, ApprovalLanes.Pricing, 3m));        // wrong lane
+        p.AutonomyMode = AutonomyModes.Approval;
+        Assert.False(ApprovalLanes.EligibleForAutoApprove(p, ApprovalLanes.Store, 3m));
+    }
+
+    [Fact]
+    public void Permissions_nest_owner_over_pricing_over_store_and_the_legacy_permission_still_works()
+    {
+        Assert.True(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermOwner }, ApprovalLanes.Owner));
+        Assert.True(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermPricing }, ApprovalLanes.Store));
+        Assert.False(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermPricing }, ApprovalLanes.Owner));
+        Assert.True(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermStore }, ApprovalLanes.Store));
+        Assert.False(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermStore }, ApprovalLanes.Pricing));
+        Assert.True(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermLegacy }, ApprovalLanes.Owner));      // only the old permission: any lane
+        Assert.False(ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermLegacy, ApprovalLanes.PermStore }, ApprovalLanes.Pricing));
+        Assert.False(ApprovalLanes.CanApprove(Array.Empty<string>(), ApprovalLanes.Store));
+    }
+}
+
+public class ApprovalCenterServiceTests
+{
+    private static readonly DateTime Now = new(2026, 10, 20, 10, 0, 0);
+
+    private sealed class World
+    {
+        public TestAppDbContext Db;
+        public ListPriceService Svc;
+        public ApprovalQueueService Queue;
+        public Product Product;
+    }
+
+    private static async Task<World> CreateAsync(Action<PricingPolicy> tweak = null, decimal price = 100m, decimal cost = 60m)
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        var policy = PricingFixtures.Policy();
+        policy.MaxChangesPerSkuPerHour = 10;
+        tweak?.Invoke(policy);
+        db.PricingPolicies.Add(policy);
+        var product = PricingFixtures.NewProduct(price: price, cost: cost, monitorExpiry: false);
+        db.Products.Add(product);
+        await db.SaveChangesAsync();
+        var svc = new ListPriceService(db, PricingFixtures.Publisher(db));
+        return new World { Db = db, Svc = svc, Queue = new ApprovalQueueService(db, svc), Product = product };
+    }
+
+    private static ListPriceProposal Propose(World w, decimal price, string confidence = "learned") => new()
+    {
+        WarehouseId = 1, ProductId = w.Product.Id, NewPrice = price, Reason = "advisor", PredictionRef = "adv-1",
+        Confidence = confidence, ExpectedGainPerDay = 5m, ExpectedGainConservativePerDay = 3m, Evidence = "learned -1.4"
+    };
+
+    private static decimal Price(World w) => w.Db.Products.AsNoTracking().Single(p => p.Id == w.Product.Id).Price;
+
+    [Fact]
+    public async Task A_proposal_is_routed_and_carries_its_evidence_and_an_expiry()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var o = await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Ai, 9, Now);
+        var pc = w.Db.PriceChanges.Single();
+        Assert.Equal(ApprovalLanes.Store, o.Lane);
+        Assert.Equal(ApprovalLanes.Store, pc.Lane);
+        Assert.Equal("learned", pc.Confidence);
+        Assert.Equal(5m, pc.ExpectedGainPerDay);
+        Assert.Equal(3m, pc.ExpectedGainConservativePerDay);
+        Assert.Equal("learned -1.4", pc.Evidence);
+        Assert.Equal(Now.AddHours(48), pc.ExpiresAt);
+    }
+
+    [Fact]
+    public async Task An_assumed_sensitivity_routes_to_the_pricing_lane()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        Assert.Equal(ApprovalLanes.Pricing, (await w.Svc.ProposeAsync(Propose(w, 103m, "assumed"), PriceChangeSource.Ai, 9, Now)).Lane);
+    }
+
+    [Fact]
+    public async Task Auto_approve_applies_a_small_learned_ai_change_immediately_and_logs_it_as_auto()
+    {
+        var w = await CreateAsync(p => p.ListPriceAutoApprove = true);
+        await using var _ = w.Db;
+
+        var o = await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Ai, 9, Now);
+
+        Assert.Equal(GuardrailDecision.Allowed, o.Decision);
+        Assert.Equal("AUTO_APPROVED", o.Code);
+        Assert.Equal("Auto", o.DecisionKind);
+        Assert.Equal(103m, Price(w));
+        var pc = w.Db.PriceChanges.Single();
+        Assert.Equal((PriceChangeStatus.Applied, "Auto", null), (pc.Status, pc.DecisionKind, pc.DecidedBy));
+        Assert.Contains("\"decisionKind\":\"Auto\"", Assert.Single(w.Db.BusinessEvents.ToList()).PayloadJson);
+    }
+
+    [Fact]
+    public async Task Auto_approve_never_applies_assumed_big_or_manual_changes()
+    {
+        var w = await CreateAsync(p => p.ListPriceAutoApprove = true);
+        await using var _ = w.Db;
+        Assert.Equal(GuardrailDecision.NeedsApproval, (await w.Svc.ProposeAsync(Propose(w, 103m, "assumed"), PriceChangeSource.Ai, 9, Now)).Decision);
+        Assert.Equal(GuardrailDecision.NeedsApproval, (await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now.AddMinutes(1))).Decision);
+        Assert.Equal(GuardrailDecision.NeedsApproval, (await w.Svc.ProposeAsync(Propose(w, 102m), PriceChangeSource.Manual, 9, Now.AddMinutes(2))).Decision);
+        Assert.Equal(100m, Price(w));
+    }
+
+    [Fact]
+    public async Task Auto_approve_stays_off_unless_the_tenant_turns_it_on()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        Assert.Equal(GuardrailDecision.NeedsApproval, (await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Ai, 9, Now)).Decision);
+        Assert.Equal(100m, Price(w));
+    }
+
+    [Fact]
+    public async Task A_top_seller_is_not_store_lane_even_for_a_small_move()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var sale = new Sale { WarehouseId = 1, SaleDate = Now.AddDays(-1), TotalAmount = 500m, PaymentMethod = "Cash", PaymentStatus = 1, OrderStatus = 1 };
+        w.Db.Sales.Add(sale);
+        await w.Db.SaveChangesAsync();
+        w.Db.SaleDetails.Add(new SaleDetail { SaleId = sale.Id, ProductId = w.Product.Id, Quantity = 5, Price = 100m, SalePrice = 100m, Amount = 500m });
+        await w.Db.SaveChangesAsync();
+
+        Assert.True(await w.Svc.IsTopSellerAsync(w.Product.Id, Now));
+        Assert.Equal(ApprovalLanes.Pricing, (await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Ai, 9, Now)).Lane);
+    }
+
+    [Fact]
+    public async Task A_proposal_that_nobody_decided_in_time_is_closed_not_approved_late()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Ai, 9, Now);
+        var o = await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now.AddHours(49));
+        Assert.Equal("PROPOSAL_EXPIRED", o.Code);
+        Assert.Equal(100m, Price(w));
+    }
+
+    [Fact]
+    public async Task A_person_cannot_approve_their_own_manual_proposal_unless_they_are_the_only_user()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Manual, 7, Now);
+        await Assert.ThrowsAsync<InvalidOperationException>(() => w.Svc.ApproveAsync(p.PriceChangeId, 7, Now, allowSelfApproval: false));
+        Assert.Equal(100m, Price(w));
+        Assert.Equal(GuardrailDecision.Allowed, (await w.Svc.ApproveAsync(p.PriceChangeId, 8, Now, allowSelfApproval: false)).Decision);   // another person
+    }
+
+    [Fact]
+    public async Task One_person_shops_may_approve_their_own_proposal()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Manual, 7, Now);
+        Assert.Equal(GuardrailDecision.Allowed, (await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now, allowSelfApproval: true)).Decision);
+    }
+
+    [Fact]
+    public async Task An_approver_without_the_lane_permission_is_refused()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 103m, "assumed"), PriceChangeSource.Ai, 9, Now);          // pricing lane
+        await Assert.ThrowsAsync<InvalidOperationException>(() =>
+            w.Svc.ApproveAsync(p.PriceChangeId, 7, Now, canApproveLane: lane => ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermStore }, lane)));
+        Assert.Equal(100m, Price(w));
+        Assert.Equal(GuardrailDecision.Allowed,
+            (await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now, canApproveLane: lane => ApprovalLanes.CanApprove(new[] { ApprovalLanes.PermPricing }, lane))).Decision);
+    }
+
+    [Fact]
+    public async Task Approving_at_an_edited_price_applies_that_price_and_rechecks_the_rules()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+        var o = await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now, editedPrice: 105m);
+        Assert.Equal(105m, o.AppliedPrice);
+        Assert.Equal(105m, Price(w));
+        Assert.Contains("edited price", w.Db.PriceChanges.Single().Reason);
+
+        var p2 = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now.AddMinutes(5));
+        var bad = await w.Svc.ApproveAsync(p2.PriceChangeId, 7, Now.AddMinutes(6), editedPrice: 130m);       // beyond the step cap
+        Assert.Equal(ListPriceCodes.ExceedsMaxIncrease, bad.Code);
+        Assert.Equal(105m, Price(w));
+    }
+
+    [Fact]
+    public async Task Bulk_approval_covers_only_low_risk_changes()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var low = await w.Svc.ProposeAsync(Propose(w, 103m), PriceChangeSource.Ai, 9, Now);
+        var w2 = await CreateAsync();
+        await using var _2 = w2.Db;
+        var risky = await w2.Svc.ProposeAsync(Propose(w2, 103m, "assumed"), PriceChangeSource.Ai, 9, Now);
+
+        var ok = await w.Svc.ApproveBulkAsync(new[] { low.PriceChangeId, 9999 }, 7, Now);
+        Assert.Equal(GuardrailDecision.Allowed, ok[0].Decision);
+        Assert.Equal("NOT_FOUND", ok[1].Code);
+        Assert.Equal(103m, Price(w));
+
+        var no = await w2.Svc.ApproveBulkAsync(new[] { risky.PriceChangeId }, 7, Now);
+        Assert.Equal("NOT_LOW_RISK", no[0].Code);
+        Assert.Equal(100m, Price(w2));
+    }
+
+    [Fact]
+    public async Task Undo_restores_the_previous_price_through_the_same_rules_and_is_logged()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+        await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now);
+        Assert.Equal(108m, Price(w));
+
+        var o = await w.Svc.UndoAsync(p.PriceChangeId, 7, Now.AddMinutes(10));
+
+        Assert.Equal(GuardrailDecision.Allowed, o.Decision);
+        Assert.Equal(100m, Price(w));
+        Assert.Equal(2, w.Db.PriceChanges.Count());                                                      // the original change and the undo, both logged
+        Assert.Contains(w.Db.PriceChanges.ToList(), c => c.Reason != null && c.Reason.StartsWith("undo of change"));

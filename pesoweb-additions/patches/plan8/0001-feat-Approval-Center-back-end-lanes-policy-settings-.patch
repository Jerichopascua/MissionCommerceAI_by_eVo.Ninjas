+﻿using System;
+using Microsoft.EntityFrameworkCore.Migrations;
+
+#nullable disable
+
+namespace GoPosify.Migrations
+{
+    /// <inheritdoc />
+    public partial class GrantApprovalLanePermissions : Migration
+    {
+        // No schema change. Grants the Approval Center lane permissions to every tenant's SuperAdmin (owner) role.
+        // New tenants already receive every permission at registration. Idempotent.
+        // (EF's scaffolded UpdateData statements for seed rows were removed on purpose.)
+        private static readonly string[] Permissions = { "Pricing.Approve.Store", "Pricing.Approve.Pricing", "Pricing.Approve.Owner" };
+
+        /// <inheritdoc />
+        protected override void Up(MigrationBuilder migrationBuilder)
+        {
+            foreach (var p in Permissions)
+            {
+                migrationBuilder.Sql(
+                    $"UPDATE Roles SET Permissions = Permissions + ',{p}' " +
+                    $"WHERE Title = 'SuperAdmin' AND (',' + Permissions + ',') NOT LIKE '%,{p},%';");
+            }
+        }
+
+        /// <inheritdoc />
+        protected override void Down(MigrationBuilder migrationBuilder)
+        {
+            foreach (var p in Permissions)
+            {
+                migrationBuilder.Sql($"UPDATE Roles SET Permissions = REPLACE(Permissions, ',{p}', '') WHERE Title = 'SuperAdmin';");
+            }
+        }
+    }
+}

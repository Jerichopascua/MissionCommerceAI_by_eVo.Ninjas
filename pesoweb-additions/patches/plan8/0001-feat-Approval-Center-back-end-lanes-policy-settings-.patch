diff --git a/Services/ApprovalLanes.cs b/Services/ApprovalLanes.cs
new file mode 100644
index 0000000..e33f415
--- /dev/null
+++ b/Services/ApprovalLanes.cs
@@ -0,0 +1,47 @@
+using GoPosify.Models;
+
+namespace GoPosify.Services;
+
+// Who may decide a proposal. Routing is by risk, using the tenant's own thresholds (PricingPolicy), not by a fixed person.
+public static class ApprovalLanes
+{
+    public const string Store = "Store manager";
+    public const string Pricing = "Pricing manager";
+    public const string Owner = "Owner";
+
+    public const string PermStore = "Pricing.Approve.Store";
+    public const string PermPricing = "Pricing.Approve.Pricing";
+    public const string PermOwner = "Pricing.Approve.Owner";
+    public const string PermLegacy = "Pricing.Approve";
+
+    public const string Learned = "learned";
+    public const string Assumed = "assumed";
+
+    // changePct is the absolute size of the move in percent.
+    public static string Route(PricingPolicy p, decimal changePct, bool topSeller, bool belowSoftFloor, string confidence)
+    {
+        changePct = Math.Abs(changePct);
+        var lowRisk = changePct <= p.StoreLaneMaxPct && !topSeller && !belowSoftFloor && confidence == Learned;
+        if (lowRisk)
+        {
+            return Store;
+        }
+
+        return changePct > p.OwnerLaneMinPct && (topSeller || belowSoftFloor) ? Owner : Pricing;
+    }
+
+    // Auto-approval is only for proposals that would land in the store lane and are within the auto-approve limit.
+    public static bool EligibleForAutoApprove(PricingPolicy p, string lane, decimal changePct)
+        => p.ListPriceAutoApprove && p.AutonomyMode == AutonomyModes.Autonomous && lane == Store && Math.Abs(changePct) <= p.AutoApproveMaxPct;
+
+    // Owner implies Pricing implies Store. A user who holds only the older Pricing.Approve permission (no lane permission at
+    // all) keeps the old behavior and may decide any lane.
+    public static bool CanApprove(IEnumerable<string> userPermissions, string lane)
+    {
+        var perms = new HashSet<string>(userPermissions ?? Array.Empty<string>());
+        if (perms.Contains(PermOwner)) return true;
+        if (perms.Contains(PermPricing)) return lane != Owner;
+        if (perms.Contains(PermStore)) return lane == Store;
+        return perms.Contains(PermLegacy);
+    }
+}

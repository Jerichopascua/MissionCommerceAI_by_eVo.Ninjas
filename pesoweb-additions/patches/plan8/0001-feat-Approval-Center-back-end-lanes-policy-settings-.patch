+++ b/Services/ApprovalQueueService.cs
@@ -0,0 +1,165 @@
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public sealed class ApprovalCheck
+{
+    public bool Ok { get; set; }
+    public string Text { get; set; }
+}
+
+public sealed class ApprovalItem
+{
+    public long Id { get; set; }
+    public string Type { get; set; }                  // Price | Markdown
+    public int ProductId { get; set; }
+    public string Name { get; set; }
+    public string Scope { get; set; }                 // All branches | the branch name
+    public decimal Cost { get; set; }
+    public decimal From { get; set; }
+    public decimal To { get; set; }
+    public decimal Pct { get; set; }
+    public decimal MarginNowPct { get; set; }
+    public decimal MarginAfterPct { get; set; }
+    public string Lane { get; set; }
+    public string Confidence { get; set; }
+    public decimal? GainPerDay { get; set; }
+    public decimal? GainConservativePerDay { get; set; }
+    public string Evidence { get; set; }
+    public string Reason { get; set; }
+    public string Source { get; set; }
+    public int AgeMinutes { get; set; }
+    public DateTime? ExpiresAt { get; set; }
+    public string Deadline { get; set; }
+    public bool TopSeller { get; set; }
+    public bool BelowSoftFloor { get; set; }
+    public bool LowRisk { get; set; }
+    public bool CanApprove { get; set; }
+    public List<ApprovalCheck> Checks { get; set; } = new();
+}
+
+public sealed class ApprovalSummary
+{
+    public int Waiting { get; set; }
+    public int OldestMinutes { get; set; }
+    public decimal ProfitAtStakeConservativePerDay { get; set; }
+    public int ApprovedToday { get; set; }
+    public int AutoApprovedToday { get; set; }
+    public int ExpiredJustNow { get; set; }
+}
+
+public sealed class ApprovalQueue
+{
+    public ApprovalSummary Summary { get; set; } = new();
+    public List<ApprovalItem> Items { get; set; } = new();
+}
+
+public interface IApprovalQueueService
+{
+    Task<ApprovalQueue> BuildAsync(DateTime now, Func<string, bool> canApproveLane, string lane = null, string type = null);
+}
+
+// One inbox: every proposal waiting for a person, across list-price changes and markdowns, with its lane, evidence and rule checks.
+public sealed class ApprovalQueueService : IApprovalQueueService
+{
+    private readonly AppDBContext _db;
+    private readonly IListPriceService _listPrices;
+
+    public ApprovalQueueService(AppDBContext db, IListPriceService listPrices)
+    {
+        _db = db;
+        _listPrices = listPrices;
+    }
+
+    public async Task<ApprovalQueue> BuildAsync(DateTime now, Func<string, bool> canApproveLane, string lane = null, string type = null)
+    {
+        var policy = await _db.PricingPolicies.AsNoTracking().FirstOrDefaultAsync();
+        var queue = new ApprovalQueue();
+
+        // proposals nobody decided in time are closed, not approved late
+        var lapsed = await _db.PriceChanges.Where(c => c.Status == PriceChangeStatus.PendingApproval && c.ExpiresAt != null && c.ExpiresAt < now).ToListAsync();
+        foreach (var c in lapsed)
+        {
+            c.Status = PriceChangeStatus.Rejected;
+            c.GuardrailCode = "PROPOSAL_EXPIRED";
+            c.GuardrailMessage = "Nobody decided this in time, so it was closed.";
+            c.DecidedAt = now;
+            c.DecisionKind = "Manual";
+        }
+
+        if (lapsed.Count > 0)
+        {
+            await _db.SaveChangesAsync();
+        }
+
+        queue.Summary.ExpiredJustNow = lapsed.Count;
+        var startOfDay = now.Date;
+        queue.Summary.ApprovedToday = await _db.PriceChanges.CountAsync(c => c.Status == PriceChangeStatus.Applied && c.DecidedAt >= startOfDay && c.DecisionKind == "Manual");
+        queue.Summary.AutoApprovedToday = await _db.PriceChanges.CountAsync(c => c.Status == PriceChangeStatus.Applied && c.DecidedAt >= startOfDay && c.DecisionKind == "Auto");
+
+        var pending = await _db.PriceChanges.AsNoTracking().Where(c => c.Status == PriceChangeStatus.PendingApproval).OrderBy(c => c.CreatedAt).Take(500).ToListAsync();
+        var productIds = pending.Select(c => c.ProductId).Distinct().ToList();
+        var products = await _db.Products.AsNoTracking().Where(p => productIds.Contains(p.Id)).ToDictionaryAsync(p => p.Id);
+        var warehouseIds = pending.Where(c => c.BatchId != null).Select(c => c.WarehouseId).Distinct().ToList();
+        var warehouses = await _db.Warehouses.AsNoTracking().Where(w => warehouseIds.Contains(w.Id)).ToDictionaryAsync(w => w.Id, w => w.WarehouseName);
+        var batchIds = pending.Where(c => c.BatchId != null).Select(c => c.BatchId.Value).Distinct().ToList();
+        var batches = await _db.ProductBatches.AsNoTracking().Where(b => batchIds.Contains(b.Id)).ToDictionaryAsync(b => b.Id);
+        var top = await _listPrices.TopSellerIdsAsync(now);
+
+        foreach (var c in pending)
+        {
+            if (!products.TryGetValue(c.ProductId, out var product) || policy == null)
+            {
+                continue;
+            }
+
+            var isMarkdown = c.BatchId != null;
+            var cost = isMarkdown && batches.TryGetValue(c.BatchId.Value, out var b) && (b.Cost ?? 0m) > 0m ? b.Cost.Value : product.Cost;
+            var pct = c.PriceBefore > 0 ? (c.PriceAfter - c.PriceBefore) / c.PriceBefore * 100m : 0m;
+            var net = MarkdownGuardrails.NetPrice(c.PriceAfter, product.Discount);
+            var belowSoft = cost > 0 && net < cost * (1m + policy.SoftMarginFloorPct / 100m);
+            var itemLane = isMarkdown ? ApprovalLanes.Store : (c.Lane ?? ApprovalLanes.Pricing);
+            var learned = string.Equals(c.Confidence, ApprovalLanes.Learned, StringComparison.OrdinalIgnoreCase);
+            var item = new ApprovalItem
+            {
+                Id = c.Id, Type = isMarkdown ? "Markdown" : "Price", ProductId = c.ProductId, Name = product.ProductName,
+                Scope = isMarkdown ? (warehouses.TryGetValue(c.WarehouseId, out var wn) ? wn : "One branch") : "All branches",
+                Cost = cost, From = c.PriceBefore, To = c.PriceAfter, Pct = Math.Round(pct, 1),
+                MarginNowPct = cost > 0 ? Math.Round((c.PriceBefore - cost) / cost * 100m, 1) : 0m,
+                MarginAfterPct = cost > 0 ? Math.Round((c.PriceAfter - cost) / cost * 100m, 1) : 0m,
+                Lane = itemLane, Confidence = c.Confidence ?? (isMarkdown ? ApprovalLanes.Learned : ApprovalLanes.Assumed),
+                GainPerDay = c.ExpectedGainPerDay, GainConservativePerDay = c.ExpectedGainConservativePerDay, Evidence = c.Evidence,
+                Reason = c.Reason, Source = c.Source, AgeMinutes = (int)Math.Max(0, (now - c.CreatedAt).TotalMinutes), ExpiresAt = c.ExpiresAt,
+                TopSeller = top.Contains(c.ProductId), BelowSoftFloor = belowSoft,
+                LowRisk = !isMarkdown && itemLane == ApprovalLanes.Store && Math.Abs(pct) <= policy.StoreLaneMaxPct,
+                CanApprove = canApproveLane == null || canApproveLane(itemLane)
+            };
+            if (isMarkdown && batches.TryGetValue(c.BatchId.Value, out var lot) && lot.ExpiryDate.HasValue)
+            {
+                item.Deadline = $"the lot expires {lot.ExpiryDate.Value:yyyy-MM-dd}";
+            }
+
+            var floor = cost * (1m + policy.HardMarginFloorPct / 100m);
+            item.Checks.Add(new ApprovalCheck { Ok = net >= floor, Text = $"Price {c.PriceAfter:0.##} is at or above the margin price {floor:0.##} (cost {cost:0.##} + {policy.HardMarginFloorPct:0.#}%)" });
+            item.Checks.Add(new ApprovalCheck { Ok = isMarkdown ? -pct <= policy.MaxDiscountPct : (pct <= policy.MaxListPriceIncreasePct && -pct <= policy.MaxDiscountPct),
+                Text = $"Size of the move {pct:0.#}% is within the limit" });
+            item.Checks.Add(new ApprovalCheck { Ok = !belowSoft, Text = belowSoft ? "Below the soft margin floor: needs a person" : "Above the soft margin floor" });
+            item.Checks.Add(new ApprovalCheck { Ok = learned || isMarkdown, Text = learned || isMarkdown ? "Based on a sensitivity learned from sales" : "Based on an assumed sensitivity: treat as a hypothesis" });
+            if (item.TopSeller)
+            {
+                item.Checks.Add(new ApprovalCheck { Ok = false, Text = "Top seller by revenue (last 30 days): a mistake costs more here" });
+            }
+
+            if (!string.IsNullOrEmpty(lane) && item.Lane != lane) continue;
+            if (!string.IsNullOrEmpty(type) && !string.Equals(item.Type, type, StringComparison.OrdinalIgnoreCase)) continue;
+            queue.Items.Add(item);
+        }
+
+        queue.Summary.Waiting = queue.Items.Count;
+        queue.Summary.OldestMinutes = queue.Items.Count == 0 ? 0 : queue.Items.Max(i => i.AgeMinutes);
+        queue.Summary.ProfitAtStakeConservativePerDay = Math.Round(queue.Items.Sum(i => i.GainConservativePerDay ?? 0m), 2);
+        return queue;
+    }
+}

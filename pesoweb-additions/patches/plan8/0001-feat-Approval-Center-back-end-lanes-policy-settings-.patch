+        // GET: api/pricing/approvals?lane=Owner&type=Price
+        // The Approval Center inbox: everything waiting for a person, with lane, evidence, rule checks and counters.
+        [HttpGet]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> Approvals(string lane, string type)
+            => Ok(await _queue.BuildAsync(CurrentDateTime(), CanApproveLane, lane, type));
+
+        // POST: api/pricing/approvebulk   { priceChangeIds: [...] }  (low-risk list-price changes only)
+        [HttpPost]
+        [Authorize(Policy = "Pricing.Approve")]
+        public async Task<IActionResult> ApproveBulk([FromBody] BulkApproveDTO dto)
+        {
+            try
+            {
+                if (!CanApproveLane(ApprovalLanes.Store))
+                {
+                    return Forbid();
+                }
+
+                var results = await _listPrices.ApproveBulkAsync(dto.PriceChangeIds, CurrentUserId(), CurrentDateTime(), await AllowSelfApprovalAsync());
+                return Ok(new { approved = results.Count(r => r.Decision == GuardrailDecision.Allowed), results });
+            }
+            catch (Exception ex)
+            {
+                return HandleServerError(ex, "An error occurred while approving in bulk.", "Pricing", "ApproveBulk");
+            }
+        }
+
+        // POST: api/pricing/undolistprice   { priceChangeId }
+        [HttpPost]
+        [Authorize(Policy = "Pricing.Approve")]
+        public async Task<IActionResult> UndoListPrice([FromBody] PriceChangeDecisionDTO dto)
+        {
+            try
+            {
+                var outcome = await _listPrices.UndoAsync(dto.PriceChangeId, CurrentUserId(), CurrentDateTime());
+                return outcome.Decision == GuardrailDecision.Allowed ? Ok(outcome) : StatusCode(StatusCodes.Status422UnprocessableEntity, outcome);
+            }
+            catch (InvalidOperationException ex)
+            {
+                return BadRequest(new { message = ex.Message });
+            }
+            catch (Exception ex)
+            {
+                return HandleServerError(ex, "An error occurred while undoing the list price change.", "Pricing", "UndoListPrice");
+            }
+        }
+

+import { Component, HostListener, Inject, OnInit } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { AppService } from '../../services/app.service';
+
+// One inbox for every pricing change that needs a person: list-price changes and markdowns that are waiting.
+// The AI proposes, PesoWeb checks the rules, a person decides here, and every decision is logged on the server.
+@Component({
+  selector: 'app-approvalcenter',
+  templateUrl: './approvalcenter.component.html'
+})
+export class ApprovalCenterComponent implements OnInit {
+  public loading = false;
+  public busy = false;
+  public error = '';
+  public message = '';
+
+  public summary: any = { waiting: 0, oldestMinutes: 0, profitAtStakeConservativePerDay: 0, approvedToday: 0, autoApprovedToday: 0, expiredJustNow: 0 };
+  public items: any[] = [];
+  public tab = 'All';
+  public lane = '';
+  public selectedId = 0;
+  public editPrice: number | null = null;
+  public rejectReason = '';
+  public lanes = ['Store manager', 'Pricing manager', 'Owner'];
+  public recent: any[] = [];                 // approved in this session: each can be undone
+
+  public policy: any = null;
+  public showSettings = false;
+  public settingsSaved = false;
+
+  constructor(
+    private http: HttpClient,
+    @Inject('BASE_URL') private baseUrl: string,
+    public app: AppService
+  ) { }
+
+  ngOnInit(): void {
+    this.load();
+    this.loadPolicy();
+  }
+
+  // ---- data -----------------------------------------------------------------------------------------------------------
+  public load(): void {
+    this.loading = true;
+    this.error = '';
+    this.http.get<any>(this.baseUrl + 'api/pricing/approvals').subscribe({
+      next: (q) => {
+        this.summary = q.summary;
+        this.items = q.items || [];
+        if (!this.items.some(i => i.id === this.selectedId)) {
+          this.selectedId = this.visible.length ? this.visible[0].id : 0;
+        }
+        this.editPrice = null;
+        this.loading = false;
+      },
+      error: (e) => { this.error = this.messageOf(e, 'Could not load the approval queue.'); this.loading = false; }
+    });
+  }
+
+  private loadPolicy(): void {
+    this.http.get<any>(this.baseUrl + 'api/pricing/policy').subscribe({ next: (p) => (this.policy = p), error: () => { } });
+  }
+
+  // ---- what is shown --------------------------------------------------------------------------------------------------
+  public get visible(): any[] {
+    return this.items.filter(i => (this.tab === 'All' || i.type === this.tab) && (!this.lane || i.lane === this.lane));
+  }
+
+  public byLane(lane: string): any[] {
+    return this.visible.filter(i => i.lane === lane);
+  }
+
+  public count(type: string): number {
+    return this.items.filter(i => type === 'All' || i.type === type).length;
+  }
+
+  public get selected(): any {
+    return this.items.find(i => i.id === this.selectedId) || null;
+  }
+
+  public get lowRisk(): any[] {
+    return this.items.filter(i => i.lowRisk && i.canApprove);
+  }
+
+  public select(item: any): void {
+    this.selectedId = item.id;
+    this.editPrice = null;
+    this.rejectReason = '';
+    this.message = '';
+  }
+
+  public pctText(item: any): string {
+    return (item.pct > 0 ? '+' : '') + Number(item.pct).toFixed(0) + '%';
+  }
+
+  public money(n: number): string {
+    return '₱' + Number(n || 0).toLocaleString(undefined, { maximumFractionDigits: 1 });
+  }
+
+  // The slider range for approving at a different price: the margin price up to the largest allowed step.
+  public sliderMin(item: any): number {
+    const hard = this.policy ? Number(this.policy.hardMarginFloorPct || this.policy.HardMarginFloorPct || 0) : 5;
+    return Math.ceil(item.cost * (1 + hard / 100));
+  }
+
+  public sliderMax(item: any): number {
+    const inc = this.policy ? Number(this.policy.maxListPriceIncreasePct || this.policy.MaxListPriceIncreasePct || 15) : 15;
+    return Math.max(this.sliderMin(item), Math.round(item.from * (1 + inc / 100)));
+  }
+
+  public editedPct(item: any): number {
+    const p = this.editPrice == null ? item.to : this.editPrice;
+    return (p - item.from) / item.from * 100;
+  }
+
+  // ---- actions --------------------------------------------------------------------------------------------------------
+  public approve(item: any): void {
+    if (!item || this.busy || !item.canApprove) { return; }
+    const isMarkdown = item.type === 'Markdown';
+    const url = this.baseUrl + (isMarkdown ? 'api/pricing/approve' : 'api/pricing/approvelistprice');
+    const body: any = { priceChangeId: item.id };
+    if (!isMarkdown && this.editPrice != null && this.editPrice !== item.to) { body.newPrice = this.editPrice; }
+    this.busy = true;
+    this.http.post<any>(url, body).subscribe({
+      next: (r) => {
+        this.busy = false;
+        this.message = item.name + ' approved' + (r && r.appliedPrice ? ' at ' + r.appliedPrice : '') + '.';
+        if (!isMarkdown) { this.recent.unshift({ id: item.id, name: item.name }); }
+        this.load();
+      },
+      error: (e) => { this.busy = false; this.error = this.messageOf(e, 'Could not approve.'); this.load(); }
+    });
+  }
+
+  public reject(item: any, reason?: string): void {
+    if (!item || this.busy || !item.canApprove) { return; }
+    const isMarkdown = item.type === 'Markdown';
+    const url = this.baseUrl + (isMarkdown ? 'api/pricing/reject' : 'api/pricing/rejectlistprice');
+    this.busy = true;
+    this.http.post<any>(url, { priceChangeId: item.id, reason: reason || this.rejectReason || 'Rejected by approver' }).subscribe({
+      next: () => { this.busy = false; this.message = item.name + ' rejected.'; this.rejectReason = ''; this.load(); },
+      error: (e) => { this.busy = false; this.error = this.messageOf(e, 'Could not reject.'); this.load(); }
+    });
+  }
+
+  public approveAllLowRisk(): void {
+    const ids = this.lowRisk.map(i => i.id);
+    if (!ids.length || this.busy) { return; }
+    this.busy = true;
+    this.http.post<any>(this.baseUrl + 'api/pricing/approvebulk', { priceChangeIds: ids }).subscribe({
+      next: (r) => {
+        this.busy = false;
+        this.message = r.approved + ' low-risk change(s) approved.';
+        (r.results || []).filter((x: any) => x.decision === 0).forEach((x: any) => {
+          const it = this.items.find(i => i.id === x.priceChangeId);
+          if (it) { this.recent.unshift({ id: it.id, name: it.name }); }
+        });
+        this.load();
+      },
+      error: (e) => { this.busy = false; this.error = this.messageOf(e, 'Could not approve in bulk.'); }
+    });
+  }
+
+  public undo(entry: any): void {
+    if (this.busy) { return; }
+    this.busy = true;
+    this.http.post<any>(this.baseUrl + 'api/pricing/undolistprice', { priceChangeId: entry.id }).subscribe({
+      next: () => { this.busy = false; this.message = entry.name + ' restored to its previous price.'; this.recent = this.recent.filter(r => r.id !== entry.id); this.load(); },
+      error: (e) => { this.busy = false; this.error = this.messageOf(e, 'Could not undo.'); }
+    });
+  }
+
+  // ---- settings (owner) -----------------------------------------------------------------------------------------------
+  public saveSettings(): void {
+    if (!this.policy) { return; }
+    const p = this.policy;
+    const body = {
+      autonomyMode: p.autonomyMode || p.AutonomyMode, hardMarginFloorPct: p.hardMarginFloorPct ?? p.HardMarginFloorPct,
+      softMarginFloorPct: p.softMarginFloorPct ?? p.SoftMarginFloorPct, maxDiscountPct: p.maxDiscountPct ?? p.MaxDiscountPct,
+      maxChangesPerSkuPerHour: p.maxChangesPerSkuPerHour ?? p.MaxChangesPerSkuPerHour,
+      listPriceAutoApprove: p.listPriceAutoApprove ?? p.ListPriceAutoApprove, autoApproveMaxPct: p.autoApproveMaxPct ?? p.AutoApproveMaxPct,
+      maxListPriceIncreasePct: p.maxListPriceIncreasePct ?? p.MaxListPriceIncreasePct, storeLaneMaxPct: p.storeLaneMaxPct ?? p.StoreLaneMaxPct,
+      ownerLaneMinPct: p.ownerLaneMinPct ?? p.OwnerLaneMinPct, proposalExpiryHours: p.proposalExpiryHours ?? p.ProposalExpiryHours
+    };
+    this.http.put<any>(this.baseUrl + 'api/pricing/policy', body).subscribe({
+      next: () => { this.settingsSaved = true; this.error = ''; this.loadPolicy(); this.load(); },
+      error: (e) => { this.error = this.messageOf(e, 'Could not save the settings.'); }
+    });
+  }
+
+  // ---- keyboard: j / k move, a approve, r reject ----------------------------------------------------------------------
+  @HostListener('document:keydown', ['$event'])
+  public onKey(e: KeyboardEvent): void {
+    const t = e.target as HTMLElement;
+    if (t && /INPUT|SELECT|TEXTAREA/.test(t.tagName)) { return; }
+    const list = this.visible;
+    const idx = list.findIndex(i => i.id === this.selectedId);
+    if (e.key === 'j' && list.length) { this.select(list[Math.min(list.length - 1, idx + 1)]); }
+    if (e.key === 'k' && list.length) { this.select(list[Math.max(0, idx - 1)]); }
+    if (e.key === 'a' && this.selected) { this.approve(this.selected); }
+    if (e.key === 'r' && this.selected) { this.reject(this.selected, 'Rejected from the keyboard'); }
+  }
+
+  private messageOf(e: any, fallback: string): string {
+    return (e && e.error && (e.error.message || e.error.title)) || fallback;
+  }
+}

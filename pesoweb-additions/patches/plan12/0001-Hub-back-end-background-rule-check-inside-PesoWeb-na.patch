+    [Fact]
+    public async Task Alerts_are_not_posted_when_they_are_switched_off_or_no_address_is_set()
+    {
+        var (db, svc, handler) = Create();
+        await using var _ = db;
+        await svc.SendAlertAsync(new HubAlert { RuleKey = "x", Role = "Owner", Severity = "Act", Message = "m", OpenedAt = Now }, Now);          // no settings at all
+        await svc.SaveAsync("http://127.0.0.1:9/hook", false, false, 1, Now);
+        await svc.SendAlertAsync(new HubAlert { RuleKey = "x", Role = "Owner", Severity = "Act", Message = "m", OpenedAt = Now }, Now);          // alerts off
+        Assert.Empty(handler.Bodies);

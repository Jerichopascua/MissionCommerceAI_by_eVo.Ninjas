diff --git a/Services/HubBackgroundService.cs b/Services/HubBackgroundService.cs
new file mode 100644
index 0000000..33dd5bf
--- /dev/null
+++ b/Services/HubBackgroundService.cs
@@ -0,0 +1,96 @@
+using GoPosify.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+// PesoWeb's own check of the hub rules, so alerts open (and the webhook hears about them and about price changes) without anyone opening the hub
+// and without an agent running. It looks at the companies that have used the hub: ones with saved rules, alerts, branch AI settings or a channel.
+// Hub:BackgroundMinutes sets how often (default 5); 0 switches it off.
+public sealed class HubBackgroundService : BackgroundService
+{
+    private readonly IServiceScopeFactory _scopes;
+    private readonly ILogger<HubBackgroundService> _log;
+    private readonly IConfiguration _config;
+
+    public HubBackgroundService(IServiceScopeFactory scopes, ILogger<HubBackgroundService> log, IConfiguration config)
+    {
+        _scopes = scopes;
+        _log = log;
+        _config = config;
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stop)
+    {
+        var minutes = _config.GetValue<int?>("Hub:BackgroundMinutes") ?? 5;
+        if (minutes <= 0)
+        {
+            _log.LogInformation("The hub background check is switched off (Hub:BackgroundMinutes is 0).");
+            return;
+        }
+
+        try { await Task.Delay(TimeSpan.FromSeconds(45), stop); } catch (OperationCanceledException) { return; }
+        while (!stop.IsCancellationRequested)
+        {
+            try
+            {
+                var n = await RunOnceAsync(stop);
+                _log.LogInformation("Hub background check: {Count} companies checked.", n);
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                _log.LogError(e, "The hub background check failed.");
+            }
+
+            try { await Task.Delay(TimeSpan.FromMinutes(minutes), stop); } catch (OperationCanceledException) { break; }
+        }
+    }
+
+    // Companies that have used the hub. Ignores the tenant filter on purpose: this is the one place that looks across companies, and it only reads ids.
+    public static async Task<List<int>> EngagedTenantsAsync(AppDBContext db)
+    {
+        var ids = new HashSet<int>();
+        foreach (var x in await db.HubRules.IgnoreQueryFilters().AsNoTracking().Select(r => r.TenantID).Distinct().ToListAsync()) ids.Add(x);
+        foreach (var x in await db.HubAlerts.IgnoreQueryFilters().AsNoTracking().Select(r => r.TenantID).Distinct().ToListAsync()) ids.Add(x);
+        foreach (var x in await db.AiBranchSettings.IgnoreQueryFilters().AsNoTracking().Select(r => r.TenantID).Distinct().ToListAsync()) ids.Add(x);
+        foreach (var x in await db.HubChannelSettings.IgnoreQueryFilters().AsNoTracking().Where(c => c.WebhookUrl != null).Select(r => r.TenantID).Distinct().ToListAsync()) ids.Add(x);
+        return ids.OrderBy(i => i).ToList();
+    }
+
+    public static DateTime TenantNow(AppDBContext db)
+    {
+        try
+        {
+            var tz = db.AppSettings.AsNoTracking().Select(a => a.DefaultTimezone).FirstOrDefault();
+            if (!string.IsNullOrWhiteSpace(tz)) return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(tz));
+        }
+        catch { /* an unknown time zone name falls back to UTC */ }
+        return DateTime.UtcNow;
+    }
+
+    public async Task<int> RunOnceAsync(CancellationToken stop)
+    {
+        List<int> tenants;
+        using (var scope = _scopes.CreateScope())
+            tenants = await EngagedTenantsAsync(scope.ServiceProvider.GetRequiredService<AppDBContext>());
+
+        foreach (var tenant in tenants)
+        {
+            stop.ThrowIfCancellationRequested();
+            try
+            {
+                using var scope = _scopes.CreateScope();
+                var db = scope.ServiceProvider.GetRequiredService<AppDBContext>();
+                db.CurrentTenantId = tenant;
+                var now = TenantNow(db);
+                await scope.ServiceProvider.GetRequiredService<IHubRuleService>().EvaluateAsync(now);
+                await scope.ServiceProvider.GetRequiredService<IHubChannelService>().DeliverPriceChangesAsync(now);
+            }
+            catch (Exception e) when (e is not OperationCanceledException)
+            {
+                _log.LogError(e, "The hub check failed for company {Tenant}.", tenant);
+            }
+        }
+
+        return tenants.Count;
+    }
+}
diff --git a/Services/HubChannelService.cs b/Services/HubChannelService.cs
new file mode 100644
index 0000000..7826915
--- /dev/null
+++ b/Services/HubChannelService.cs
@@ -0,0 +1,174 @@
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.Json;
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+// A company-supplied URL is called from the server, so it is checked hard: https only, no address that points inside a network, no credentials in the URL.
+// A development setting (Hub:AllowLocalWebhooks) allows plain http to this machine for testing; it is off by default.
+public static class WebhookGuard
+{
+    public static bool IsPrivate(IPAddress ip)
+    {
+        if (IPAddress.IsLoopback(ip)) return true;
+        if (ip.IsIPv4MappedToIPv6) ip = ip.MapToIPv4();
+        if (ip.AddressFamily == AddressFamily.InterNetworkV6)
+            return ip.IsIPv6LinkLocal || ip.IsIPv6SiteLocal || ip.Equals(IPAddress.IPv6Any) || (ip.GetAddressBytes()[0] & 0xFE) == 0xFC;   // fc00::/7 unique local
+        var b = ip.GetAddressBytes();
+        return b[0] == 10 || b[0] == 0 || (b[0] == 172 && b[1] >= 16 && b[1] <= 31) || (b[0] == 192 && b[1] == 168) || (b[0] == 169 && b[1] == 254)
+               || (b[0] == 100 && b[1] >= 64 && b[1] <= 127) || b[0] >= 224;
+    }
+
+    // Returns an error message, or null when the URL may be used. This part needs no network.
+    public static string Validate(string url, bool allowLocal)
+    {
+        if (string.IsNullOrWhiteSpace(url)) return null;                                   // empty means "no webhook"
+        if (url.Length > 500) return "The address is too long.";
+        if (!Uri.TryCreate(url.Trim(), UriKind.Absolute, out var uri)) return "That is not a web address.";
+        if (!string.IsNullOrEmpty(uri.UserInfo)) return "The address must not contain a user name or password.";
+        var local = uri.IsLoopback || uri.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase);
+        if (uri.Scheme != Uri.UriSchemeHttps && !(allowLocal && uri.Scheme == Uri.UriSchemeHttp && local)) return "The address must start with https://.";
+        if (local && !allowLocal) return "The address must be a public web address, not this machine.";
+        if (IPAddress.TryParse(uri.Host, out var ip) && IsPrivate(ip) && !(allowLocal && IPAddress.IsLoopback(ip))) return "The address must be a public web address, not a private network address.";
+        return null;
+    }
+
+    // At send time the name is resolved and every address it points to must be public (this stops a public name that points inside).
+    public static async Task<string> ValidateResolvedAsync(string url, bool allowLocal)
+    {
+        var first = Validate(url, allowLocal);
+        if (first != null || string.IsNullOrWhiteSpace(url)) return first;
+        var uri = new Uri(url.Trim());
+        if (allowLocal && uri.IsLoopback) return null;
+        try
+        {
+            foreach (var a in await Dns.GetHostAddressesAsync(uri.Host))
+                if (IsPrivate(a)) return "The address points to a private network.";
+        }
+        catch { return "The address could not be resolved."; }
+        return null;
+    }
+}
+
+public interface IHubChannelService
+{
+    Task<object> GetAsync();
+    Task<(bool Ok, string Message)> SaveAsync(string url, bool sendAlerts, bool sendPriceChanges, int userId, DateTime now);
+    Task<(bool Ok, string Message)> TestAsync(DateTime now);
+    Task SendAlertAsync(HubAlert alert, DateTime now);
+    // Delivers price-change events not yet sent (an outbox cursor), once each. Returns how many were delivered.
+    Task<int> DeliverPriceChangesAsync(DateTime now);
+}
+
+public sealed class HubChannelService : IHubChannelService
+{
+    private readonly AppDBContext _db;
+    private readonly IHttpClientFactory _http;
+    private readonly bool _allowLocal;
+
+    public HubChannelService(AppDBContext db, IHttpClientFactory http, Microsoft.Extensions.Configuration.IConfiguration config)
+    {
+        _db = db;
+        _http = http;
+        _allowLocal = string.Equals(config["Hub:AllowLocalWebhooks"], "true", StringComparison.OrdinalIgnoreCase);
+    }
+
+    public async Task<object> GetAsync()
+    {
+        var s = await _db.HubChannelSettings.AsNoTracking().FirstOrDefaultAsync();
+        return new
+        {
+            webhookUrl = s?.WebhookUrl ?? "", sendAlerts = s?.SendAlerts ?? true, sendPriceChanges = s?.SendPriceChanges ?? false,
+            lastSentAt = s?.LastSentAt, lastStatus = s?.LastStatus, configured = !string.IsNullOrWhiteSpace(s?.WebhookUrl)
+        };
+    }
+
+    public async Task<(bool Ok, string Message)> SaveAsync(string url, bool sendAlerts, bool sendPriceChanges, int userId, DateTime now)
+    {
+        url = string.IsNullOrWhiteSpace(url) ? null : url.Trim();
+        var error = WebhookGuard.Validate(url, _allowLocal);
+        if (error != null) return (false, error);
+        var s = await _db.HubChannelSettings.FirstOrDefaultAsync();
+        if (s == null)
+        {
+            s = new HubChannelSetting();
+            _db.HubChannelSettings.Add(s);
+        }
+        var turningOnPrices = sendPriceChanges && (!s.SendPriceChanges || s.WebhookUrl != url);
+        s.WebhookUrl = url;
+        s.SendAlerts = sendAlerts;
+        s.SendPriceChanges = sendPriceChanges;
+        s.UpdatedByUserId = userId;
+        s.UpdatedAt = now;
+        // Switching price changes on starts from now: older changes are not sent.
+        if (turningOnPrices) s.LastEventId = await _db.BusinessEvents.AsNoTracking().Select(e => (long?)e.Id).MaxAsync() ?? 0;
+        await _db.SaveChangesAsync();
+        return (true, null);
+    }
+
+    private async Task<(bool Ok, string Status)> PostAsync(string url, object body)
+    {
+        var guard = await WebhookGuard.ValidateResolvedAsync(url, _allowLocal);
+        if (guard != null) return (false, guard);
+        try
+        {
+            var client = _http.CreateClient("hub-channel");
+            client.Timeout = TimeSpan.FromSeconds(10);
+            using var content = new StringContent(JsonSerializer.Serialize(body), Encoding.UTF8, "application/json");
+            using var resp = await client.PostAsync(url, content);
+            return (resp.IsSuccessStatusCode, ((int)resp.StatusCode).ToString());
+        }
+        catch (Exception e)
+        {
+            return (false, e.GetType().Name);
+        }
+    }
+
+    private async Task RecordAsync(HubChannelSetting s, bool ok, string status, DateTime now)
+    {
+        s.LastSentAt = now;
+        s.LastStatus = (ok ? "sent " : "failed ") + status;
+        await _db.SaveChangesAsync();
+    }
+
+    public async Task<(bool Ok, string Message)> TestAsync(DateTime now)
+    {
+        var s = await _db.HubChannelSettings.FirstOrDefaultAsync();
+        if (s == null || string.IsNullOrWhiteSpace(s.WebhookUrl)) return (false, "No webhook address is set.");
+        var (ok, status) = await PostAsync(s.WebhookUrl, new { type = "Test", text = "PesoWeb test message: the channel works.", sentAt = now });
+        await RecordAsync(s, ok, status, now);
+        return ok ? (true, null) : (false, "The test message was not accepted (" + status + ").");
+    }
+
+    public async Task SendAlertAsync(HubAlert alert, DateTime now)
+    {
+        var s = await _db.HubChannelSettings.FirstOrDefaultAsync();
+        if (s == null || !s.SendAlerts || string.IsNullOrWhiteSpace(s.WebhookUrl)) return;
+        var (ok, status) = await PostAsync(s.WebhookUrl, new { type = "AlertOpened", text = alert.Message, ruleKey = alert.RuleKey, role = alert.Role, severity = alert.Severity, warehouseId = alert.WarehouseId, openedAt = alert.OpenedAt });
+        await RecordAsync(s, ok, status, now);
+    }
+
+    public async Task<int> DeliverPriceChangesAsync(DateTime now)
+    {
+        var s = await _db.HubChannelSettings.FirstOrDefaultAsync();
+        if (s == null || !s.SendPriceChanges || string.IsNullOrWhiteSpace(s.WebhookUrl)) return 0;
+        var events = await _db.BusinessEvents.AsNoTracking()
+            .Where(e => e.EventType == BusinessEventTypes.PriceChanged && e.Id > s.LastEventId).OrderBy(e => e.Id).Take(50).ToListAsync();
+        var delivered = 0;
+        foreach (var e in events)
+        {
+            object data;
+            try { data = JsonSerializer.Deserialize<JsonElement>(e.PayloadJson ?? "{}"); } catch { data = new { }; }
+            var (ok, status) = await PostAsync(s.WebhookUrl, new { type = "PriceChanged", text = "Price changed" + (string.IsNullOrEmpty(e.ReferenceNo) ? "" : ": " + e.ReferenceNo), warehouseId = e.WarehouseId, occurredAt = e.OccurredAt, data });
+            if (!ok) { await RecordAsync(s, false, status, now); break; }      // keep the cursor: it is retried next time

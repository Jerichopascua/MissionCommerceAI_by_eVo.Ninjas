+        // POST: api/ai/replenish/draft-order  { "ids": [1,2,3] }   (Pending purchase orders from open suggestions: stock is not touched)
+        [HttpPost("~/api/ai/replenish/draft-order")]
+        [Authorize(Policy = "Purchases.PurchaseAdd")]
+        public async Task<IActionResult> ReplenishDraftOrder([FromBody] DraftOrderDTO dto)
+        {
+            if (!CanActAs(ApprovalLanes.Store)) return Forbid();
+            var (ok, message, orders) = await _replenish.CreateDraftOrdersAsync(dto.Ids ?? new List<int>(), User.FindFirstValue(ClaimTypes.NameIdentifier), CurrentUserId(), CurrentDateTime());
+            return ok ? Ok(new { orders }) : BadRequest(new { message });
+        }
+
+        // POST: api/ai/missions   (AI Customer Mission posts what shoppers were trying to get done, per branch)
+        [HttpPost("~/api/ai/missions")]
+        [Authorize(Policy = "AI.Read")]
+        public async Task<IActionResult> MissionsPost([FromBody] MissionPostDTO dto)
+        {
+            if (!await _control.IsEnabledAsync(AiFeatureKeys.CustomerMission))
+                return StatusCode(StatusCodes.Status422UnprocessableEntity, new { code = "AI_FEATURE_OFF", message = "AI Customer Mission is switched off for this company." });
+            return Ok(new { added = await _missions.ReplaceAsync(dto.WarehouseIds ?? new List<int>(), dto.Items ?? new List<MissionInput>(), CurrentDateTime()) });
+        }
+

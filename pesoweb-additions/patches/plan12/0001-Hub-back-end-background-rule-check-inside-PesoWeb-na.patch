+        Assert.True((await svc.SaveAsync("", true, false, 1, Now)).Ok);                       // clearing it is allowed
+    }
+
+    [Fact]
+    public async Task A_new_alert_is_posted_to_the_webhook_with_readable_text()
+    {
+        var (db, svc, handler) = Create();
+        await using var _ = db;
+        await svc.SaveAsync("http://127.0.0.1:9/hook", true, false, 1, Now);
+        await svc.SendAlertAsync(new HubAlert { RuleKey = "Shrinkage", Role = "Owner", Severity = "Act", Message = "Shrinkage above the limit: Main is at 3.0%", OpenedAt = Now }, Now);
+        var body = Assert.Single(handler.Bodies);
+        Assert.Contains("Shrinkage above the limit", body);

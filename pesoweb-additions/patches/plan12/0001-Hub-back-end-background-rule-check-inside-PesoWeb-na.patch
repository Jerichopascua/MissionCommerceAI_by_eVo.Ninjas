+        await db.SaveChangesAsync();
+        await svc.SaveAsync("http://127.0.0.1:9/hook", true, true, 1, Now);                   // switched on now: the old one is not sent
+        db.BusinessEvents.Add(new BusinessEvent { EventType = BusinessEventTypes.PriceChanged, ReferenceNo = "new1", PayloadJson = "{\"price\":12}", OccurredAt = Now });
+        db.BusinessEvents.Add(new BusinessEvent { EventType = BusinessEventTypes.SaleCompleted, ReferenceNo = "sale", PayloadJson = "{}", OccurredAt = Now });
+        await db.SaveChangesAsync();
+        Assert.Equal(1, await svc.DeliverPriceChangesAsync(Now));

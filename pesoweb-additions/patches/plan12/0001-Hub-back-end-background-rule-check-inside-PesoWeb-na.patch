+        [HttpGet("~/api/ai/missions")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> MissionsList() => Ok(await _missions.ListAsync());
+
+        // POST: api/ai/competitor-prices   (an agent or importer posts what rivals charge; the latest per competitor wins)
+        [HttpPost("~/api/ai/competitor-prices")]
+        [Authorize(Policy = "AI.Read")]
+        public async Task<IActionResult> CompetitorPost([FromBody] CompetitorPostDTO dto) =>
+            Ok(new { saved = await _competitors.UpsertAsync(dto.Items ?? new List<CompetitorInput>(), "feed", CurrentDateTime()) });
+
+        // PUT: api/ai/competitor-prices   (a person enters or imports prices)
+        [HttpPut("~/api/ai/competitor-prices")]
+        [Authorize(Policy = "Pricing.Manage")]
+        public async Task<IActionResult> CompetitorPut([FromBody] CompetitorPostDTO dto) =>
+            Ok(new { saved = await _competitors.UpsertAsync(dto.Items ?? new List<CompetitorInput>(), "manual", CurrentDateTime()) });
+
+        // GET: api/ai/competitor-summary   (the lowest and median rival price per product, for the price advisor)
+        [HttpGet("~/api/ai/competitor-summary")]
+        [Authorize(Policy = "AI.Read")]
+        public async Task<IActionResult> CompetitorSummary()
+        {
+            var ids = await _dbContext.CompetitorPrices.AsNoTracking().Select(c => c.ProductId).Distinct().ToListAsync();
+            var s = await _competitors.SummaryAsync(ids);
+            return Ok(s.Values.Select(x => new { x.ProductId, x.Count, x.Lowest, x.LowestCompetitor, x.Median, x.Newest }));
+        }
+
+        // GET: api/ai/competitor-prices?productId=12
+        [HttpGet("~/api/ai/competitor-prices")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> CompetitorList(int productId) => Ok(await _competitors.ListAsync(productId));
+
+        // GET / PUT api/ai/channel, POST api/ai/channel/test   (where PesoWeb pushes alerts and price changes)

+        // GET: api/ai/baskets?warehouseId=1&afterId=0&take=500&since=2026-10-01
+        // Each sale as one basket (when, how much, which products and how many): AI Customer Mission works out what shoppers were trying to get done from these.
+        [HttpGet("~/api/ai/baskets")]
+        [Authorize(Policy = "AI.Read")]
+        public async Task<IActionResult> Baskets(int? warehouseId, int afterId = 0, int take = 500, DateTime? since = null)
+        {
+            take = Math.Clamp(take, 1, 2000);
+            var q = _dbContext.Sales.AsNoTracking().Where(s => s.Id > afterId);
+            if (warehouseId.HasValue) q = q.Where(s => s.WarehouseId == warehouseId.Value);
+            if (since.HasValue) q = q.Where(s => s.SaleDate >= since.Value);
+            var rows = await q.OrderBy(s => s.Id).Take(take)
+                .Select(s => new { s.Id, s.WarehouseId, s.SaleDate, s.TotalAmount, Lines = s.SaleDetails.Select(d => new { d.ProductId, d.Quantity, d.Amount }).ToList() })
+                .ToListAsync();
+            return Ok(new { baskets = rows, nextAfterId = rows.Count > 0 ? rows[^1].Id : afterId });
+        }
+

+namespace GoPosify.Services;
+
+public sealed class MissionInput
+{
+    public int WarehouseId { get; set; }
+    public string Mission { get; set; }
+    public int Baskets { get; set; }
+    public decimal SharePct { get; set; }
+    public decimal AvgItems { get; set; }
+    public decimal AvgValue { get; set; }
+    public int? PeakHour { get; set; }
+    public string Insight { get; set; }
+    public int WindowDays { get; set; }
+}
+
+public interface IMissionService
+{
+    // Replaces the mission picture of the branches a run covered.
+    Task<int> ReplaceAsync(IReadOnlyCollection<int> coveredWarehouseIds, IReadOnlyCollection<MissionInput> items, DateTime now);
+    Task<List<object>> ListAsync();
+}
+
+public sealed class MissionService : IMissionService
+{
+    private readonly AppDBContext _db;
+
+    public MissionService(AppDBContext db) => _db = db;
+
+    public async Task<int> ReplaceAsync(IReadOnlyCollection<int> coveredWarehouseIds, IReadOnlyCollection<MissionInput> items, DateTime now)
+    {
+        var warehouseIds = (await _db.Warehouses.AsNoTracking().Select(w => w.Id).ToListAsync()).ToHashSet();
+        var covered = coveredWarehouseIds.Where(warehouseIds.Contains).ToHashSet();
+        foreach (var w in items.Select(i => i.WarehouseId).Where(warehouseIds.Contains)) covered.Add(w);
+        _db.MissionInsights.RemoveRange(await _db.MissionInsights.Where(m => covered.Contains(m.WarehouseId)).ToListAsync());
+        var added = 0;
+        foreach (var i in items)
+        {
+            if (!warehouseIds.Contains(i.WarehouseId) || string.IsNullOrWhiteSpace(i.Mission) || i.Baskets <= 0) continue;
+            _db.MissionInsights.Add(new MissionInsight
+            {
+                WarehouseId = i.WarehouseId, Mission = i.Mission.Length > 40 ? i.Mission[..40] : i.Mission, Baskets = i.Baskets,
+                SharePct = Math.Round(i.SharePct, 2), AvgItems = Math.Round(i.AvgItems, 2), AvgValue = Math.Round(i.AvgValue, 2),
+                PeakHour = i.PeakHour is >= 0 and <= 23 ? i.PeakHour : null, Insight = i.Insight != null && i.Insight.Length > 400 ? i.Insight[..400] : i.Insight,
+                WindowDays = i.WindowDays, CreatedAt = now
+            });
+            added++;
+        }
+        await _db.SaveChangesAsync();
+        return added;
+    }
+
+    public async Task<List<object>> ListAsync()
+    {
+        var rows = await (from m in _db.MissionInsights.AsNoTracking() join w in _db.Warehouses.AsNoTracking() on m.WarehouseId equals w.Id
+                          orderby w.Id, m.SharePct descending select new { m, Branch = w.WarehouseName }).ToListAsync();
+        return rows.Select(r => (object)new
+        {
+            warehouseId = r.m.WarehouseId, branch = r.Branch, mission = r.m.Mission, baskets = r.m.Baskets, sharePct = r.m.SharePct, avgItems = r.m.AvgItems,
+            avgValue = r.m.AvgValue, peakHour = r.m.PeakHour, insight = r.m.Insight, windowDays = r.m.WindowDays, updatedAt = r.m.CreatedAt
+        }).ToList();
+    }
+}
+
+public sealed class CompetitorInput
+{
+    public int ProductId { get; set; }
+    public string Competitor { get; set; }
+    public decimal Price { get; set; }
+    public string Source { get; set; }
+    public DateTime? ObservedAt { get; set; }
+}
+
+public sealed class CompetitorSummary
+{
+    public int ProductId { get; set; }
+    public int Count { get; set; }
+    public decimal Lowest { get; set; }
+    public string LowestCompetitor { get; set; }
+    public decimal Median { get; set; }
+    public DateTime Newest { get; set; }
+}
+
+public interface ICompetitorService
+{
+    // The latest price per competitor wins. Returns how many rows were added or changed.
+    Task<int> UpsertAsync(IReadOnlyCollection<CompetitorInput> items, string defaultSource, DateTime now);
+    Task<Dictionary<int, CompetitorSummary>> SummaryAsync(IReadOnlyCollection<int> productIds);
+    Task<List<object>> ListAsync(int productId);
+}
+
+public sealed class CompetitorService : ICompetitorService
+{
+    private readonly AppDBContext _db;
+
+    public CompetitorService(AppDBContext db) => _db = db;
+
+    public async Task<int> UpsertAsync(IReadOnlyCollection<CompetitorInput> items, string defaultSource, DateTime now)
+    {
+        var productIds = (await _db.Products.AsNoTracking().Select(p => p.Id).ToListAsync()).ToHashSet();
+        var ids = items.Select(i => i.ProductId).Distinct().ToList();
+        var existing = await _db.CompetitorPrices.Where(c => ids.Contains(c.ProductId)).ToListAsync();
+        var n = 0;
+        foreach (var i in items)
+        {
+            var name = (i.Competitor ?? "").Trim();
+            if (!productIds.Contains(i.ProductId) || name.Length == 0 || i.Price <= 0m || i.Price > 100000000m) continue;
+            if (name.Length > 80) name = name[..80];
+            var observed = i.ObservedAt ?? now;
+            var row = existing.FirstOrDefault(c => c.ProductId == i.ProductId && string.Equals(c.Competitor, name, StringComparison.OrdinalIgnoreCase));
+            if (row == null)
+            {
+                row = new CompetitorPrice { ProductId = i.ProductId, Competitor = name };
+                _db.CompetitorPrices.Add(row);
+                existing.Add(row);
+            }
+            else if (row.ObservedAt > observed) continue;                     // never let an older observation replace a newer one
+            row.Price = Math.Round(i.Price, 2);
+            row.ObservedAt = observed;
+            row.Source = string.IsNullOrWhiteSpace(i.Source) ? defaultSource : (i.Source.Length > 20 ? i.Source[..20] : i.Source);
+            row.UpdatedAt = now;
+            n++;
+        }
+        await _db.SaveChangesAsync();
+        return n;
+    }
+
+    public async Task<Dictionary<int, CompetitorSummary>> SummaryAsync(IReadOnlyCollection<int> productIds)
+    {
+        var rows = await _db.CompetitorPrices.AsNoTracking().Where(c => productIds.Contains(c.ProductId)).ToListAsync();
+        return rows.GroupBy(r => r.ProductId).ToDictionary(g => g.Key, g =>
+        {
+            var sorted = g.OrderBy(r => r.Price).ToList();
+            var mid = sorted.Count / 2;
+            var median = sorted.Count % 2 == 1 ? sorted[mid].Price : (sorted[mid - 1].Price + sorted[mid].Price) / 2m;
+            return new CompetitorSummary { ProductId = g.Key, Count = sorted.Count, Lowest = sorted[0].Price, LowestCompetitor = sorted[0].Competitor, Median = Math.Round(median, 2), Newest = g.Max(r => r.ObservedAt) };
+        });
+    }
+
+    public async Task<List<object>> ListAsync(int productId) =>
+        (await _db.CompetitorPrices.AsNoTracking().Where(c => c.ProductId == productId).OrderBy(c => c.Price).ToListAsync())
+        .Select(c => (object)new { c.ProductId, c.Competitor, c.Price, c.ObservedAt, c.Source }).ToList();
+}

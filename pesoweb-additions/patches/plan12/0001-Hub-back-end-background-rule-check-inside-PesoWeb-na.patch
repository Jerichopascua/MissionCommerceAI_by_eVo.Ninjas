diff --git a/Models/HubExtras.cs b/Models/HubExtras.cs
new file mode 100644
index 0000000..d489108
--- /dev/null
+++ b/Models/HubExtras.cs
@@ -0,0 +1,99 @@
+using Microsoft.EntityFrameworkCore;
+using System.ComponentModel.DataAnnotations;
+using System.ComponentModel.DataAnnotations.Schema;
+
+namespace GoPosify.Models;
+
+// What shoppers at a branch were trying to get done, worked out by AI Customer Mission from their baskets (not from anything they said).
+[Index(nameof(TenantID), nameof(WarehouseId), Name = "IX_MissionInsights_Tenant_Branch")]
+public partial class MissionInsight
+{
+    [Key]
+    public int Id { get; set; }
+
+    public int TenantID { get; set; }
+
+    public int WarehouseId { get; set; }
+
+    [Required]
+    [StringLength(40)]
+    public string Mission { get; set; }
+
+    public int Baskets { get; set; }
+
+    [Column(TypeName = "decimal(9, 2)")]
+    public decimal SharePct { get; set; }
+
+    [Column(TypeName = "decimal(9, 2)")]
+    public decimal AvgItems { get; set; }
+
+    [Column(TypeName = "decimal(18, 2)")]
+    public decimal AvgValue { get; set; }
+
+    public int? PeakHour { get; set; }
+
+    [StringLength(400)]
+    public string Insight { get; set; }
+
+    public int WindowDays { get; set; }
+
+    public DateTime CreatedAt { get; set; }
+
+    public DateTime UpdatedAt { get; set; }
+}
+
+// A price a competitor charges for one of our products, as entered by a person, imported, or fed by an agent. The latest per competitor wins.
+[Index(nameof(TenantID), nameof(ProductId), nameof(Competitor), IsUnique = true, Name = "UX_CompetitorPrices_Tenant_Product_Competitor")]
+public partial class CompetitorPrice
+{
+    [Key]
+    public int Id { get; set; }
+
+    public int TenantID { get; set; }
+
+    public int ProductId { get; set; }
+
+    [Required]
+    [StringLength(80)]
+    public string Competitor { get; set; }
+
+    [Column(TypeName = "decimal(18, 2)")]
+    public decimal Price { get; set; }
+
+    public DateTime ObservedAt { get; set; }
+
+    // manual, import or feed
+    [StringLength(20)]
+    public string Source { get; set; }
+
+    public DateTime UpdatedAt { get; set; }
+}
+
+// Where a company wants PesoWeb to push events (alerts, price changes) so other systems can act: shelf labels, e-commerce, chat.
+[Index(nameof(TenantID), IsUnique = true, Name = "UX_HubChannelSettings_Tenant")]
+public partial class HubChannelSetting
+{
+    [Key]
+    public int Id { get; set; }
+
+    public int TenantID { get; set; }
+
+    [StringLength(500)]
+    public string WebhookUrl { get; set; }
+
+    public bool SendAlerts { get; set; } = true;
+
+    public bool SendPriceChanges { get; set; }
+
+    // The last business event already delivered (an outbox cursor), so a price change is sent once.
+    public long LastEventId { get; set; }
+
+    public DateTime? LastSentAt { get; set; }
+
+    [StringLength(200)]
+    public string LastStatus { get; set; }
+
+    public int? UpdatedByUserId { get; set; }
+
+    public DateTime UpdatedAt { get; set; }
+}

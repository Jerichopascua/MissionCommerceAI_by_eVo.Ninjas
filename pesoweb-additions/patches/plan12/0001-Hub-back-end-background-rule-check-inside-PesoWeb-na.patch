+public class HubChannelServiceTests
+{
+    private static readonly DateTime Now = new(2026, 10, 20, 12, 0, 0);
+
+    private sealed class RecordingHandler : HttpMessageHandler
+    {
+        public List<string> Bodies = new();
+        public HttpStatusCode Status = HttpStatusCode.OK;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Bodies.Add(request.Content == null ? "" : await request.Content.ReadAsStringAsync(cancellationToken));
+            return new HttpResponseMessage(Status);
+        }
+    }
+
+    private sealed class FakeConfig : Microsoft.Extensions.Configuration.IConfiguration
+    {
+        private readonly Dictionary<string, string> _v;
+        public FakeConfig(Dictionary<string, string> v) => _v = v;
+        public string this[string key] { get => _v.TryGetValue(key, out var x) ? x : null; set => _v[key] = value; }
+        public IEnumerable<Microsoft.Extensions.Configuration.IConfigurationSection> GetChildren() => Array.Empty<Microsoft.Extensions.Configuration.IConfigurationSection>();
+        public Microsoft.Extensions.Primitives.IChangeToken GetReloadToken() => throw new NotSupportedException();
+        public Microsoft.Extensions.Configuration.IConfigurationSection GetSection(string key) => throw new NotSupportedException();
+    }
+
+    private sealed class Factory : IHttpClientFactory
+    {
+        private readonly HttpMessageHandler _h;
+        public Factory(HttpMessageHandler h) => _h = h;
+        public HttpClient CreateClient(string name) => new(_h, disposeHandler: false);
+    }
+
+    private static (TestAppDbContext Db, HubChannelService Svc, RecordingHandler Handler) Create()
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        var handler = new RecordingHandler();
+        return (db, new HubChannelService(db, new Factory(handler), new FakeConfig(new Dictionary<string, string> { ["Hub:AllowLocalWebhooks"] = "true" })), handler);
+    }
+

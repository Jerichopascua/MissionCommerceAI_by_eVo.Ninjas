+  public showOnlineOrderModal(): void {
+    this.onlineOrder = { show: true, reference: '', loading: false, error: '', data: null };
+  }
+
+  public closeOnlineOrderModal(): void {
+    this.onlineOrder.show = false;
+  }
+
+  // The cashier keys in the reference the customer shows; the customer and the reserved items come back
+  public lookupOnlineOrder(): void {
+    const reference = String(this.onlineOrder.reference || '').trim();
+    if (!reference) { return; }
+    this.onlineOrder.loading = true;
+    this.onlineOrder.error = '';
+    this.onlineOrder.data = null;
+    const warehouse = this.sale.warehouseId > 0 ? `?warehouse=${this.sale.warehouseId}` : '';
+    this.http.get<any>(`${this.baseUrl}api/online-orders/${encodeURIComponent(reference)}${warehouse}`).subscribe({
+      next: (data) => { this.onlineOrder.loading = false; this.onlineOrder.data = data; },
+      error: (e) => {
+        this.onlineOrder.loading = false;
+        this.onlineOrder.error = e?.error?.message || this.app.Localize('No online order with that reference.');
+      }
+    });
+  }
+
+  // Put the online order into the sale exactly like items rung up by hand: customer, items, prices
+  public loadOnlineOrder(): void {
+    const order = this.onlineOrder.data;
+    if (!order) { return; }
+    if (order.customerId) {
+      if (!this.customers.find((c: any) => c.id === order.customerId)) {
+        this.customers.push({ id: order.customerId, customerName: order.customerName, availablePoints: 0 });
+      }
+      this.selectCustomer(order.customerId);
+    } else {
+      this.sale.customerName = order.customerName;
+    }
+    this.cartItems.splice(0, this.cartItems.length);
+    for (const l of order.lines) {
+      this.cartItems.push({
+        id: 0,
+        productId: l.productId,
+        variantId: 0,
+        productName: l.productName,
+        imageUrl: '',
+        price: l.price,
+        quantity: String(l.quantity),
+        availableQuantity: l.availableQuantity ?? 9999,
+        unit: ''
+      });
+    }
+    this.calculateTotal();
+    this.closeOnlineOrderModal();
+    this.app.SuccessMessage(this.app.Localize('Online order loaded'), `${order.reference} - ${order.customerName}`);
+  }
+

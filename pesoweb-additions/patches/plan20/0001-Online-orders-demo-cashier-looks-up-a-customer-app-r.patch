+using GoPosify.Services;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class CustomerAppDemoTests
+{
+    [Theory]
+    [InlineData("R4821")]
+    [InlineData(" r-4821 ")]
+    [InlineData("r 4821")]
+    public void The_demo_reference_is_recognised_however_it_is_keyed(string typed)
+        => Assert.True(CustomerAppDemo.IsDemoReference(typed));
+
+    [Theory]
+    [InlineData("")]
+    [InlineData(null)]
+    [InlineData("R4822")]
+    public void Any_other_reference_is_not_found(string typed)
+        => Assert.False(CustomerAppDemo.IsDemoReference(typed));
+
+    [Fact]
+    public void An_offer_price_is_the_current_price_less_the_percent_rounded_to_centavos()
+    {
+        Assert.Equal(52.50m, CustomerAppDemo.OfferPrice(105m, 50));
+        Assert.Equal(63.75m, CustomerAppDemo.OfferPrice(85m, 25));
+        Assert.Equal(53.90m, CustomerAppDemo.OfferPrice(98m, 45));
+    }
+
+    [Fact]
+    public void Thirty_percent_and_more_is_clearance_the_rest_is_sale()
+    {
+        Assert.Equal("clearance", CustomerAppDemo.Kind(30));
+        Assert.Equal("sale", CustomerAppDemo.Kind(29));
+    }
+
+    [Fact]
+    public void Every_product_in_the_demo_basket_has_an_offer_so_the_cashier_sees_the_clearance_prices()
+    {
+        var offered = CustomerAppDemo.Offers.Select(o => o.ProductId).ToHashSet();
+        Assert.All(CustomerAppDemo.Basket, l => Assert.Contains(l.ProductId, offered));
+    }
+}

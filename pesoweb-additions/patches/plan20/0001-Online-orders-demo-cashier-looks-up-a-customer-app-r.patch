@@ -0,0 +1,45 @@
+namespace GoPosify.Services
+{
+    // DEMO ONLY. The fixed offers, customer and reservation used to show the customer app and the cashier lookup working together.
+    // The real version reads offers from ActiveMarkdowns and reservations from a table; the response shapes stay the same.
+    public static class CustomerAppDemo
+    {
+        public const string Reference = "R4821";
+        public const string CustomerName = "Juan Dela Cruz";
+        public const string CustomerPhone = "09171234567";
+        public const decimal ClearanceFrom = 30m;       // a markdown of this percent or more is shown as "clearance"
+
+        public sealed record DemoOffer(int ProductId, decimal PercentOff, int DaysLeft, string Note);
+        public sealed record DemoLine(int ProductId, int Quantity);
+
+        // Product ids are 520 Minimart (company 6) product ids.
+        public static readonly DemoOffer[] Offers =
+        {
+            new(1362, 50, 2, "Best before soon - rush to the store"),
+            new(1421, 45, 2, "Best before soon - rush to the store"),
+            new(1393, 40, 1, "Last day"),
+            new(1385, 35, 3, "Clearance"),
+            new(1066, 30, 3, "Clearance"),
+            new(1406, 25, 3, "Weekend sale"),
+            new(1404, 20, 5, "Weekend sale"),
+            new(1485, 18, 6, "Sale"),
+            new(1468, 15, 5, "Weekend sale"),
+            new(1012, 12, 7, "Sale"),
+            new(1401, 10, 7, "Sale"),
+        };
+
+        // What the demo customer reserved in the app (the "Add demo basket" button there adds exactly this).
+        public static readonly DemoLine[] Basket =
+        {
+            new(1362, 2), new(1421, 1), new(1406, 2), new(1385, 1),
+        };
+
+        public static decimal OfferPrice(decimal price, decimal percentOff) => Math.Round(price * (100m - percentOff) / 100m, 2, MidpointRounding.AwayFromZero);
+
+        public static string Kind(decimal percentOff) => percentOff >= ClearanceFrom ? "clearance" : "sale";
+
+        public static string Normalize(string reference) => (reference ?? "").Trim().ToUpperInvariant().Replace(" ", "").Replace("-", "");
+
+        public static bool IsDemoReference(string reference) => Normalize(reference) == Reference;
+    }
+}

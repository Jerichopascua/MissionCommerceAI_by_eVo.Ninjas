     if (!selectedCustomer) {
diff --git a/Controllers/OnlineOrdersController.cs b/Controllers/OnlineOrdersController.cs
new file mode 100644
index 0000000..b235c1b
--- /dev/null
+++ b/Controllers/OnlineOrdersController.cs
@@ -0,0 +1,122 @@
+using GoPosify.Data;
+using GoPosify.Services;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Controllers
+{
+    // DEMO ONLY: the customer app's price feed and the cashier's lookup of an online reservation by reference.
+    // Both are read-only; neither changes stock, prices or sales.
+    [ApiController]
+    public class OnlineOrdersController : BaseController
+    {
+        private readonly IConfiguration _config;
+
+        public OnlineOrdersController(AppDBContext dbContext, IConfiguration config) : base(dbContext)
+        {
+            _config = config;
+        }
+
+        // GET: api/customer-app/offers  (public, read-only: the catalog and prices a shopper could see in the store anyway)
+        // Off unless CustomerApp:TenantId names the company whose prices are published.
+        [HttpGet("~/api/customer-app/offers")]
+        [AllowAnonymous]
+        public async Task<IActionResult> Offers()
+        {
+            Response.Headers["Access-Control-Allow-Origin"] = "*";
+            var tenantId = _config.GetValue<int>("CustomerApp:TenantId");
+            if (tenantId <= 0) return NotFound();
+
+            var now = DateTime.Now;
+            var products = await _dbContext.Products.IgnoreQueryFilters().AsNoTracking()
+                .Where(p => p.TenantID == tenantId && p.Price > 0)
+                .OrderBy(p => p.ProductName).Take(1000)
+                .Select(p => new { p.Id, p.ProductName, p.Price }).ToListAsync();
+
+            // Real markdowns first (what the AI proposed and the owner approved); the fixed demo offers fill in for the rest.
+            var live = await _dbContext.ActiveMarkdowns.IgnoreQueryFilters().AsNoTracking()
+                .Where(m => m.TenantID == tenantId && m.IsActive && m.StartsAt <= now && (m.EndsAt == null || m.EndsAt > now))
+                .Select(m => new { m.ProductId, m.Price, m.EndsAt }).ToListAsync();
+            var liveByProduct = live.GroupBy(m => m.ProductId).ToDictionary(g => g.Key, g => g.OrderBy(m => m.Price).First());
+            var demo = CustomerAppDemo.Offers.ToDictionary(o => o.ProductId);
+
+            var rows = products.Select(p =>
+            {
+                object offer = null;
+                if (liveByProduct.TryGetValue(p.Id, out var m) && m.Price < p.Price)
+                {
+                    var pct = Math.Round((p.Price - m.Price) / p.Price * 100m, 0);
+                    offer = new
+                    {
+                        kind = CustomerAppDemo.Kind(pct), percentOff = pct, price = m.Price, source = "pesoweb",
+                        daysLeft = m.EndsAt.HasValue ? Math.Max(0, (int)Math.Ceiling((m.EndsAt.Value - now).TotalDays)) : 7,
+                        note = "Price drop"
+                    };
+                }
+                else if (demo.TryGetValue(p.Id, out var d))
+                {
+                    offer = new
+                    {
+                        kind = CustomerAppDemo.Kind(d.PercentOff), percentOff = d.PercentOff, price = CustomerAppDemo.OfferPrice(p.Price, d.PercentOff),
+                        source = "demo", daysLeft = d.DaysLeft, note = d.Note
+                    };
+                }
+                return new { id = p.Id, name = p.ProductName, price = p.Price, offer };
+            }).ToList();
+
+            return Ok(new { generatedAt = now, products = rows });
+        }
+
+        // GET: api/online-orders/R4821  (the cashier keys in the reference the customer shows)
+        [HttpGet("~/api/online-orders/{reference}")]
+        [Authorize]
+        public async Task<IActionResult> Lookup(string reference, int? warehouse = null)
+        {
+            if (!CustomerAppDemo.IsDemoReference(reference))
+                return NotFound(new { message = "No online order with that reference." });
+
+            var ids = CustomerAppDemo.Basket.Select(l => l.ProductId).ToList();
+            var products = await _dbContext.Products.AsNoTracking().Where(p => ids.Contains(p.Id))
+                .Select(p => new { p.Id, p.ProductName, p.Price }).ToListAsync();
+            var stock = warehouse.HasValue
+                ? await _dbContext.ProductWarehouses.AsNoTracking().Where(w => w.WarehouseId == warehouse.Value && ids.Contains(w.ProductId))
+                    .GroupBy(w => w.ProductId).Select(g => new { ProductId = g.Key, Qty = g.Sum(w => w.Quantity) }).ToListAsync()
+                : null;
+            var offers = CustomerAppDemo.Offers.ToDictionary(o => o.ProductId);
+
+            var lines = new List<object>();
+            decimal total = 0;
+            foreach (var l in CustomerAppDemo.Basket)
+            {
+                var p = products.FirstOrDefault(x => x.Id == l.ProductId);
+                if (p == null) continue;                                         // not a product of this company: left out
+                var price = offers.TryGetValue(l.ProductId, out var o) ? CustomerAppDemo.OfferPrice(p.Price, o.PercentOff) : p.Price;
+                total += price * l.Quantity;
+                lines.Add(new
+                {
+                    productId = p.Id, productName = p.ProductName, quantity = l.Quantity, price, regularPrice = p.Price,
+                    availableQuantity = stock?.FirstOrDefault(s => s.ProductId == p.Id)?.Qty
+                });
+            }
+            if (lines.Count == 0) return NotFound(new { message = "The products of this online order are not in this company." });
+
+            var phone = CustomerAppDemo.CustomerPhone;
+            var customer = await _dbContext.Customers.AsNoTracking()
+                .Where(c => c.Phone == phone || c.CustomerName == CustomerAppDemo.CustomerName)
+                .Select(c => new { c.Id, c.CustomerName }).FirstOrDefaultAsync();
+
+            return Ok(new
+            {
+                reference = CustomerAppDemo.Reference,
+                demo = true,
+                customerId = customer?.Id,
+                customerName = customer?.CustomerName ?? CustomerAppDemo.CustomerName,
+                customerPhone = CustomerAppDemo.CustomerPhone,
+                paymentMode = "Pay at the store",
+                lines,
+                total
+            });
+        }
+    }
+}

+        // POST: api/pricing/listprice
+        // Propose a change to a product's LIST price (company-wide). It is validated by the guardrails and then waits for a human
+        // approval (202); nothing changes until ApproveListPrice. A rule violation is refused (422) and recorded.
+        [HttpPost]
+        [Authorize(Policy = "Pricing.Markdown")]
+        public async Task<IActionResult> ListPrice([FromBody] ListPriceRequestDTO dto)
+        {
+            try
+            {
+                var userId = CurrentUserId();
+                if (!await _dbContext.UserWarehouses.AnyAsync(uw => uw.UserId == userId && uw.WarehouseId == dto.WarehouseId))
+                {
+                    return BadRequest(new { message = "You do not have access to this branch." });
+                }
+
+                var source = string.Equals(dto.Source, PriceChangeSource.Ai, StringComparison.OrdinalIgnoreCase)
+                    ? PriceChangeSource.Ai : PriceChangeSource.Manual;
+                var outcome = await _listPrices.ProposeAsync(new ListPriceProposal
+                {
+                    WarehouseId = dto.WarehouseId, ProductId = dto.ProductId, NewPrice = dto.NewPrice, Reason = dto.Reason, PredictionRef = dto.PredictionRef
+                }, source, userId, CurrentDateTime());
+
+                return outcome.Decision == GuardrailDecision.NeedsApproval
+                    ? StatusCode(StatusCodes.Status202Accepted, outcome)
+                    : StatusCode(StatusCodes.Status422UnprocessableEntity, outcome);
+            }
+            catch (InvalidOperationException ex)
+            {
+                return BadRequest(new { message = ex.Message });
+            }
+            catch (Exception ex)
+            {
+                return HandleServerError(ex, "An error occurred while proposing the list price change.", "Pricing", "ListPrice");
+            }
+        }
+
+        // POST: api/pricing/approvelistprice
+        [HttpPost]
+        [Authorize(Policy = "Pricing.Approve")]
+        public async Task<IActionResult> ApproveListPrice([FromBody] PriceChangeDecisionDTO dto)
+        {
+            try
+            {
+                var outcome = await _listPrices.ApproveAsync(dto.PriceChangeId, CurrentUserId(), CurrentDateTime());
+                return outcome.Decision == GuardrailDecision.Allowed ? Ok(outcome) : StatusCode(StatusCodes.Status422UnprocessableEntity, outcome);
+            }
+            catch (InvalidOperationException ex)
+            {
+                return BadRequest(new { message = ex.Message });
+            }
+            catch (Exception ex)
+            {
+                return HandleServerError(ex, "An error occurred while approving the list price change.", "Pricing", "ApproveListPrice");
+            }
+        }
+
+        // POST: api/pricing/rejectlistprice
+        [HttpPost]
+        [Authorize(Policy = "Pricing.Approve")]
+        public async Task<IActionResult> RejectListPrice([FromBody] PriceChangeDecisionDTO dto)
+        {
+            try
+            {
+                return Ok(await _listPrices.RejectAsync(dto.PriceChangeId, CurrentUserId(), dto.Reason, CurrentDateTime()));
+            }
+            catch (InvalidOperationException ex)
+            {
+                return BadRequest(new { message = ex.Message });
+            }
+            catch (Exception ex)
+            {
+                return HandleServerError(ex, "An error occurred while rejecting the list price change.", "Pricing", "RejectListPrice");
+            }
+        }
+
+        // GET: api/pricing/listpricechanges?status=PendingApproval&productId=5
+        [HttpGet]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> ListPriceChanges(string status, int? productId)
+        {
+            var q = _dbContext.PriceChanges.AsNoTracking().Where(c => c.BatchId == null);
+            if (!string.IsNullOrWhiteSpace(status)) q = q.Where(c => c.Status == status);
+            if (productId.HasValue) q = q.Where(c => c.ProductId == productId.Value);
+            return Ok(await q.OrderByDescending(c => c.Id).Take(500).ToListAsync());
+        }
+
         // POST: api/pricing/approve
         [HttpPost]
         [Authorize(Policy = "Pricing.Approve")]

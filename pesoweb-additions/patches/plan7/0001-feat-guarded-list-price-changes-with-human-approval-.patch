+using GoPosify.Models;
+using GoPosify.Services;
+using Microsoft.EntityFrameworkCore;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class ListPriceServiceTests
+{
+    private static readonly DateTime Now = new(2026, 10, 20, 10, 0, 0);
+
+    private sealed class World
+    {
+        public TestAppDbContext Db;
+        public ListPriceService Svc;
+        public Product Product;
+    }
+
+    private static async Task<World> CreateAsync(PricingPolicy policy = null, decimal price = 100m, decimal cost = 60m)
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        if (policy != null) db.PricingPolicies.Add(policy);
+        var product = PricingFixtures.NewProduct(price: price, cost: cost, monitorExpiry: false);
+        db.Products.Add(product);
+        await db.SaveChangesAsync();
+        return new World { Db = db, Svc = new ListPriceService(db, PricingFixtures.Publisher(db)), Product = product };
+    }
+
+    private static ListPriceProposal Propose(World w, decimal price) => new()
+    {
+        WarehouseId = 1, ProductId = w.Product.Id, NewPrice = price, Reason = "advisor: best safe price", PredictionRef = "adv-1"
+    };
+
+    private static decimal CurrentPrice(World w) => w.Db.Products.AsNoTracking().Single(p => p.Id == w.Product.Id).Price;
+
+    [Fact]
+    public async Task A_safe_proposal_waits_for_approval_and_changes_nothing()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+
+        var o = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+
+        Assert.Equal(GuardrailDecision.NeedsApproval, o.Decision);
+        Assert.Equal(100m, CurrentPrice(w));
+        var pc = Assert.Single(w.Db.PriceChanges.ToList());
+        Assert.Equal(PriceChangeStatus.PendingApproval, pc.Status);
+        Assert.Null(pc.BatchId);
+        Assert.Equal((100m, 108m), (pc.PriceBefore, pc.PriceAfter));
+        Assert.Equal(-8m, pc.DiscountPct);
+        Assert.Equal("adv-1", pc.PredictionRef);
+        Assert.Empty(w.Db.BusinessEvents.ToList());
+    }
+
+    [Fact]
+    public async Task Approval_applies_the_price_writes_the_ledger_and_publishes_one_event()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        var proposed = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+
+        var o = await w.Svc.ApproveAsync(proposed.PriceChangeId, 7, Now.AddMinutes(5));
+
+        Assert.Equal(GuardrailDecision.Allowed, o.Decision);
+        Assert.Equal(108m, o.AppliedPrice);
+        Assert.Equal(108m, CurrentPrice(w));
+        var pc = Assert.Single(w.Db.PriceChanges.ToList());
+        Assert.Equal(PriceChangeStatus.Applied, pc.Status);
+        Assert.Equal(7, pc.DecidedBy);
+        var ev = Assert.Single(w.Db.BusinessEvents.ToList());
+        Assert.Equal(BusinessEventTypes.PriceChanged, ev.EventType);
+        Assert.Contains("\"kind\":\"list_price\"", ev.PayloadJson);
+    }
+
+    [Fact]
+    public async Task A_rule_violation_is_refused_recorded_and_never_applied()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+
+        var o = await w.Svc.ProposeAsync(Propose(w, 61m), PriceChangeSource.Ai, 9, Now);
+
+        Assert.Equal(GuardrailDecision.Rejected, o.Decision);
+        Assert.Equal(GuardrailCodes.BelowHardFloor, o.Code);
+        Assert.Equal(100m, CurrentPrice(w));
+        Assert.Equal(PriceChangeStatus.Rejected, Assert.Single(w.Db.PriceChanges.ToList()).Status);
+    }
+
+    [Fact]
+    public async Task Rejecting_leaves_the_price_alone_and_cannot_be_repeated()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+
+        var o = await w.Svc.RejectAsync(p.PriceChangeId, 7, "not now", Now);
+
+        Assert.Equal(GuardrailCodes.RejectedByUser, o.Code);
+        Assert.Equal(100m, CurrentPrice(w));
+        await Assert.ThrowsAsync<InvalidOperationException>(() => w.Svc.ApproveAsync(p.PriceChangeId, 7, Now));
+    }
+
+    [Fact]
+    public async Task A_change_cannot_be_approved_twice()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+        await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now);
+        await Assert.ThrowsAsync<InvalidOperationException>(() => w.Svc.ApproveAsync(p.PriceChangeId, 7, Now));
+    }
+
+    [Fact]
+    public async Task Approval_rechecks_the_rules_against_todays_cost()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 90m), PriceChangeSource.Ai, 9, Now);       // fine at cost 60
+        var product = await w.Db.Products.SingleAsync(x => x.Id == w.Product.Id);
+        product.Cost = 88m;                                                                    // the supplier raised the cost meanwhile
+        await w.Db.SaveChangesAsync();
+
+        var o = await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now.AddHours(1));
+
+        Assert.Equal(GuardrailCodes.BelowHardFloor, o.Code);
+        Assert.Equal(100m, CurrentPrice(w));
+    }
+
+    [Fact]
+    public async Task Approval_is_refused_if_the_list_price_moved_since_the_proposal()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        var p = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+        var product = await w.Db.Products.SingleAsync(x => x.Id == w.Product.Id);
+        product.Price = 104m;
+        await w.Db.SaveChangesAsync();
+
+        var o = await w.Svc.ApproveAsync(p.PriceChangeId, 7, Now);
+
+        Assert.Equal(ListPriceCodes.PriceChangedSince, o.Code);
+        Assert.Equal(104m, CurrentPrice(w));
+    }
+
+    [Fact]
+    public async Task An_active_markdown_blocks_the_proposal()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        w.Db.ActiveMarkdowns.Add(new ActiveMarkdown { WarehouseId = 1, ProductId = w.Product.Id, BatchId = 1, Price = 80m, StartsAt = Now, IsActive = true, PriceChangeId = 1, Source = PriceChangeSource.Ai });
+        await w.Db.SaveChangesAsync();
+
+        var o = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+
+        Assert.Equal(ListPriceCodes.ActiveMarkdown, o.Code);
+    }
+
+    [Fact]
+    public async Task No_policy_and_autonomy_off_refuse_the_proposal()
+    {
+        var none = await CreateAsync(null);
+        await using var _a = none.Db;
+        Assert.Equal(GuardrailCodes.NoPolicy, (await none.Svc.ProposeAsync(Propose(none, 108m), PriceChangeSource.Ai, 9, Now)).Code);
+        var off = await CreateAsync(PricingFixtures.Policy(AutonomyModes.Off));
+        await using var _b = off.Db;
+        Assert.Equal(GuardrailCodes.AutonomyOff, (await off.Svc.ProposeAsync(Propose(off, 108m), PriceChangeSource.Ai, 9, Now)).Code);
+    }
+
+    [Fact]
+    public async Task The_hourly_limit_counts_pending_and_applied_list_price_changes()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());                                    // 3 per hour
+        await using var _ = w.Db;
+        for (var i = 0; i < 3; i++) await w.Svc.ProposeAsync(Propose(w, 101m + i), PriceChangeSource.Ai, 9, Now.AddMinutes(i));
+        var fourth = await w.Svc.ProposeAsync(Propose(w, 105m), PriceChangeSource.Ai, 9, Now.AddMinutes(10));
+        Assert.Equal(GuardrailCodes.TooManyChanges, fourth.Code);
+    }
+
+    [Fact]
+    public async Task Unknown_product_is_an_error_and_markdown_approval_ignores_list_price_rows()
+    {
+        var w = await CreateAsync(PricingFixtures.Policy());
+        await using var _ = w.Db;
+        await Assert.ThrowsAsync<InvalidOperationException>(() =>
+            w.Svc.ProposeAsync(new ListPriceProposal { WarehouseId = 1, ProductId = 99999, NewPrice = 5m }, PriceChangeSource.Ai, 9, Now));
+        var p = await w.Svc.ProposeAsync(Propose(w, 108m), PriceChangeSource.Ai, 9, Now);
+        var markdowns = new MarkdownService(w.Db, PricingFixtures.Publisher(w.Db));
+        await Assert.ThrowsAsync<InvalidOperationException>(() => markdowns.ApproveAsync(p.PriceChangeId, 7, Now));   // a list-price row is not a markdown
+        Assert.Equal(100m, CurrentPrice(w));
+    }
+}

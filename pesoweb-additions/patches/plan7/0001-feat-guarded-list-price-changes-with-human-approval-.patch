+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public sealed class ListPriceProposal
+{
+    public int WarehouseId { get; set; }          // the branch the request is recorded against; the change itself applies company-wide
+    public int ProductId { get; set; }
+    public decimal NewPrice { get; set; }
+    public string Reason { get; set; }
+    public string PredictionRef { get; set; }
+}
+
+public sealed class ListPriceOutcome
+{
+    public GuardrailDecision Decision { get; set; }
+    public string Code { get; set; }
+    public string Message { get; set; }
+    public long PriceChangeId { get; set; }
+    public decimal? AppliedPrice { get; set; }
+}
+
+public interface IListPriceService
+{
+    Task<ListPriceOutcome> ProposeAsync(ListPriceProposal p, string source, int? userId, DateTime now);
+    Task<ListPriceOutcome> ApproveAsync(long priceChangeId, int userId, DateTime now);
+    Task<ListPriceOutcome> RejectAsync(long priceChangeId, int userId, string reason, DateTime now);
+}
+
+// Propose, approve and apply list-price changes with guardrails, a ledger row and a PriceChanged event.
+// The ledger reuses PriceChanges: a list-price change is the row with no BatchId.
+public sealed class ListPriceService : IListPriceService
+{
+    private readonly AppDBContext _db;
+    private readonly IBusinessEventPublisher _events;
+
+    public ListPriceService(AppDBContext db, IBusinessEventPublisher events)
+    {
+        _db = db;
+        _events = events;
+    }
+
+    public async Task<ListPriceOutcome> ProposeAsync(ListPriceProposal p, string source, int? userId, DateTime now)
+    {
+        var product = await _db.Products.AsNoTracking().FirstOrDefaultAsync(x => x.Id == p.ProductId)
+            ?? throw new InvalidOperationException("Product not found.");
+        var policy = await _db.PricingPolicies.AsNoTracking().FirstOrDefaultAsync();
+
+        GuardrailResult result;
+        if (policy == null)
+        {
+            result = GuardrailResult.Reject(GuardrailCodes.NoPolicy, "No pricing policy is configured for this tenant.");
+        }
+        else
+        {
+            result = ListPriceGuardrails.Evaluate(policy, product.Price, p.NewPrice, product.Discount, product.Cost,
+                await CountRecentAsync(p.ProductId, now, null), await HasActiveMarkdownAsync(p.ProductId));
+        }
+
+        var change = new PriceChange
+        {
+            WarehouseId = p.WarehouseId,
+            ProductId = p.ProductId,
+            BatchId = null,
+            PriceBefore = product.Price,
+            PriceAfter = p.NewPrice,
+            DiscountPct = product.Price > 0 ? (product.Price - p.NewPrice) / product.Price * 100m : 0m,    // negative for an increase
+            Reason = Trim(p.Reason, 300),
+            Source = source,
+            Status = result.Decision == GuardrailDecision.NeedsApproval ? PriceChangeStatus.PendingApproval : PriceChangeStatus.Rejected,
+            GuardrailCode = result.Code,
+            GuardrailMessage = Trim(result.Message, 300),
+            PredictionRef = Trim(p.PredictionRef, 64),
+            CreatedBy = userId,
+            CreatedAt = now
+        };
+        _db.PriceChanges.Add(change);
+        await _db.SaveChangesAsync();
+        return Outcome(result, change.Id, null);
+    }
+
+    public async Task<ListPriceOutcome> ApproveAsync(long priceChangeId, int userId, DateTime now)
+    {
+        var change = await GetPendingAsync(priceChangeId);
+        var product = await _db.Products.FirstOrDefaultAsync(x => x.Id == change.ProductId);
+        if (product == null)
+        {
+            return await FinishRejectedAsync(change, GuardrailCodes.BatchUnavailable, "Product not found.", userId, now);
+        }
+
+        if (product.Price != change.PriceBefore)
+        {
+            return await FinishRejectedAsync(change, ListPriceCodes.PriceChangedSince,
+                $"The list price is now {product.Price}, not {change.PriceBefore} as when this was proposed.", userId, now);
+        }
+
+        var policy = await _db.PricingPolicies.AsNoTracking().FirstOrDefaultAsync();
+        if (policy == null)
+        {
+            return await FinishRejectedAsync(change, GuardrailCodes.NoPolicy, "No pricing policy is configured for this tenant.", userId, now);
+        }
+
+        var result = ListPriceGuardrails.Evaluate(policy, product.Price, change.PriceAfter, product.Discount, product.Cost,
+            await CountRecentAsync(change.ProductId, now, change.Id), await HasActiveMarkdownAsync(change.ProductId), approved: true);
+        if (result.Decision != GuardrailDecision.Allowed)
+        {
+            return await FinishRejectedAsync(change, result.Code, result.Message, userId, now);
+        }
+
+        product.Price = change.PriceAfter;
+        product.UpdatedAt = now;
+        change.Status = PriceChangeStatus.Applied;
+        change.GuardrailCode = GuardrailCodes.Ok;
+        change.GuardrailMessage = "Approved and applied.";
+        change.DecidedBy = userId;
+        change.DecidedAt = now;
+        await _db.SaveChangesAsync();
+
+        _events.Publish(BusinessEventTypes.PriceChanged, change.WarehouseId, $"pc-{change.Id}",
+            new
+            {
+                kind = "list_price", priceChangeId = change.Id, productId = change.ProductId, priceBefore = change.PriceBefore,
+                priceAfter = change.PriceAfter, source = change.Source, predictionRef = change.PredictionRef, approvedBy = userId
+            },
+            now);
+        await _db.SaveChangesAsync();
+        return Outcome(GuardrailResult.Allow(), change.Id, change.PriceAfter);
+    }
+
+    public async Task<ListPriceOutcome> RejectAsync(long priceChangeId, int userId, string reason, DateTime now)
+    {
+        var change = await GetPendingAsync(priceChangeId);
+        return await FinishRejectedAsync(change, GuardrailCodes.RejectedByUser,
+            string.IsNullOrWhiteSpace(reason) ? "Rejected by approver." : reason, userId, now);
+    }
+
+    private Task<int> CountRecentAsync(int productId, DateTime now, long? excludeId)
+    {
+        var since = now.AddHours(-1);
+        return _db.PriceChanges.CountAsync(c =>
+            c.ProductId == productId && c.BatchId == null && c.CreatedAt > since
+            && (c.Status == PriceChangeStatus.Applied || c.Status == PriceChangeStatus.PendingApproval)
+            && (!excludeId.HasValue || c.Id != excludeId.Value));
+    }
+
+    private Task<bool> HasActiveMarkdownAsync(int productId) => _db.ActiveMarkdowns.AnyAsync(m => m.IsActive && m.ProductId == productId);
+
+    private async Task<PriceChange> GetPendingAsync(long priceChangeId)
+        => await _db.PriceChanges.FirstOrDefaultAsync(c => c.Id == priceChangeId && c.BatchId == null && c.Status == PriceChangeStatus.PendingApproval)
+           ?? throw new InvalidOperationException("List price change not found or not pending.");
+
+    private async Task<ListPriceOutcome> FinishRejectedAsync(PriceChange change, string code, string message, int? userId, DateTime now)
+    {
+        change.Status = PriceChangeStatus.Rejected;
+        change.GuardrailCode = code;
+        change.GuardrailMessage = Trim(message, 300);
+        change.DecidedBy = userId;
+        change.DecidedAt = now;
+        await _db.SaveChangesAsync();
+        return Outcome(GuardrailResult.Reject(code, message), change.Id, null);
+    }
+
+    private static ListPriceOutcome Outcome(GuardrailResult r, long id, decimal? applied) => new()
+    {
+        Decision = r.Decision, Code = r.Code, Message = r.Message, PriceChangeId = id, AppliedPrice = applied
+    };
+
+    private static string Trim(string s, int max) => string.IsNullOrEmpty(s) || s.Length <= max ? s : s.Substring(0, max);
+}

@@ -0,0 +1,80 @@
+using GoPosify.Models;
+using GoPosify.Services;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class ListPriceGuardrailsTests
+{
+    private static GuardrailResult Eval(decimal current, decimal next, decimal cost = 60m, string mode = AutonomyModes.Autonomous,
+        int changes = 0, bool activeMarkdown = false, bool approved = false, decimal discount = 0m)
+        => ListPriceGuardrails.Evaluate(PricingFixtures.Policy(mode), current, next, discount, cost, changes, activeMarkdown, approved);
+
+    [Fact]
+    public void A_safe_change_needs_approval_even_in_autonomous_mode()
+    {
+        var r = Eval(100m, 108m);
+        Assert.Equal(GuardrailDecision.NeedsApproval, r.Decision);
+        Assert.Equal(ListPriceCodes.ListPriceApproval, r.Code);
+    }
+
+    [Fact]
+    public void Once_approved_a_safe_change_is_allowed()
+        => Assert.Equal(GuardrailDecision.Allowed, Eval(100m, 108m, approved: true).Decision);
+
+    [Fact]
+    public void Autonomy_off_rejects_everything()
+        => Assert.Equal(GuardrailCodes.AutonomyOff, Eval(100m, 108m, mode: AutonomyModes.Off).Code);
+
+    [Theory]
+    [InlineData(100, 100)]
+    [InlineData(100, 0)]
+    [InlineData(100, -5)]
+    public void Same_zero_or_negative_price_is_not_a_change(int current, int next)
+        => Assert.Equal(ListPriceCodes.NotAChange, Eval(current, next).Code);
+
+    [Fact]
+    public void Unknown_cost_is_rejected()
+        => Assert.Equal(GuardrailCodes.NoCost, Eval(100m, 108m, cost: 0m).Code);
+
+    [Fact]
+    public void An_active_markdown_blocks_a_list_price_change()
+        => Assert.Equal(ListPriceCodes.ActiveMarkdown, Eval(100m, 108m, activeMarkdown: true).Code);
+
+    [Fact]
+    public void A_price_below_the_hard_floor_is_rejected()
+    {
+        Assert.Equal(GuardrailCodes.BelowHardFloor, Eval(100m, 62m).Code);              // floor is 63 (cost 60 + 5%)
+        Assert.NotEqual(GuardrailCodes.BelowHardFloor, Eval(100m, 63m).Code);
+    }
+
+    [Fact]
+    public void The_floor_is_checked_on_the_net_price_after_the_product_discount()
+        => Assert.Equal(GuardrailCodes.BelowHardFloor, Eval(100m, 66m, discount: 10m).Code);   // 66 less 10% = 59.4
+
+    [Fact]
+    public void A_decrease_beyond_the_max_discount_is_rejected()
+        => Assert.Equal(GuardrailCodes.ExceedsMaxDiscount, Eval(200m, 90m, cost: 10m).Code);   // -55% against a 50% limit
+
+    [Fact]
+    public void An_increase_beyond_the_single_step_cap_is_rejected_and_the_cap_itself_is_allowed()
+    {
+        Assert.Equal(ListPriceCodes.ExceedsMaxIncrease, Eval(100m, 116m).Code);
+        Assert.Equal(GuardrailDecision.NeedsApproval, Eval(100m, 115m).Decision);
+    }
+
+    [Fact]
+    public void The_hourly_rate_limit_applies()
+    {
+        Assert.Equal(GuardrailCodes.TooManyChanges, Eval(100m, 108m, changes: 3).Code);
+        Assert.Equal(GuardrailDecision.NeedsApproval, Eval(100m, 108m, changes: 2).Decision);
+    }
+
+    [Fact]
+    public void Hard_limits_cannot_be_waived_by_approval()
+    {
+        Assert.Equal(GuardrailCodes.BelowHardFloor, Eval(100m, 62m, approved: true).Code);
+        Assert.Equal(ListPriceCodes.ExceedsMaxIncrease, Eval(100m, 130m, approved: true).Code);
+    }
+}

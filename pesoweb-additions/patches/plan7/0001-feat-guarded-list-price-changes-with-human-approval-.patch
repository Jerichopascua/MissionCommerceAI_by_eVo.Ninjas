@@ -0,0 +1,71 @@
+using GoPosify.Models;
+
+namespace GoPosify.Services;
+
+public static class ListPriceCodes
+{
+    public const string NotAChange = "NOT_A_CHANGE";
+    public const string ActiveMarkdown = "ACTIVE_MARKDOWN";
+    public const string ExceedsMaxIncrease = "EXCEEDS_MAX_INCREASE";
+    public const string PriceChangedSince = "PRICE_CHANGED_SINCE";
+    public const string ListPriceApproval = "LIST_PRICE_APPROVAL";
+}
+
+// Rules for changing a product's LIST price (company-wide), as opposed to a per-batch markdown. A list-price change can raise
+// or lower the price, but it ALWAYS needs a human approval before it is applied, whatever the autonomy mode.
+public static class ListPriceGuardrails
+{
+    // Largest single increase accepted in one proposal (a bounded step, never a leap). Decreases are bounded by MaxDiscountPct.
+    public const decimal MaxIncreasePct = 15m;
+
+    public static GuardrailResult Evaluate(PricingPolicy p, decimal currentPrice, decimal newPrice, decimal productDiscountPct,
+        decimal cost, int changesLastHour, bool hasActiveMarkdown, bool approved = false)
+    {
+        if (p.AutonomyMode == AutonomyModes.Off)
+        {
+            return GuardrailResult.Reject(GuardrailCodes.AutonomyOff, "Pricing autonomy is off for this tenant.");
+        }
+
+        if (newPrice <= 0m || newPrice == currentPrice)
+        {
+            return GuardrailResult.Reject(ListPriceCodes.NotAChange, "The new price must be above zero and different from the current price.");
+        }
+
+        if (cost <= 0m)
+        {
+            return GuardrailResult.Reject(GuardrailCodes.NoCost, "No unit cost is known for this product, so the margin floor cannot be checked.");
+        }
+
+        if (hasActiveMarkdown)
+        {
+            return GuardrailResult.Reject(ListPriceCodes.ActiveMarkdown, "This product has an active markdown; end it before changing the list price.");
+        }
+
+        var newNet = MarkdownGuardrails.NetPrice(newPrice, productDiscountPct);
+        if (newNet < cost * (1m + p.HardMarginFloorPct / 100m))
+        {
+            return GuardrailResult.Reject(GuardrailCodes.BelowHardFloor, $"Price is below the hard margin floor ({p.HardMarginFloorPct}% over cost).");
+        }
+
+        var changePct = (newPrice - currentPrice) / currentPrice * 100m;
+        if (changePct < 0m && -changePct > p.MaxDiscountPct)
+        {
+            return GuardrailResult.Reject(GuardrailCodes.ExceedsMaxDiscount, $"A decrease of {-changePct:0.#}% exceeds the maximum of {p.MaxDiscountPct}%.");
+        }
+
+        if (changePct > MaxIncreasePct)
+        {
+            return GuardrailResult.Reject(ListPriceCodes.ExceedsMaxIncrease, $"An increase of {changePct:0.#}% exceeds the maximum single step of {MaxIncreasePct}%.");
+        }
+
+        if (changesLastHour >= p.MaxChangesPerSkuPerHour)
+        {
+            return GuardrailResult.Reject(GuardrailCodes.TooManyChanges,
+                $"Already {changesLastHour} price changes for this product in the last hour (limit {p.MaxChangesPerSkuPerHour}).");
+        }
+
+        return approved
+            ? GuardrailResult.Allow()
+            : GuardrailResult.NeedApproval(ListPriceCodes.ListPriceApproval, "A list price change always needs a human approval.");
+    }
+}

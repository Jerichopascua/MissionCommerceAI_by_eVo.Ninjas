             _control = control;
             _group = group;
+            _metrics = metrics;
+            _rules = rules;
+            _tasks = tasks;
+            _replenish = replenish;
         }
 
+        // The roles a person holds are the approval lanes their permissions allow (Owner includes Pricing manager, which includes Store manager).
+        private bool CanActAs(string lane) => ApprovalLanes.CanApprove(User.Claims.Select(c => c.Type), lane);
+
         private int CurrentUserId() => Convert.ToInt32(User.FindFirstValue(ClaimTypes.Sid));
 
         public class AiSwitchDTO { public bool Enabled { get; set; } }
         public class AiRunFinishDTO { public bool Ok { get; set; } = true; public string Summary { get; set; } }

+++ b/Retailo.Tests/HubMetricsTests.cs
@@ -0,0 +1,169 @@
+using GoPosify.Models;
+using GoPosify.Services;
+using Microsoft.EntityFrameworkCore;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class HubMathTests
+{
+    [Fact]
+    public void Turnover_and_days_of_stock_come_from_cost_of_sales_and_stock_value()
+    {
+        Assert.Equal(2.5m, HubMath.Turnover(250m, 100m));
+        Assert.Null(HubMath.Turnover(250m, 0m));
+        // 100 pesos of stock, 50 pesos of cost sold in half a day = 100 a day: one day of stock.
+        Assert.Equal(1.0m, HubMath.DaysOfStock(50m, 100m, 0.5));
+        Assert.Null(HubMath.DaysOfStock(0m, 100m, 1));
+    }
+
+    [Fact]
+    public void Margin_and_shrinkage_percentages_handle_empty_periods()
+    {
+        Assert.Equal(25.0m, HubMath.MarginPct(200m, 150m));
+        Assert.Null(HubMath.MarginPct(0m, 0m));
+        Assert.Equal(4.00m, HubMath.ShrinkPct(8m, 200m));
+        Assert.Null(HubMath.ShrinkPct(8m, 0m));
+    }
+
+    [Fact]
+    public void Found_stock_offsets_lost_stock_but_never_reduces_shrinkage_below_the_write_offs()
+    {
+        Assert.Equal(15m, HubMath.Shrinkage(10m, 8m, 3m));      // 10 written off + 5 net lost
+        Assert.Equal(10m, HubMath.Shrinkage(10m, 2m, 9m));      // more found than lost: only the write-offs
+    }
+
+    [Fact]
+    public void Periods_cover_the_expected_days()
+    {
+        var now = new DateTime(2026, 10, 20, 15, 0, 0);
+        Assert.Equal((new DateTime(2026, 10, 20), new DateTime(2026, 10, 21)), HubPeriods.Range("today", now));
+        Assert.Equal((new DateTime(2026, 10, 19), new DateTime(2026, 10, 20)), HubPeriods.Range("yesterday", now));
+        Assert.Equal((new DateTime(2026, 10, 14), new DateTime(2026, 10, 21)), HubPeriods.Range("7d", now));
+        Assert.Equal((new DateTime(2026, 10, 1), new DateTime(2026, 10, 21)), HubPeriods.Range("month", now));
+        Assert.Equal(0.625, HubPeriods.ElapsedDays(new DateTime(2026, 10, 20), new DateTime(2026, 10, 21), now));   // 15 hours of the day
+    }
+}
+
+public class HubMetricsServiceTests
+{
+    private static readonly DateTime Now = new(2026, 10, 20, 12, 0, 0);
+
+    private sealed class World
+    {
+        public TestAppDbContext Db;
+        public HubMetricsService Svc;
+        public Warehouse Branch;
+        public Category Fresh, Dry;
+        public Product Milk, Rice;
+    }
+
+    private static async Task<World> CreateAsync()
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        var branch = new Warehouse { WarehouseName = "Main", Email = "m@x.test", Phone = "1", Address = "a" };
+        db.Warehouses.Add(branch);
+        var fresh = new Category { CategoryName = "Fresh" };
+        var dry = new Category { CategoryName = "Dry" };
+        db.Categories.AddRange(fresh, dry);
+        await db.SaveChangesAsync();
+        var milk = PricingFixtures.NewProduct(price: 100m, cost: 60m, monitorExpiry: true);
+        milk.CategoryId = fresh.Id;
+        var rice = PricingFixtures.NewProduct(price: 50m, cost: 40m, monitorExpiry: false);
+        rice.CategoryId = dry.Id;
+        db.Products.AddRange(milk, rice);
+        await db.SaveChangesAsync();
+        return new World { Db = db, Svc = new HubMetricsService(db), Branch = branch, Fresh = fresh, Dry = dry, Milk = milk, Rice = rice };
+    }
+
+    private static void Ledger(World w, string type, Product p, decimal qtyIn, decimal qtyOut, decimal? cost, DateTime when) =>
+        w.Db.InventoryTransactions.Add(new InventoryTransaction { TransactionType = type, WarehouseId = w.Branch.Id, ProductId = p.Id, QtyIn = qtyIn, QtyOut = qtyOut, UnitCost = cost, TransactionDate = when });
+
+    private static async Task AddSaleAsync(World w, Product p, decimal qty, decimal price, DateTime when)
+    {
+        var sale = new Sale { WarehouseId = w.Branch.Id, SaleDate = when, TotalAmount = qty * price, PaymentMethod = "Cash" };
+        w.Db.Sales.Add(sale);
+        await w.Db.SaveChangesAsync();
+        w.Db.SaleDetails.Add(new SaleDetail { SaleId = sale.Id, ProductId = p.Id, Quantity = qty, Price = price, SalePrice = price, Amount = qty * price });
+    }
+
+    [Fact]
+    public async Task Sales_cost_margin_turnover_and_shrinkage_are_worked_out_per_branch()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await AddSaleAsync(w, w.Milk, 10, 100m, Now.AddHours(-2));       // 1000 of milk
+        await AddSaleAsync(w, w.Rice, 20, 50m, Now.AddHours(-1));        // 1000 of rice
+        Ledger(w, "SALE_OUT", w.Milk, 0, 10, 60m, Now.AddHours(-2));     // cost 600
+        Ledger(w, "SALE_OUT", w.Rice, 0, 20, 40m, Now.AddHours(-1));     // cost 800
+        Ledger(w, ExpiryTransactionTypes.WriteOff, w.Milk, 0, 2, 60m, Now.AddHours(-3));   // 120 written off
+        Ledger(w, "ADJUSTMENT_OUT", w.Rice, 0, 5, 40m, Now.AddHours(-3));                  // 200 lost
+        Ledger(w, "ADJUSTMENT_IN", w.Rice, 3, 0, 40m, Now.AddHours(-3));                   // 120 found
+        Ledger(w, "SALE_OUT", w.Rice, 0, 99, 40m, Now.AddDays(-5));                        // outside today
+        w.Db.ProductWarehouses.Add(new ProductWarehouse { WarehouseId = w.Branch.Id, ProductId = w.Milk.Id, Quantity = 10 });   // 600 of stock
+        w.Db.ProductWarehouses.Add(new ProductWarehouse { WarehouseId = w.Branch.Id, ProductId = w.Rice.Id, Quantity = 10 });   // 400 of stock
+        await w.Db.SaveChangesAsync();
+
+        var m = await w.Svc.GetAsync("today", null, Now);
+        var row = Assert.Single(m.Branches);
+        Assert.Equal(2000m, row.Sales);
+        Assert.Equal(2, row.Transactions);
+        Assert.Equal(1400m, row.Cogs);
+        Assert.Equal(600m, row.Margin);
+        Assert.Equal(30.0m, row.MarginPct);
+        Assert.Equal(1000m, row.InventoryValue);
+        Assert.Equal(1.4m, row.Turnover);
+        Assert.Equal(120m, row.WrittenOff);
+        Assert.Equal(200m, row.Shrinkage);              // 120 write-off + (200 lost - 120 found)
+        Assert.Equal(2000m, m.Totals.Sales);
+    }
+
+    [Fact]
+    public async Task A_category_limits_sales_cost_stock_and_shrinkage_to_that_category()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await AddSaleAsync(w, w.Milk, 10, 100m, Now.AddHours(-2));
+        await AddSaleAsync(w, w.Rice, 20, 50m, Now.AddHours(-1));
+        Ledger(w, "SALE_OUT", w.Milk, 0, 10, 60m, Now.AddHours(-2));
+        Ledger(w, "SALE_OUT", w.Rice, 0, 20, 40m, Now.AddHours(-1));
+        w.Db.ProductWarehouses.Add(new ProductWarehouse { WarehouseId = w.Branch.Id, ProductId = w.Milk.Id, Quantity = 10 });
+        w.Db.ProductWarehouses.Add(new ProductWarehouse { WarehouseId = w.Branch.Id, ProductId = w.Rice.Id, Quantity = 10 });
+        await w.Db.SaveChangesAsync();
+
+        var fresh = (await w.Svc.GetAsync("today", w.Fresh.Id, Now)).Branches.Single();
+        Assert.Equal(1000m, fresh.Sales);
+        Assert.Equal(600m, fresh.Cogs);
+        Assert.Equal(600m, fresh.InventoryValue);

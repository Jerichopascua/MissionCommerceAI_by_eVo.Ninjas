@@ -0,0 +1,86 @@
+using Microsoft.EntityFrameworkCore;
+using System.ComponentModel.DataAnnotations;
+
+namespace GoPosify.Models;
+
+// The company's own settings for one hub rule. No row means the rule's defaults.
+[Index(nameof(TenantID), nameof(RuleKey), IsUnique = true, Name = "UX_HubRules_Tenant_Rule")]
+public partial class HubRule
+{
+    [Key]
+    public int Id { get; set; }
+
+    public int TenantID { get; set; }
+
+    [Required]
+    [StringLength(40)]
+    public string RuleKey { get; set; }
+
+    public bool Enabled { get; set; } = true;
+
+    [System.ComponentModel.DataAnnotations.Schema.Column(TypeName = "decimal(18, 2)")]
+    public decimal Threshold { get; set; }
+
+    // Who is responsible: one of the approval lanes (Store manager, Pricing manager, Owner).
+    [Required]
+    [StringLength(20)]
+    public string Role { get; set; }
+
+    // "Act" (needs a decision or action) or "Watch" (keep an eye on it).
+    [Required]
+    [StringLength(10)]
+    public string Severity { get; set; }
+
+    // Also email the people in that role when a new alert opens (only if the company has set up its mail server).
+    public bool NotifyEmail { get; set; }
+
+    public int? UpdatedByUserId { get; set; }
+
+    public DateTime UpdatedAt { get; set; }
+}
+
+// An alert is a rule that is breached right now, for one branch (or the whole company). It stays open while the breach lasts,
+// closes by itself when the numbers recover, and can be acknowledged by a person in the responsible role.
+[Index(nameof(TenantID), nameof(ResolvedAt), Name = "IX_HubAlerts_Tenant_Resolved")]
+public partial class HubAlert
+{
+    [Key]
+    public int Id { get; set; }
+
+    public int TenantID { get; set; }
+
+    [Required]
+    [StringLength(40)]
+    public string RuleKey { get; set; }
+
+    public int? WarehouseId { get; set; }
+
+    [System.ComponentModel.DataAnnotations.Schema.Column(TypeName = "decimal(18, 2)")]
+    public decimal Value { get; set; }
+
+    [System.ComponentModel.DataAnnotations.Schema.Column(TypeName = "decimal(18, 2)")]
+    public decimal Threshold { get; set; }
+
+    [StringLength(400)]
+    public string Message { get; set; }
+
+    [Required]
+    [StringLength(20)]
+    public string Role { get; set; }
+
+    [Required]
+    [StringLength(10)]
+    public string Severity { get; set; }
+
+    public DateTime OpenedAt { get; set; }
+
+    public DateTime? ResolvedAt { get; set; }
+
+    public int? AcknowledgedByUserId { get; set; }
+
+    public DateTime? AcknowledgedAt { get; set; }
+
+    public DateTime? EmailedAt { get; set; }
+
+    public DateTime UpdatedAt { get; set; }
+}

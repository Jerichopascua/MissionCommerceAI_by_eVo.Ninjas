+++ b/Services/HubTaskService.cs
@@ -0,0 +1,108 @@
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public sealed class HubTask
+{
+    public string Kind { get; set; }          // Approval, Alert or Reorder
+    public string Key { get; set; }           // approval-12, alert-5, reorder-9
+    public long Id { get; set; }
+    public string Title { get; set; }
+    public string Detail { get; set; }
+    public string Branch { get; set; }
+    public string Role { get; set; }          // the approval lane that is responsible
+    public string Severity { get; set; }      // Act or Watch
+    public DateTime OpenedAt { get; set; }
+    public string Link { get; set; }          // the screen that handles it ("" when it is handled in place)
+    public bool Acknowledged { get; set; }
+}
+
+public sealed class HubTasks
+{
+    public int Total { get; set; }
+    public int Act { get; set; }
+    public int Approvals { get; set; }
+    public int Alerts { get; set; }
+    public int Reorders { get; set; }
+    public List<HubTask> Items { get; set; } = new();
+}
+
+public interface IHubTaskService
+{
+    // Everything waiting for the signed-in person, by the roles (approval lanes) they hold.
+    Task<HubTasks> MineAsync(DateTime now, Func<string, bool> canActAs);
+}
+
+public sealed class HubTaskService : IHubTaskService
+{
+    private readonly AppDBContext _db;
+    private readonly IApprovalQueueService _queue;
+    private readonly IReplenishService _replenish;
+
+    public HubTaskService(AppDBContext db, IApprovalQueueService queue, IReplenishService replenish)
+    {
+        _db = db;
+        _queue = queue;
+        _replenish = replenish;
+    }
+
+    private static string LinkFor(string ruleKey) => ruleKey switch
+    {
+        "ExpiredUnwritten" or "ExpiryAtRisk" => "/inventory/nearexpiry",
+        "ApprovalsWaiting" => "/pricing/approvals",
+        _ => ""
+    };
+
+    public async Task<HubTasks> MineAsync(DateTime now, Func<string, bool> canActAs)
+    {
+        var items = new List<HubTask>();
+
+        var queue = await _queue.BuildAsync(now, canActAs);
+        foreach (var a in queue.Items.Where(i => i.CanApprove))
+        {
+            items.Add(new HubTask
+            {
+                Kind = "Approval", Key = "approval-" + a.Id, Id = a.Id, Title = $"{a.Name}: {a.From:0.##} to {a.To:0.##} ({a.Type.ToLowerInvariant()} change)",
+                Detail = $"{a.Lane} lane, {a.Confidence}", Branch = a.Scope, Role = a.Lane, Severity = HubRuleCatalog.Act,
+                OpenedAt = now.AddMinutes(-a.AgeMinutes), Link = "/pricing/approvals"
+            });
+        }
+
+        var branches = await _db.Warehouses.AsNoTracking().ToDictionaryAsync(w => w.Id, w => w.WarehouseName);
+        foreach (var al in await _db.HubAlerts.AsNoTracking().Where(a => a.ResolvedAt == null).ToListAsync())
+        {
+            if (!canActAs(al.Role)) continue;
+            items.Add(new HubTask
+            {
+                Kind = "Alert", Key = "alert-" + al.Id, Id = al.Id, Title = al.Message, Detail = $"{al.Severity} for the {al.Role.ToLowerInvariant()}",
+                Branch = al.WarehouseId.HasValue && branches.TryGetValue(al.WarehouseId.Value, out var n) ? n : "Whole company",
+                Role = al.Role, Severity = al.Severity, OpenedAt = al.OpenedAt, Link = LinkFor(al.RuleKey), Acknowledged = al.AcknowledgedAt.HasValue
+            });
+        }
+
+        if (canActAs(ApprovalLanes.Store))
+        {
+            foreach (var r in await _replenish.ListAsync(ReplenishStatus.Open, 50))
+            {
+                items.Add(new HubTask
+                {
+                    Kind = "Reorder", Key = "reorder-" + r.Id, Id = r.Id,
+                    Title = $"Reorder {r.SuggestedQty:0.##} of {r.Product}",
+                    Detail = $"{r.DaysOfCover:0.#} days of cover left, sells about {r.RatePerDay:0.##} a day, about ₱{r.Cost:N0}",
+                    Branch = r.Branch, Role = ApprovalLanes.Store,
+                    Severity = r.DaysOfCover <= r.LeadTimeDays ? HubRuleCatalog.Act : HubRuleCatalog.Watch,
+                    OpenedAt = r.CreatedAt, Link = ""
+                });
+            }
+        }
+
+        items = items.OrderBy(i => i.Severity == HubRuleCatalog.Act ? 0 : 1).ThenBy(i => i.OpenedAt).ToList();
+        return new HubTasks
+        {
+            Items = items, Total = items.Count, Act = items.Count(i => i.Severity == HubRuleCatalog.Act),
+            Approvals = items.Count(i => i.Kind == "Approval"), Alerts = items.Count(i => i.Kind == "Alert"), Reorders = items.Count(i => i.Kind == "Reorder")
+        };
+    }
+}
diff --git a/Services/ReplenishService.cs b/Services/ReplenishService.cs
new file mode 100644
index 0000000..2428393
--- /dev/null
+++ b/Services/ReplenishService.cs
@@ -0,0 +1,118 @@
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public sealed class ReplenishInput
+{
+    public int WarehouseId { get; set; }
+    public int ProductId { get; set; }
+    public decimal OnHand { get; set; }
+    public decimal RatePerDay { get; set; }
+    public decimal DaysOfCover { get; set; }
+    public decimal ReorderPoint { get; set; }
+    public decimal SuggestedQty { get; set; }
+    public decimal UnitCost { get; set; }
+    public int LeadTimeDays { get; set; }
+    public int CoverDays { get; set; }
+    public string Confidence { get; set; }
+    public string Reason { get; set; }
+}
+
+public sealed class ReplenishRow
+{
+    public int Id { get; set; }
+    public int WarehouseId { get; set; }
+    public string Branch { get; set; }
+    public int ProductId { get; set; }
+    public string Product { get; set; }
+    public decimal OnHand { get; set; }
+    public decimal RatePerDay { get; set; }
+    public decimal DaysOfCover { get; set; }
+    public decimal ReorderPoint { get; set; }
+    public decimal SuggestedQty { get; set; }
+    public decimal UnitCost { get; set; }
+    public decimal Cost { get; set; }
+    public int LeadTimeDays { get; set; }
+    public int CoverDays { get; set; }
+    public string Confidence { get; set; }
+    public string Reason { get; set; }
+    public string Status { get; set; }
+    public DateTime CreatedAt { get; set; }
+}
+
+public interface IReplenishService
+{
+    // Replaces the open suggestions for the branches a run covered with the run's new ones.
+    Task<int> ReplaceOpenAsync(IReadOnlyCollection<int> coveredWarehouseIds, IReadOnlyCollection<ReplenishInput> items, DateTime now);
+    Task<List<ReplenishRow>> ListAsync(string status, int take);
+    Task<(bool Ok, string Message)> DecideAsync(int id, string decision, int userId, DateTime now);
+}
+
+public sealed class ReplenishService : IReplenishService
+{
+    private readonly AppDBContext _db;
+
+    public ReplenishService(AppDBContext db) => _db = db;
+
+    public async Task<int> ReplaceOpenAsync(IReadOnlyCollection<int> coveredWarehouseIds, IReadOnlyCollection<ReplenishInput> items, DateTime now)
+    {
+        var covered = coveredWarehouseIds.ToHashSet();
+        foreach (var w in items.Select(i => i.WarehouseId)) covered.Add(w);
+        var open = await _db.ReplenishSuggestions.Where(s => s.Status == ReplenishStatus.Open && covered.Contains(s.WarehouseId)).ToListAsync();
+        foreach (var s in open) { s.Status = ReplenishStatus.Superseded; s.UpdatedAt = now; }
+
+        // Only products and branches that exist for this company, and only sensible numbers.
+        var warehouseIds = (await _db.Warehouses.AsNoTracking().Select(w => w.Id).ToListAsync()).ToHashSet();
+        var productIds = (await _db.Products.AsNoTracking().Select(p => p.Id).ToListAsync()).ToHashSet();
+        var added = 0;
+        foreach (var i in items)
+        {
+            if (!warehouseIds.Contains(i.WarehouseId) || !productIds.Contains(i.ProductId) || i.SuggestedQty <= 0m) continue;
+            _db.ReplenishSuggestions.Add(new ReplenishSuggestion
+            {
+                WarehouseId = i.WarehouseId, ProductId = i.ProductId, OnHand = i.OnHand, RatePerDay = i.RatePerDay, DaysOfCover = i.DaysOfCover,
+                ReorderPoint = i.ReorderPoint, SuggestedQty = i.SuggestedQty, UnitCost = i.UnitCost, LeadTimeDays = i.LeadTimeDays, CoverDays = i.CoverDays,
+                Confidence = i.Confidence == null ? null : (i.Confidence.Length > 12 ? i.Confidence[..12] : i.Confidence),
+                Reason = i.Reason != null && i.Reason.Length > 400 ? i.Reason[..400] : i.Reason,
+                Status = ReplenishStatus.Open, CreatedAt = now
+            });
+            added++;
+        }
+        await _db.SaveChangesAsync();
+        return added;
+    }
+
+    public async Task<List<ReplenishRow>> ListAsync(string status, int take)
+    {
+        status = string.IsNullOrWhiteSpace(status) ? ReplenishStatus.Open : status;
+        var rows = await (from s in _db.ReplenishSuggestions.AsNoTracking()
+                          join p in _db.Products.AsNoTracking() on s.ProductId equals p.Id
+                          join w in _db.Warehouses.AsNoTracking() on s.WarehouseId equals w.Id
+                          where s.Status == status
+                          orderby s.DaysOfCover, s.Id
+                          select new { s, Product = p.ProductName, Branch = w.WarehouseName }).Take(Math.Clamp(take, 1, 500)).ToListAsync();
+        return rows.Select(r => new ReplenishRow
+        {
+            Id = r.s.Id, WarehouseId = r.s.WarehouseId, Branch = r.Branch, ProductId = r.s.ProductId, Product = r.Product,
+            OnHand = r.s.OnHand, RatePerDay = r.s.RatePerDay, DaysOfCover = r.s.DaysOfCover, ReorderPoint = r.s.ReorderPoint,
+            SuggestedQty = r.s.SuggestedQty, UnitCost = r.s.UnitCost, Cost = Math.Round(r.s.SuggestedQty * r.s.UnitCost, 2),
+            LeadTimeDays = r.s.LeadTimeDays, CoverDays = r.s.CoverDays, Confidence = r.s.Confidence, Reason = r.s.Reason,
+            Status = r.s.Status, CreatedAt = r.s.CreatedAt
+        }).ToList();
+    }
+
+    public async Task<(bool Ok, string Message)> DecideAsync(int id, string decision, int userId, DateTime now)
+    {
+        if (decision != ReplenishStatus.Ordered && decision != ReplenishStatus.Dismissed) return (false, "The decision must be Ordered or Dismissed.");
+        var s = await _db.ReplenishSuggestions.FirstOrDefaultAsync(x => x.Id == id);
+        if (s == null) return (false, "Unknown suggestion.");
+        if (s.Status != ReplenishStatus.Open) return (false, $"That suggestion is already {s.Status}.");
+        s.Status = decision;
+        s.DecidedByUserId = userId;
+        s.DecidedAt = now;
+        await _db.SaveChangesAsync();
+        return (true, null);
+    }
+}

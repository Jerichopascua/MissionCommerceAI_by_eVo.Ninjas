+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public static class HubPeriods
+{
+    public static readonly string[] All = { "today", "yesterday", "7d", "30d", "month" };
+
+    // [From, To) in the company's local time. The periods that include today are cut at now when computing a daily rate.
+    public static (DateTime From, DateTime To) Range(string period, DateTime now)
+    {
+        var today = now.Date;
+        return period switch
+        {
+            "yesterday" => (today.AddDays(-1), today),
+            "7d" => (today.AddDays(-6), today.AddDays(1)),
+            "30d" => (today.AddDays(-29), today.AddDays(1)),
+            "month" => (new DateTime(today.Year, today.Month, 1), today.AddDays(1)),
+            _ => (today, today.AddDays(1))
+        };
+    }
+
+    public static double ElapsedDays(DateTime from, DateTime to, DateTime now)
+    {
+        var end = to < now ? to : now;
+        return Math.Max(1d / 24d, (end - from).TotalDays);
+    }
+}
+
+// What the ratios mean, kept in one place so the screen, the rules and the tests agree.
+public static class HubMath
+{
+    // Times the stock on the shelf was sold through in the period: cost of goods sold over the stock value now.
+    public static decimal? Turnover(decimal cogs, decimal inventoryValue) => inventoryValue > 0m ? Math.Round(cogs / inventoryValue, 2) : null;
+
+    // How many days the stock on hand would last at the period's rate of sale.
+    public static decimal? DaysOfStock(decimal cogs, decimal inventoryValue, double elapsedDays)
+        => cogs > 0m ? Math.Round(inventoryValue / (cogs / (decimal)elapsedDays), 1) : null;
+
+    public static decimal? MarginPct(decimal sales, decimal cogs) => sales > 0m ? Math.Round((sales - cogs) / sales * 100m, 1) : null;
+
+    // Shrinkage as a share of the cost of goods sold.
+    public static decimal? ShrinkPct(decimal shrink, decimal cogs) => cogs > 0m ? Math.Round(shrink / cogs * 100m, 2) : null;
+
+    // Shrinkage = expired stock written off + stock lost to adjustments and stock counts (found stock offsets lost stock, never below zero).
+    public static decimal Shrinkage(decimal writeOff, decimal adjustmentOutValue, decimal adjustmentInValue)
+        => writeOff + Math.Max(0m, adjustmentOutValue - adjustmentInValue);
+}
+
+public class HubMetricsRow
+{
+    public int WarehouseId { get; set; }
+    public string Name { get; set; }
+    public decimal Sales { get; set; }
+    public int Transactions { get; set; }
+    public decimal Cogs { get; set; }
+    public decimal Margin { get; set; }
+    public decimal? MarginPct { get; set; }
+    public decimal InventoryValue { get; set; }
+    public decimal? Turnover { get; set; }
+    public decimal? DaysOfStock { get; set; }
+    public decimal Shrinkage { get; set; }
+    public decimal? ShrinkagePct { get; set; }
+    public decimal WrittenOff { get; set; }
+    public decimal ExpiryAtRisk { get; set; }
+    public decimal ExpiredUnwritten { get; set; }
+    public decimal CashVariance { get; set; }       // company-wide, not by category
+    public int ActiveMarkdowns { get; set; }        // company-wide, not by category
+    public int OpenExceptions { get; set; }         // company-wide, not by category
+}
+
+public class HubMetrics
+{
+    public string Period { get; set; }
+    public DateTime From { get; set; }
+    public DateTime To { get; set; }
+    public double ElapsedDays { get; set; }
+    public int? CategoryId { get; set; }
+    public string CompanyName { get; set; }
+    public DateTime GeneratedAt { get; set; }
+    public HubMetricsRow Totals { get; set; }
+    public List<HubMetricsRow> Branches { get; set; } = new();
+}
+
+public interface IHubMetricsService
+{
+    Task<HubMetrics> GetAsync(string period, int? categoryId, DateTime now);
+}
+
+// The company's operations for a period, by branch, optionally for one category. Read only; uses the normal tenant filter.
+public sealed class HubMetricsService : IHubMetricsService
+{
+    private readonly AppDBContext _db;
+
+    public HubMetricsService(AppDBContext db) => _db = db;
+
+    private sealed record Flow(int WarehouseId, string Type, decimal InValue, decimal OutValue);
+
+    public async Task<HubMetrics> GetAsync(string period, int? categoryId, DateTime now)
+    {
+        period = HubPeriods.All.Contains(period) ? period : "today";
+        var (periodFrom, periodTo) = HubPeriods.Range(period, now);
+        var elapsed = HubPeriods.ElapsedDays(periodFrom, periodTo, now);
+        var today = now.Date;
+
+        var warehouses = await _db.Warehouses.AsNoTracking().OrderBy(w => w.Id).Select(w => new { w.Id, w.WarehouseName }).ToListAsync();
+
+        // Sales: the sale totals, or the line amounts when a category is chosen.
+        var sales = new Dictionary<int, (decimal Total, int Count)>();
+        if (categoryId == null)
+        {
+            foreach (var r in await _db.Sales.AsNoTracking().Where(s => s.SaleDate >= periodFrom && s.SaleDate < periodTo)
+                         .GroupBy(s => s.WarehouseId).Select(g => new { g.Key, Total = g.Sum(s => s.TotalAmount), Count = g.Count() }).ToListAsync())
+                sales[r.Key] = (r.Total, r.Count);
+        }
+        else
+        {
+            foreach (var r in await _db.SaleDetails.AsNoTracking()
+                         .Where(d => d.Sale.SaleDate >= periodFrom && d.Sale.SaleDate < periodTo && d.Product.CategoryId == categoryId)
+                         .GroupBy(d => d.Sale.WarehouseId).Select(g => new { g.Key, Total = g.Sum(d => d.Amount), Count = g.Select(d => d.SaleId).Distinct().Count() }).ToListAsync())
+                sales[r.Key] = (r.Total, r.Count);
+        }
+
+        // Ledger flows valued at the unit cost on the row (the product's cost when the row has none).
+        var flows = await (from t in _db.InventoryTransactions.AsNoTracking()
+                           join p in _db.Products.AsNoTracking() on t.ProductId equals p.Id
+                           where t.TransactionDate >= periodFrom && t.TransactionDate < periodTo && (categoryId == null || p.CategoryId == categoryId)
+                           group new { t, p } by new { t.WarehouseId, t.TransactionType } into g
+                           select new Flow(g.Key.WarehouseId, g.Key.TransactionType,
+                               g.Sum(x => x.t.QtyIn * (x.t.UnitCost ?? x.p.Cost)), g.Sum(x => x.t.QtyOut * (x.t.UnitCost ?? x.p.Cost)))).ToListAsync();
+
+        var inventory = await (from pw in _db.ProductWarehouses.AsNoTracking()
+                               join p in _db.Products.AsNoTracking() on pw.ProductId equals p.Id
+                               where categoryId == null || p.CategoryId == categoryId
+                               group new { pw, p } by pw.WarehouseId into g
+                               select new { WarehouseId = g.Key, Value = g.Sum(x => x.pw.Quantity * x.p.Cost) }).ToDictionaryAsync(x => x.WarehouseId, x => x.Value);
+
+        var batches = await _db.ProductBatches.AsNoTracking().Include(b => b.Product)
+            .Where(b => b.QtyOnHand > 0 && b.ExpiryDate.HasValue && b.Product.MonitorExpiry && (categoryId == null || b.Product.CategoryId == categoryId)).ToListAsync();
+        var atRisk = new Dictionary<int, decimal>();
+        var expiredUnwritten = new Dictionary<int, decimal>();
+        foreach (var b in batches)
+        {
+            var days = (b.ExpiryDate.Value.Date - today).Days;
+            var alert = b.Product.ExpiryAlertDays > 0 ? b.Product.ExpiryAlertDays : 30;
+            var pesos = b.QtyOnHand * (b.Cost ?? b.Product.Cost);
+            if (days < 0) expiredUnwritten[b.WarehouseId] = expiredUnwritten.GetValueOrDefault(b.WarehouseId) + pesos;
+            else if (days <= alert) atRisk[b.WarehouseId] = atRisk.GetValueOrDefault(b.WarehouseId) + pesos;
+        }
+
+        var cash = await _db.CashShifts.AsNoTracking().Where(s => s.Status == CashShiftStatus.Closed && s.ClosedAt >= periodFrom && s.ClosedAt < periodTo)
+            .GroupBy(s => s.WarehouseId).Select(g => new { g.Key, Total = g.Sum(s => s.Variance ?? 0m) }).ToDictionaryAsync(x => x.Key, x => x.Total);
+        var markdowns = await _db.ActiveMarkdowns.AsNoTracking().Where(m => m.IsActive)
+            .GroupBy(m => m.WarehouseId).Select(g => new { g.Key, N = g.Count() }).ToDictionaryAsync(x => x.Key, x => x.N);
+        var exceptions = await _db.ExceptionRecords.AsNoTracking().Where(e => e.Status == ExceptionStatus.Open && e.WarehouseId != null)
+            .GroupBy(e => e.WarehouseId).Select(g => new { g.Key, N = g.Count() }).ToDictionaryAsync(x => x.Key.Value, x => x.N);
+
+        decimal Out(int wh, string type) => flows.Where(f => f.WarehouseId == wh && f.Type == type).Sum(f => f.OutValue);
+        decimal In(int wh, string type) => flows.Where(f => f.WarehouseId == wh && f.Type == type).Sum(f => f.InValue);
+
+        var result = new HubMetrics { Period = period, From = periodFrom, To = periodTo, ElapsedDays = Math.Round(elapsed, 3), CategoryId = categoryId, GeneratedAt = now,
+            CompanyName = await _db.AppSettings.AsNoTracking().Select(a => a.CompanyName).FirstOrDefaultAsync() };
+        foreach (var w in warehouses)
+        {
+            sales.TryGetValue(w.Id, out var s);
+            var cogs = Out(w.Id, "SALE_OUT") - In(w.Id, "SALE_RETURN_IN");
+            var writeOff = Out(w.Id, ExpiryTransactionTypes.WriteOff);
+            var adjOut = Out(w.Id, "ADJUSTMENT_OUT") + Out(w.Id, "STOCK_COUNT_ADJ");
+            var adjIn = In(w.Id, "ADJUSTMENT_IN") + In(w.Id, "STOCK_COUNT_ADJ");
+            result.Branches.Add(Build(w.Id, w.WarehouseName, s.Total, s.Count, cogs, inventory.GetValueOrDefault(w.Id), HubMath.Shrinkage(writeOff, adjOut, adjIn), writeOff,
+                atRisk.GetValueOrDefault(w.Id), expiredUnwritten.GetValueOrDefault(w.Id), cash.GetValueOrDefault(w.Id), markdowns.GetValueOrDefault(w.Id), exceptions.GetValueOrDefault(w.Id), elapsed));
+        }
+
+        var rows = result.Branches;
+        result.Totals = Build(0, "All branches", rows.Sum(r => r.Sales), rows.Sum(r => r.Transactions), rows.Sum(r => r.Cogs), rows.Sum(r => r.InventoryValue), rows.Sum(r => r.Shrinkage), rows.Sum(r => r.WrittenOff),
+            rows.Sum(r => r.ExpiryAtRisk), rows.Sum(r => r.ExpiredUnwritten), rows.Sum(r => r.CashVariance), rows.Sum(r => r.ActiveMarkdowns), rows.Sum(r => r.OpenExceptions), elapsed);
+        return result;
+    }
+
+    private static HubMetricsRow Build(int id, string name, decimal sales, int txns, decimal cogs, decimal inv, decimal shrink, decimal writeOff,
+        decimal atRisk, decimal expired, decimal cash, int markdowns, int exceptions, double elapsed) => new()
+    {
+        WarehouseId = id, Name = name, Sales = sales, Transactions = txns, Cogs = cogs, Margin = sales - cogs, MarginPct = HubMath.MarginPct(sales, cogs),
+        InventoryValue = inv, Turnover = HubMath.Turnover(cogs, inv), DaysOfStock = HubMath.DaysOfStock(cogs, inv, elapsed),
+        Shrinkage = shrink, ShrinkagePct = HubMath.ShrinkPct(shrink, cogs), WrittenOff = writeOff, ExpiryAtRisk = atRisk, ExpiredUnwritten = expired,
+        CashVariance = cash, ActiveMarkdowns = markdowns, OpenExceptions = exceptions
+    };
+}
diff --git a/Services/HubRuleService.cs b/Services/HubRuleService.cs
new file mode 100644
index 0000000..3e4becd
--- /dev/null
+++ b/Services/HubRuleService.cs
@@ -0,0 +1,257 @@
+using System.Globalization;
+using System.Net.Mail;
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public sealed class HubRuleDef
+{
+    public string Key { get; init; }
+    public string Name { get; init; }
+    public string Description { get; init; }
+    public string Unit { get; init; }                 // peso, %, days, count
+    public decimal DefaultThreshold { get; init; }
+    public string Comparison { get; init; }           // ">" the rule is breached above the threshold, "<" below it
+    public string DefaultRole { get; init; }
+    public string DefaultSeverity { get; init; }
+    public string Period { get; init; }               // the hub period the number is measured over
+    public bool CompanyLevel { get; init; }           // one check for the company instead of one per branch
+}
+
+public static class HubRuleCatalog
+{
+    public const string Act = "Act";
+    public const string Watch = "Watch";
+    public static readonly string[] Severities = { Act, Watch };
+    public static readonly string[] Roles = { ApprovalLanes.Store, ApprovalLanes.Pricing, ApprovalLanes.Owner };
+
+    public static readonly HubRuleDef[] All =
+    {
+        new() { Key = "ExpiredUnwritten", Name = "Expired stock not written off", Description = "Stock past its date that is still on the books, at cost.", Unit = "peso", DefaultThreshold = 0m, Comparison = ">", DefaultRole = ApprovalLanes.Store, DefaultSeverity = Act, Period = "today" },
+        new() { Key = "ExpiryAtRisk", Name = "Stock close to expiry", Description = "Value, at cost, of stock inside its expiry alert window.", Unit = "peso", DefaultThreshold = 1000m, Comparison = ">", DefaultRole = ApprovalLanes.Store, DefaultSeverity = Watch, Period = "today" },
+        new() { Key = "CashVariance", Name = "Cash shift closed with a difference", Description = "The difference between counted and expected cash on shifts closed today, either way.", Unit = "peso", DefaultThreshold = 0m, Comparison = ">", DefaultRole = ApprovalLanes.Owner, DefaultSeverity = Act, Period = "today" },
+        new() { Key = "NegativeMargin", Name = "Selling below cost", Description = "Gross margin over the last 7 days is below the limit (a limit of 0 flags a loss).", Unit = "%", DefaultThreshold = 0m, Comparison = "<", DefaultRole = ApprovalLanes.Pricing, DefaultSeverity = Act, Period = "7d" },
+        new() { Key = "Shrinkage", Name = "Shrinkage above the limit", Description = "Write-offs and stock lost to adjustments and counts, as a share of cost of sales, last 7 days.", Unit = "%", DefaultThreshold = 2m, Comparison = ">", DefaultRole = ApprovalLanes.Owner, DefaultSeverity = Act, Period = "7d" },
+        new() { Key = "DaysOfStock", Name = "Too much stock", Description = "Days of stock on hand at the last 30 days' rate of sale.", Unit = "days", DefaultThreshold = 45m, Comparison = ">", DefaultRole = ApprovalLanes.Pricing, DefaultSeverity = Watch, Period = "30d" },
+        new() { Key = "OpenExceptions", Name = "Open exceptions", Description = "Exceptions raised for the branch that nobody has closed.", Unit = "count", DefaultThreshold = 0m, Comparison = ">", DefaultRole = ApprovalLanes.Store, DefaultSeverity = Act, Period = "today" },
+        new() { Key = "ApprovalsWaiting", Name = "AI proposals waiting for a decision", Description = "Price proposals sitting in the Approval Center.", Unit = "count", DefaultThreshold = 10m, Comparison = ">", DefaultRole = ApprovalLanes.Pricing, DefaultSeverity = Watch, Period = "today", CompanyLevel = true }
+    };
+}
+
+public interface IAlertNotifier
+{
+    Task<bool> SendAsync(IReadOnlyCollection<string> to, string subject, string body);
+}
+
+// Emails through the company's own mail settings (Settings, E-Mail). Does nothing, and says so, if the company has not set up a mail server.
+public sealed class SmtpAlertNotifier : IAlertNotifier
+{
+    private readonly AppDBContext _db;
+
+    public SmtpAlertNotifier(AppDBContext db) => _db = db;
+
+    public async Task<bool> SendAsync(IReadOnlyCollection<string> to, string subject, string body)
+    {
+        var s = await _db.AppSettings.AsNoTracking().FirstOrDefaultAsync();
+        if (s == null || string.IsNullOrWhiteSpace(s.MailHost) || string.IsNullOrWhiteSpace(s.MailUserName) || to.Count == 0) return false;
+        try
+        {
+            using var mail = new MailMessage { From = new MailAddress(s.MailUserName), Subject = subject, Body = body, IsBodyHtml = false };
+            foreach (var t in to) mail.To.Add(t);
+            using var smtp = new SmtpClient(s.MailHost, s.MailPort)
+            {
+                UseDefaultCredentials = false,
+                Credentials = new System.Net.NetworkCredential(s.MailUserName, s.MailPassword),
+                DeliveryMethod = SmtpDeliveryMethod.Network,
+                EnableSsl = true,
+                Timeout = 30000
+            };
+            await smtp.SendMailAsync(mail);
+            return true;
+        }
+        catch
+        {
+            return false;
+        }
+    }
+}
+
+public interface IHubRuleService
+{
+    Task<List<object>> RulesAsync();
+    Task<(bool Ok, string Message)> SaveRuleAsync(string key, bool enabled, decimal threshold, string role, string severity, bool notifyEmail, int userId, DateTime now);
+    // Checks every enabled rule against today's numbers: opens new alerts, updates open ones, closes the ones that recovered.
+    Task<List<HubAlert>> EvaluateAsync(DateTime now);
+    Task<List<HubAlert>> OpenAlertsAsync();
+    Task<(bool Ok, string Message)> AcknowledgeAsync(int alertId, int userId, DateTime now);
+}
+
+public sealed class HubRuleService : IHubRuleService
+{
+    private readonly AppDBContext _db;
+    private readonly IHubMetricsService _metrics;
+    private readonly IAlertNotifier _notifier;
+
+    public HubRuleService(AppDBContext db, IHubMetricsService metrics, IAlertNotifier notifier)
+    {
+        _db = db;
+        _metrics = metrics;
+        _notifier = notifier;
+    }
+
+    private static HubRule Effective(HubRuleDef d, IEnumerable<HubRule> saved) =>
+        saved.FirstOrDefault(r => r.RuleKey == d.Key) ?? new HubRule { RuleKey = d.Key, Enabled = true, Threshold = d.DefaultThreshold, Role = d.DefaultRole, Severity = d.DefaultSeverity };
+
+    public async Task<List<object>> RulesAsync()
+    {
+        var saved = await _db.HubRules.AsNoTracking().ToListAsync();
+        var open = await _db.HubAlerts.AsNoTracking().Where(a => a.ResolvedAt == null).ToListAsync();
+        return HubRuleCatalog.All.Select(d =>
+        {
+            var r = Effective(d, saved);
+            return (object)new
+            {
+                key = d.Key, name = d.Name, description = d.Description, unit = d.Unit, comparison = d.Comparison, period = d.Period, companyLevel = d.CompanyLevel,
+                enabled = r.Enabled, threshold = r.Threshold, role = r.Role, severity = r.Severity, notifyEmail = r.NotifyEmail,
+                explicitlySet = saved.Any(x => x.RuleKey == d.Key), openAlerts = open.Count(a => a.RuleKey == d.Key)
+            };
+        }).ToList();
+    }
+
+    public async Task<(bool Ok, string Message)> SaveRuleAsync(string key, bool enabled, decimal threshold, string role, string severity, bool notifyEmail, int userId, DateTime now)
+    {
+        if (!HubRuleCatalog.All.Any(d => d.Key == key)) return (false, "Unknown rule.");
+        if (!HubRuleCatalog.Roles.Contains(role)) return (false, "The role must be one of: " + string.Join(", ", HubRuleCatalog.Roles) + ".");
+        if (!HubRuleCatalog.Severities.Contains(severity)) return (false, "The severity must be Act or Watch.");
+        if (threshold < -1000000m || threshold > 1000000000m) return (false, "That limit is out of range.");
+        var row = await _db.HubRules.FirstOrDefaultAsync(r => r.RuleKey == key);
+        if (row == null)
+        {
+            row = new HubRule { RuleKey = key };
+            _db.HubRules.Add(row);
+        }
+        row.Enabled = enabled;
+        row.Threshold = threshold;
+        row.Role = role;
+        row.Severity = severity;
+        row.NotifyEmail = notifyEmail;
+        row.UpdatedByUserId = userId;
+        row.UpdatedAt = now;
+        await _db.SaveChangesAsync();
+        return (true, null);
+    }
+
+    private static decimal? Metric(string key, HubMetricsRow r) => key switch
+    {
+        "ExpiredUnwritten" => r.ExpiredUnwritten,
+        "ExpiryAtRisk" => r.ExpiryAtRisk,
+        "CashVariance" => Math.Abs(r.CashVariance),
+        "NegativeMargin" => r.MarginPct,
+        "Shrinkage" => r.ShrinkagePct,
+        "DaysOfStock" => r.DaysOfStock,
+        "OpenExceptions" => r.OpenExceptions,
+        _ => null
+    };
+
+    private static bool Breached(HubRuleDef d, decimal value, decimal threshold) => d.Comparison == ">" ? value > threshold : value < threshold;
+
+    private static string Format(string unit, decimal v) => unit switch
+    {
+        "peso" => "₱" + v.ToString("N0", CultureInfo.InvariantCulture),
+        "%" => v.ToString("0.0", CultureInfo.InvariantCulture) + "%",
+        "days" => v.ToString("0.0", CultureInfo.InvariantCulture) + " days",
+        _ => v.ToString("0", CultureInfo.InvariantCulture)
+    };
+
+    private sealed record Breach(HubRuleDef Def, HubRule Rule, int? WarehouseId, string Where, decimal Value);
+
+    public async Task<List<HubAlert>> EvaluateAsync(DateTime now)
+    {
+        var saved = await _db.HubRules.AsNoTracking().ToListAsync();
+        var byPeriod = new Dictionary<string, HubMetrics>();
+        foreach (var p in HubRuleCatalog.All.Where(d => !d.CompanyLevel).Select(d => d.Period).Distinct())
+            byPeriod[p] = await _metrics.GetAsync(p, null, now);
+
+        var breaches = new List<Breach>();
+        foreach (var d in HubRuleCatalog.All)
+        {
+            var rule = Effective(d, saved);
+            if (!rule.Enabled) continue;
+            if (d.CompanyLevel)
+            {
+                var waiting = await _db.PriceChanges.AsNoTracking().CountAsync(c => c.Status == PriceChangeStatus.PendingApproval);
+                if (Breached(d, waiting, rule.Threshold)) breaches.Add(new Breach(d, rule, null, "the company", waiting));
+                continue;
+            }
+            foreach (var b in byPeriod[d.Period].Branches)
+            {
+                var v = Metric(d.Key, b);
+                if (v.HasValue && Breached(d, v.Value, rule.Threshold)) breaches.Add(new Breach(d, rule, b.WarehouseId, b.Name, v.Value));
+            }
+        }
+
+        var open = await _db.HubAlerts.Where(a => a.ResolvedAt == null).ToListAsync();
+        var created = new List<(HubAlert Alert, HubRule Rule)>();
+        foreach (var b in breaches)
+        {
+            var message = $"{b.Def.Name}: {b.Where} is at {Format(b.Def.Unit, b.Value)} (limit {Format(b.Def.Unit, b.Rule.Threshold)}).";
+            var existing = open.FirstOrDefault(a => a.RuleKey == b.Def.Key && a.WarehouseId == b.WarehouseId);
+            if (existing == null)
+            {
+                var a = new HubAlert { RuleKey = b.Def.Key, WarehouseId = b.WarehouseId, OpenedAt = now };
+                Fill(a, b, message);
+                _db.HubAlerts.Add(a);
+                created.Add((a, b.Rule));
+            }
+            else
+            {
+                Fill(existing, b, message);
+            }
+        }
+        foreach (var a in open.Where(a => !breaches.Any(b => b.Def.Key == a.RuleKey && b.WarehouseId == a.WarehouseId)))
+            a.ResolvedAt = now;
+        await _db.SaveChangesAsync();
+
+        foreach (var (alert, rule) in created.Where(c => c.Rule.NotifyEmail))
+        {
+            var to = await RecipientsAsync(alert.Role);
+            if (to.Count > 0 && await _notifier.SendAsync(to, "Alert: " + alert.Message, alert.Message + "\n\nOpen the Intelligence Hub, My tasks, to see it."))
+                alert.EmailedAt = now;
+        }
+        if (created.Any(c => c.Alert.EmailedAt.HasValue)) await _db.SaveChangesAsync();
+
+        return await OpenAlertsAsync();
+    }
+
+    private static void Fill(HubAlert a, Breach b, string message)
+    {
+        a.Value = b.Value;
+        a.Threshold = b.Rule.Threshold;
+        a.Message = message;
+        a.Role = b.Rule.Role;
+        a.Severity = b.Rule.Severity;
+    }
+
+    private async Task<List<string>> RecipientsAsync(string lane)
+    {
+        var users = await _db.Users.AsNoTracking().Include(u => u.Role).Where(u => u.IsActive && u.Email != null).ToListAsync();
+        return users.Where(u => u.Role != null && ApprovalLanes.CanApprove((u.Role.Permissions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), lane))
+            .Select(u => u.Email).Distinct().ToList();
+    }
+
+    public async Task<List<HubAlert>> OpenAlertsAsync() =>
+        await _db.HubAlerts.AsNoTracking().Where(a => a.ResolvedAt == null).OrderBy(a => a.Severity).ThenBy(a => a.OpenedAt).ToListAsync();
+
+    public async Task<(bool Ok, string Message)> AcknowledgeAsync(int alertId, int userId, DateTime now)
+    {
+        var a = await _db.HubAlerts.FirstOrDefaultAsync(x => x.Id == alertId);
+        if (a == null) return (false, "Unknown alert.");
+        if (a.ResolvedAt != null) return (false, "That alert has already closed on its own.");
+        a.AcknowledgedByUserId = userId;
+        a.AcknowledgedAt = now;
+        await _db.SaveChangesAsync();
+        return (true, null);
+    }
+}
diff --git a/Services/HubTaskService.cs b/Services/HubTaskService.cs

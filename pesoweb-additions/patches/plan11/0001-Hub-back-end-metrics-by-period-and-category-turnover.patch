-        // GET: api/ai/movements?warehouseId=1&type=SALE_OUT&afterId=0&take=1000
+        // GET: api/ai/movements?warehouseId=1&type=SALE_OUT&afterId=0&take=1000&since=2026-10-01
         // Inventory ledger rows (what moved, when, from which batch): the AI learns sell-through from these.
         [HttpGet("~/api/ai/movements")]
         [Authorize(Policy = "AI.Read")]
-        public async Task<IActionResult> Movements(int? warehouseId, string type, long afterId = 0, int take = 1000)
+        public async Task<IActionResult> Movements(int? warehouseId, string type, long afterId = 0, int take = 1000, DateTime? since = null)
         {
             take = Math.Clamp(take, 1, 5000);
             var q = _dbContext.InventoryTransactions.AsNoTracking().Where(t => t.Id > afterId);
             if (warehouseId.HasValue) q = q.Where(t => t.WarehouseId == warehouseId.Value);
             if (!string.IsNullOrWhiteSpace(type)) q = q.Where(t => t.TransactionType == type);
+            if (since.HasValue) q = q.Where(t => t.TransactionDate >= since.Value);
             var rows = await q.OrderBy(t => t.Id).Take(take)
                 .Select(t => new { t.Id, t.TransactionType, t.WarehouseId, t.ProductId, t.BatchId, t.QtyIn, t.QtyOut, t.UnitCost, t.TransactionDate })
                 .ToListAsync();

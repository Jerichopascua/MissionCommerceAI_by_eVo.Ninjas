+        public class ReplenishPostDTO { public List<int> WarehouseIds { get; set; } = new(); public List<ReplenishInput> Items { get; set; } = new(); }
+        public class ReplenishDecisionDTO { public string Decision { get; set; } }
         public class AiBranchDTO { public bool PricingEnabled { get; set; } = true; public int? ClearanceStartHour { get; set; } }
 
         // GET: api/ai/control   (the owner's screen)
@@ -125,6 +140,103 @@ namespace GoPosify.Controllers
             return Ok(await _group.GetAsync(CurrentDateTime(), GetCurrentTenantID()));
         }
 
+        // GET: api/ai/hub/metrics?period=7d&categoryId=12   (the Intelligence Hub overview: period and category aware, by branch)
+        [HttpGet("~/api/ai/hub/metrics")]
+        [Authorize(Policy = "AI.Control")]
+        public async Task<IActionResult> HubMetrics(string period = "today", int? categoryId = null)
+        {
+            if (!HubPeriods.All.Contains(period)) return BadRequest(new { message = "period must be one of: " + string.Join(", ", HubPeriods.All) });
+            return Ok(await _metrics.GetAsync(period, categoryId, CurrentDateTime()));
+        }
+
+        // GET: api/ai/hub/categories   (for the category picker)
+        [HttpGet("~/api/ai/hub/categories")]
+        [Authorize(Policy = "AI.Control")]
+        public async Task<IActionResult> HubCategories() =>
+            Ok(await _dbContext.Categories.AsNoTracking().OrderBy(c => c.CategoryName).Select(c => new { c.Id, name = c.CategoryName }).ToListAsync());
+
+        // GET: api/ai/hub/rules   (the owner's rule editor)
+        [HttpGet("~/api/ai/hub/rules")]
+        [Authorize(Policy = "AI.Control")]
+        public async Task<IActionResult> Rules() => Ok(await _rules.RulesAsync());
+
+        // PUT: api/ai/hub/rules/NegativeMargin  { "enabled": true, "threshold": 0, "role": "Pricing manager", "severity": "Act", "notifyEmail": false }
+        [HttpPut("~/api/ai/hub/rules/{key}")]
+        [Authorize(Policy = "AI.Control")]
+        public async Task<IActionResult> SaveRule(string key, [FromBody] AiRuleDTO dto)
+        {
+            var (ok, message) = await _rules.SaveRuleAsync(key, dto.Enabled, dto.Threshold, dto.Role, dto.Severity, dto.NotifyEmail, CurrentUserId(), CurrentDateTime());
+            if (!ok) return BadRequest(new { message });
+            await _rules.EvaluateAsync(CurrentDateTime());
+            return Ok(await _rules.RulesAsync());
+        }
+
+        // GET: api/ai/hub/tasks   (everything waiting for the signed-in person, by the roles they hold; checks the rules first)
+        [HttpGet("~/api/ai/hub/tasks")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> Tasks()
+        {
+            var now = CurrentDateTime();
+            await _rules.EvaluateAsync(now);
+            return Ok(await _tasks.MineAsync(now, CanActAs));
+        }
+
+        // GET: api/ai/hub/notifications   (just the counts, for a badge)
+        [HttpGet("~/api/ai/hub/notifications")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> Notifications()
+        {
+            var t = await _tasks.MineAsync(CurrentDateTime(), CanActAs);
+            return Ok(new { t.Total, t.Act, t.Approvals, t.Alerts, t.Reorders });
+        }
+
+        // POST: api/ai/hub/alerts/5/ack
+        [HttpPost("~/api/ai/hub/alerts/{id:int}/ack")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> Acknowledge(int id)
+        {
+            var alert = await _dbContext.HubAlerts.AsNoTracking().FirstOrDefaultAsync(a => a.Id == id);
+            if (alert == null) return NotFound();
+            if (!CanActAs(alert.Role)) return Forbid();
+            var (ok, message) = await _rules.AcknowledgeAsync(id, CurrentUserId(), CurrentDateTime());
+            return ok ? Ok(new { id }) : Conflict(new { message });
+        }
+
+        // POST: api/ai/hub/evaluate   (the agent runner asks PesoWeb to check the rules)
+        [HttpPost("~/api/ai/hub/evaluate")]
+        [Authorize(Policy = "AI.Read")]
+        public async Task<IActionResult> Evaluate()
+        {
+            var open = await _rules.EvaluateAsync(CurrentDateTime());
+            return Ok(new { open = open.Count });
+        }
+
+        // POST: api/ai/replenish   (AI Replenish posts its suggestions for the branches it covered)
+        [HttpPost("~/api/ai/replenish")]
+        [Authorize(Policy = "AI.Read")]
+        public async Task<IActionResult> ReplenishPost([FromBody] ReplenishPostDTO dto)
+        {
+            if (!await _control.IsEnabledAsync(AiFeatureKeys.Replenish))
+                return StatusCode(StatusCodes.Status422UnprocessableEntity, new { code = "AI_FEATURE_OFF", message = "AI Replenish is switched off for this company." });
+            var added = await _replenish.ReplaceOpenAsync(dto.WarehouseIds ?? new List<int>(), dto.Items ?? new List<ReplenishInput>(), CurrentDateTime());
+            return Ok(new { added });
+        }
+
+        // GET: api/ai/replenish?status=Open
+        [HttpGet("~/api/ai/replenish")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> ReplenishList(string status = "Open", int take = 100) => Ok(await _replenish.ListAsync(status, take));
+
+        // POST: api/ai/replenish/9/decision  { "decision": "Ordered" }
+        [HttpPost("~/api/ai/replenish/{id:int}/decision")]
+        [Authorize(Policy = "Pricing.View")]
+        public async Task<IActionResult> ReplenishDecision(int id, [FromBody] ReplenishDecisionDTO dto)
+        {
+            if (!CanActAs(ApprovalLanes.Store)) return Forbid();
+            var (ok, message) = await _replenish.DecideAsync(id, dto.Decision, CurrentUserId(), CurrentDateTime());
+            return ok ? Ok(new { id, status = dto.Decision }) : BadRequest(new { message });
+        }
+
         // GET: api/ai/settings   (the agent reads the switches before it acts)
         [HttpGet("~/api/ai/settings")]
         [Authorize(Policy = "AI.Read")]

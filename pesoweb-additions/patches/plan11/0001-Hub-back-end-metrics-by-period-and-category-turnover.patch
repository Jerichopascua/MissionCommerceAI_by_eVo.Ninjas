+namespace GoPosify.Models;
+
+public static class ReplenishStatus
+{
+    public const string Open = "Open";
+    public const string Ordered = "Ordered";          // a person confirmed they will order it (PesoWeb does not place the order)
+    public const string Dismissed = "Dismissed";
+    public const string Superseded = "Superseded";    // a newer run replaced it
+}
+
+// One reorder suggestion from AI Replenish for a product at a branch.
+[Index(nameof(TenantID), nameof(Status), Name = "IX_ReplenishSuggestions_Tenant_Status")]

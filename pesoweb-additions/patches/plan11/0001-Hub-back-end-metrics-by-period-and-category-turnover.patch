+    {
+        public List<(IReadOnlyCollection<string> To, string Subject)> Sent = new();
+        public Task<bool> SendAsync(IReadOnlyCollection<string> to, string subject, string body) { Sent.Add((to, subject)); return Task.FromResult(true); }
+    }
+
+    private sealed class World

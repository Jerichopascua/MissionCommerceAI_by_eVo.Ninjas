+			<div class="alert alert-danger mt-3 mb-0" *ngIf="restoring">
+				<b>{{app.Localize('Restore')}} "{{restoring}}"?</b>
+				{{app.Localize('Everything saved in the database since this snapshot, for every company, is replaced. A safety copy of the database as it is now is saved first, so this can be undone. Type RESTORE to confirm.')}}
+				<div class="d-flex gap-2 mt-2">

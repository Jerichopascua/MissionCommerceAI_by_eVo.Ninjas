+            // a safety snapshot of the database as it is now, so this restore can be undone
+            var safety = $"before-restore-{DateTime.Now:yyyyMMdd-HHmmss}";
+            var s = await SaveLockedAsync(safety, $"Taken automatically before restoring '{meta.Name}'.", by, SnapshotKinds.Safety, true);

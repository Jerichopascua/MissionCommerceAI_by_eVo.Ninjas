+			<div class="row align-items-center">
+				<div class="col-auto">
+					<div class="page-header-title"><h4>{{app.Localize('Test snapshots')}}</h4></div>
+					<ul class="breadcrumb">
+						<li class="breadcrumb-item"><a [routerLink]="['/']"><i class="fa fa-home me-1"></i>{{app.Localize('Home')}}</a></li>
+						<li class="breadcrumb-item">{{app.Localize('Intelligent Hub')}}</li>
+						<li class="breadcrumb-item">{{app.Localize('Test snapshots')}}</li>
+					</ul>
+				</div>
+				<div class="col"><div class="float-end"><button type="button" class="btn btn-outline-secondary" (click)="load()"><i class="fa fa-rotate me-1"></i>{{app.Localize('Refresh')}}</button></div></div>
+			</div>
+		</div>
+	</div>
+
+	<div class="alert alert-danger" *ngIf="error">{{error}}</div>
+	<div class="alert alert-success" *ngIf="message">{{message}}</div>
+	<div class="alert alert-warning" *ngIf="off">{{app.Localize('Snapshots are switched off on this server, or this login is not allowed to use them. They are for the test and demo database only: the server needs Snapshots:Enabled set to true, and you must be signed in as the head super admin.')}}</div>
+
+	<ng-container *ngIf="status">
+		<div class="snap-section">
+			<h5>{{app.Localize('The database right now')}}</h5>
+			<div class="snap-note">{{app.Localize('A snapshot is a copy of the whole database: every company, branch, product, sale and AI setting in it. It can only be restored into the same database structure.')}}</div>
+			<div class="row g-3 mt-1">
+				<div class="col-md-3"><div class="snap-note">{{app.Localize('Database')}}</div><b>{{status.database}}</b></div>
+				<div class="col-md-3"><div class="snap-note">{{app.Localize('Companies / branches')}}</div><b>{{status.companies}} / {{status.branches}}</b></div>
+				<div class="col-md-3"><div class="snap-note">{{app.Localize('Structure')}}</div><b>{{status.structure}}</b> <span class="snap-note">({{status.tables}} {{app.Localize('tables')}}, {{status.modules}} {{app.Localize('procedures, views and functions')}}, {{status.migrations}} {{app.Localize('migrations')}})</span></div>
+				<div class="col-md-3"><div class="snap-note">{{app.Localize('Initial snapshot for this structure')}}</div>
+					<span class="pill ok" *ngIf="status.hasInitial">{{status.initialSnapshot}}</span>
+					<span class="pill no" *ngIf="!status.hasInitial">{{app.Localize('none yet')}}</span></div>
+			</div>
+			<div class="alert alert-warning mt-3 mb-0 d-flex justify-content-between align-items-center flex-wrap gap-2" *ngIf="!status.hasInitial">
+				<span>{{status.message}}</span>
+				<button type="button" class="btn btn-sm btn-primary" (click)="makeInitial()" [disabled]="busy">{{app.Localize('Make the current data the initial snapshot')}}</button>
+			</div>
+			<div class="snap-note mt-2">{{app.Localize('Saved in')}} {{status.folder}}</div>
+		</div>
+
+		<div class="snap-section">
+			<h5>{{app.Localize('Save a snapshot')}}</h5>
+			<div class="snap-note">{{app.Localize('Saves the database as it is now under the name you give. A name is never saved over.')}}</div>

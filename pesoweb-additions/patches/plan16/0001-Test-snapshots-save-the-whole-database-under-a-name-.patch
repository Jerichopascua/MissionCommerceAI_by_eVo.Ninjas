+            await using var cmd = new SqlCommand(sql, c) { CommandTimeout = 120 };
+            await using var r = await cmd.ExecuteReaderAsync();
+            while (await r.ReadAsync())
+            {
+                var cells = new string[r.FieldCount];
+                for (var i = 0; i < r.FieldCount; i++) cells[i] = r.IsDBNull(i) ? "" : Convert.ToString(r.GetValue(i), System.Globalization.CultureInfo.InvariantCulture);
+                parts.Add(tag + "|" + string.Join("|", cells));

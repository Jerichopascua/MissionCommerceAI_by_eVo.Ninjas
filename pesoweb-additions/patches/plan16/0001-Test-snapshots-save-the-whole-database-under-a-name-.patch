+using GoPosify.Data;
+using GoPosify.Services;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+namespace GoPosify.Controllers
+{
+    // Whole-database snapshots for the test bench and demo (save under a name, restore, an initial snapshot per database structure).
+    // They cover every company in the database, so only the root super admin (or an address listed in Snapshots:AllowedEmails) may use them,
+    // and only where Snapshots:Enabled is true. Where it is off the endpoints answer 404 as if they did not exist.
+    [ApiController]
+    [Authorize]
+    public class SnapshotsController : BaseController
+    {
+        private readonly ISnapshotService _snapshots;
+
+        public SnapshotsController(AppDBContext dbContext, ISnapshotService snapshots) : base(dbContext) => _snapshots = snapshots;
+
+        public class SaveDTO { public string Name { get; set; } public string Note { get; set; } }
+        public class RestoreDTO { public string Name { get; set; } public string ConfirmText { get; set; } }
+
+        // Null when allowed; otherwise the answer to return.
+        private async Task<(IActionResult Refusal, string Who)> GateAsync()
+        {
+            if (!_snapshots.Options.Enabled) return (NotFound(), null);
+            var user = await GetCurrentUserRecordAsync();
+            var allowed = user != null && (IsRootSuperAdmin(user) || _snapshots.Options.AllowedEmails.Contains(user.Email ?? "", StringComparer.OrdinalIgnoreCase));
+            return allowed ? (null, user.Email) : (Forbid(), null);
+        }
+
+        // GET: api/snapshots   (the state of the database structure, and every snapshot with whether it can be restored now)
+        [HttpGet("~/api/snapshots")]
+        public async Task<IActionResult> Index()
+        {
+            var (refusal, _) = await GateAsync();
+            if (refusal != null) return refusal;
+            return Ok(new { status = await _snapshots.StatusAsync(), snapshots = await _snapshots.ListAsync() });
+        }
+
+        // POST: api/snapshots   { name, note }   (save the database as it is now)
+        [HttpPost("~/api/snapshots")]
+        public async Task<IActionResult> Save([FromBody] SaveDTO dto)
+        {
+            var (refusal, who) = await GateAsync();
+            if (refusal != null) return refusal;
+            var r = await _snapshots.SaveAsync(dto?.Name, dto?.Note, who);
+            return r.Ok ? Ok(new { r.Snapshot.Name, r.Snapshot.SizeBytes }) : BadRequest(new { message = r.Message });
+        }
+
+        // POST: api/snapshots/initial   (make the database as it is now the initial snapshot for its structure)
+        [HttpPost("~/api/snapshots/initial")]
+        public async Task<IActionResult> Initial()
+        {
+            var (refusal, who) = await GateAsync();
+            if (refusal != null) return refusal;
+            var name = $"INITIAL-{DateTime.Now:yyyyMMdd-HHmm}-{await _snapshots.StructureIdAsync()}";
+            var r = await _snapshots.SaveAsync(name, "Made the initial snapshot by hand.", who, SnapshotKinds.Initial);
+            return r.Ok ? Ok(new { r.Snapshot.Name, r.Snapshot.SizeBytes }) : BadRequest(new { message = r.Message });
+        }
+
+        // POST: api/snapshots/restore   { name, confirmText: "RESTORE" }
+        [HttpPost("~/api/snapshots/restore")]
+        public async Task<IActionResult> Restore([FromBody] RestoreDTO dto)
+        {
+            var (refusal, who) = await GateAsync();
+            if (refusal != null) return refusal;
+            if (!string.Equals(dto?.ConfirmText, "RESTORE", StringComparison.Ordinal))
+                return BadRequest(new { message = "Type RESTORE to confirm. Everything saved in the database since the snapshot will be replaced." });
+            var r = await _snapshots.RestoreAsync(dto.Name, who);
+            return r.Ok ? Ok(new { message = r.Message }) : Conflict(new { message = r.Message });
+        }
+
+        // DELETE: api/snapshots/{name}
+        [HttpDelete("~/api/snapshots/{name}")]
+        public async Task<IActionResult> Delete(string name)
+        {
+            var (refusal, _) = await GateAsync();
+            if (refusal != null) return refusal;
+            var r = await _snapshots.DeleteAsync(name);
+            return r.Ok ? Ok() : BadRequest(new { message = r.Message });
+        }
+    }
+}

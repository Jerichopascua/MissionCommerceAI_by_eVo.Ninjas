+    // ---- save, restore, delete ---------------------------------------------------------------------------------------
+    public async Task<(bool Ok, string Message, SnapshotMeta Snapshot)> SaveAsync(string name, string note, string by, string kind = SnapshotKinds.Saved, bool automatic = false)
+    {

+
+public static class SnapshotRules
+{
+    private static readonly Regex NameOk = new(@"^[A-Za-z0-9][A-Za-z0-9 _.\-]{0,59}$", RegexOptions.Compiled);
+
+    public static string CleanName(string name) => (name ?? "").Trim();
+
+    public static bool ValidName(string name) => NameOk.IsMatch(name ?? "") && !(name ?? "").EndsWith(".") && !(name ?? "").Contains("..");
+
+    // File names must stay inside the snapshot folder whatever is typed.
+    public static string FileStem(string name) => Regex.Replace(name, @"[^A-Za-z0-9_.\- ]", "_");
+
+    // Restorable only into the same structure. The reasons are written for a person.
+    public static (bool Ok, string Reason) CanRestore(SnapshotMeta snapshot, SchemaInfo current, string currentDatabase)
+    {
+        if (snapshot == null) return (false, "Unknown snapshot.");
+        if (string.IsNullOrEmpty(snapshot.SchemaFingerprint))
+            return (false, "This snapshot has no record of the database structure it was taken from, so it cannot be checked and will not be restored.");
+        if (!string.Equals(snapshot.Database, currentDatabase, StringComparison.OrdinalIgnoreCase))
+            return (false, $"This snapshot is of the database '{snapshot.Database}', not '{currentDatabase}'.");
+        var onlyInSnapshot = snapshot.Migrations.Except(current.Migrations).ToList();
+        var onlyNow = current.Migrations.Except(snapshot.Migrations).ToList();
+        if (onlyInSnapshot.Count > 0 || onlyNow.Count > 0)
+        {

+        var name = $"INITIAL-{DateTime.Now:yyyyMMdd-HHmm}-{current.Fingerprint.Substring(0, 8)}";
+        var r = await SaveAsync(name, "Taken automatically because the database structure has no initial snapshot yet; it holds the data as it was at that moment.", "system", SnapshotKinds.Initial, true);
+        if (!r.Ok) _log.LogWarning("Automatic initial snapshot failed: {Message}", r.Message);
+        return r.Ok;
+    }
+}
+
+public sealed class SnapshotStartupService : BackgroundService
+{
+    private readonly ISnapshotService _snapshots;
+    private readonly ILogger<SnapshotStartupService> _log;
+
+    public SnapshotStartupService(ISnapshotService snapshots, ILogger<SnapshotStartupService> log)
+    {
+        _snapshots = snapshots;
+        _log = log;
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stop)
+    {
+        if (!_snapshots.Options.Enabled) return;
+        try
+        {
+            await Task.Delay(TimeSpan.FromSeconds(20), stop);
+            if (await _snapshots.EnsureInitialAsync()) _log.LogInformation("An initial snapshot was created for the current database structure.");
+        }
+        catch (OperationCanceledException) { }
+        catch (Exception e) { _log.LogWarning(e, "The initial snapshot check failed."); }
+    }
+}

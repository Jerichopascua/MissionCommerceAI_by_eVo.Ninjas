+            {
+                await c.OpenAsync();
+                await using var cmd = new SqlCommand("RESTORE VERIFYONLY FROM DISK = @p WITH CHECKSUM", c) { CommandTimeout = 0 };
+                cmd.Parameters.AddWithValue("@p", Bak(meta.Name));
+                try { await cmd.ExecuteNonQueryAsync(); }
+                catch (SqlException e) { return (false, "The snapshot file could not be verified, so nothing was changed: " + e.Message); }
+            }

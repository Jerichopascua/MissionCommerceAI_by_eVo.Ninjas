+        if (!string.Equals(snapshot.SchemaFingerprint, current.Fingerprint, StringComparison.Ordinal))
+            return (false, "The tables, columns, stored procedures, views, functions or indexes differ from the ones this snapshot was taken from (same migrations, different structure). Restoring would put back the old definitions, so it is refused. Use a snapshot taken after the change.");
+        return (true, null);
+    }
+
+    private static string Short(List<string> ids) => string.Join(", ", ids.Take(3)) + (ids.Count > 3 ? ", ..." : "");
+}
+
+public interface ISnapshotService
+{
+    SnapshotOptions Options { get; }

@@ -0,0 +1,84 @@
+import { Component, Inject, OnInit } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { AppService } from '../../services/app.service';
+
+// Test snapshots: save the whole database under a name, restore it later, and keep an initial snapshot for the current database structure.
+// A snapshot is restored only into the structure it was taken from (tables, columns, stored procedures and so on); after a structure change
+// the old snapshots stay on disk but cannot be restored, and a new initial snapshot is made. Head super admin only; off unless the server allows it.
+@Component({
+  selector: 'app-snapshots',
+  templateUrl: './snapshots.component.html',
+  styles: [`
+    .snap-section { border: 1px solid #e3ebf8; border-radius: 14px; background: #fff; padding: 16px 18px; margin-bottom: 18px; }
+    .snap-note { font-size: 13px; color: #6b7a90; }
+    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
+    .pill.ok { background: #e6f6ec; color: #1a7f43; }
+    .pill.no { background: #fdecec; color: #b42323; }
+    .pill.info { background: #e8f1ff; color: #1f55b5; }
+  `]
+})
+export class SnapshotsComponent implements OnInit {
+  public status: any = null;
+  public snapshots: any[] = [];
+  public name = '';
+  public note = '';
+  public restoring: string | null = null;
+  public confirmText = '';
+  public busy = false;
+  public off = false;
+  public error = '';
+  public message = '';
+
+  constructor(private http: HttpClient, @Inject('BASE_URL') private baseUrl: string, public app: AppService) { }
+
+  ngOnInit(): void { this.load(); }
+
+  public load(): void {
+    this.http.get<any>(this.baseUrl + 'api/snapshots').subscribe({
+      next: (r) => { this.status = r.status; this.snapshots = r.snapshots; this.off = false; },
+      error: (e) => {
+        this.off = e.status === 404 || e.status === 403;
+        this.error = this.off ? '' : this.text(e, 'Could not load the snapshots.');
+      }
+    });
+  }
+
+  private text(e: any, fallback: string): string { return (e && e.error && e.error.message) || fallback; }
+
+  public save(): void {
+    this.busy = true; this.error = ''; this.message = '';
+    this.http.post<any>(this.baseUrl + 'api/snapshots', { name: this.name, note: this.note }).subscribe({
+      next: (r) => { this.busy = false; this.message = 'Saved "' + r.name + '" (' + this.mb(r.sizeBytes) + ').'; this.name = ''; this.note = ''; this.load(); },
+      error: (e) => { this.busy = false; this.error = this.text(e, 'Could not save the snapshot.'); }
+    });
+  }
+
+  public makeInitial(): void {
+    this.busy = true; this.error = ''; this.message = '';
+    this.http.post<any>(this.baseUrl + 'api/snapshots/initial', {}).subscribe({
+      next: (r) => { this.busy = false; this.message = 'The initial snapshot for the current structure is "' + r.name + '".'; this.load(); },
+      error: (e) => { this.busy = false; this.error = this.text(e, 'Could not make the initial snapshot.'); }
+    });
+  }
+
+  public askRestore(name: string): void { this.restoring = name; this.confirmText = ''; this.error = ''; this.message = ''; }
+
+  public restore(): void {
+    if (!this.restoring) { return; }
+    this.busy = true; this.error = ''; this.message = '';
+    this.http.post<any>(this.baseUrl + 'api/snapshots/restore', { name: this.restoring, confirmText: this.confirmText }).subscribe({
+      next: (r) => { this.busy = false; this.message = r.message; this.restoring = null; this.load(); },
+      error: (e) => { this.busy = false; this.error = this.text(e, 'Could not restore the snapshot.'); }
+    });
+  }
+
+  public remove(name: string): void {
+    if (!window.confirm('Delete the snapshot "' + name + '"?')) { return; }
+    this.http.delete(this.baseUrl + 'api/snapshots/' + encodeURIComponent(name)).subscribe({
+      next: () => this.load(),
+      error: (e) => (this.error = this.text(e, 'Could not delete the snapshot.'))
+    });
+  }
+
+  public mb(bytes: number): string { return (bytes / 1024 / 1024).toFixed(0) + ' MB'; }
+}

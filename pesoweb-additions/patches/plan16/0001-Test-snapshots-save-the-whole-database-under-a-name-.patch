+        // Data is never part of it: only definitions. Each query is ordered so the fingerprint does not depend on the order the server returns rows.
+        await Collect("col", "SELECT t.name, c.name, ty.name, c.max_length, c.precision, c.scale, c.is_nullable, c.is_identity, c.is_computed FROM sys.columns c JOIN sys.tables t ON t.object_id = c.object_id JOIN sys.types ty ON ty.user_type_id = c.user_type_id WHERE t.is_ms_shipped = 0 ORDER BY t.name, c.name");

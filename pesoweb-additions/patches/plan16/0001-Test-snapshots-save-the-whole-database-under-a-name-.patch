+    Task<(bool Ok, string Message, SnapshotMeta Snapshot)> SaveAsync(string name, string note, string by, string kind = SnapshotKinds.Saved, bool automatic = false);
+    Task<(bool Ok, string Message)> RestoreAsync(string name, string by);
+    Task<(bool Ok, string Message)> DeleteAsync(string name);
+    Task<bool> EnsureInitialAsync();
+    // A short id of the current database structure (the start of its fingerprint).
+    Task<string> StructureIdAsync();
+}
+
+public sealed class SnapshotService : ISnapshotService
+{
+    private static readonly SemaphoreSlim Gate = new(1, 1);
+    private readonly IConfiguration _config;
+    private readonly ILogger<SnapshotService> _log;
+    public SnapshotOptions Options { get; }
+
+    public SnapshotService(IConfiguration config, ILogger<SnapshotService> log)
+    {
+        _config = config;
+        _log = log;
+        Options = SnapshotOptions.From(config);
+    }
+
+    private string ConnectionString => _config.GetConnectionString("default");

+    }
+
+    public async Task<(bool Ok, string Message)> DeleteAsync(string name)
+    {
+        await Gate.WaitAsync();
+        try
+        {
+            var meta = Read().FirstOrDefault(m => string.Equals(m.Name, SnapshotRules.CleanName(name), StringComparison.OrdinalIgnoreCase));

+using GoPosify.Services;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class SnapshotRulesTests
+{
+    private static SchemaInfo Now(string fp = "aaa", params string[] migrations) => new() { Fingerprint = fp, Migrations = migrations.ToList() };
+    private static SnapshotMeta Snap(string fp = "aaa", string db = "PesoWeb", params string[] migrations) => new() { Name = "s", Database = db, SchemaFingerprint = fp, Migrations = migrations.ToList() };
+
+    [Fact]
+    public void The_same_structure_can_be_restored()
+    {
+        var (ok, reason) = SnapshotRules.CanRestore(Snap("aaa", "PesoWeb", "M1", "M2"), Now("aaa", "M1", "M2"), "PesoWeb");
+        Assert.True(ok);
+        Assert.Null(reason);
+    }
+
+    [Fact]
+    public void A_migration_applied_since_the_snapshot_refuses_the_restore_and_says_which()
+    {
+        var (ok, reason) = SnapshotRules.CanRestore(Snap("aaa", "PesoWeb", "M1"), Now("bbb", "M1", "M2"), "PesoWeb");
+        Assert.False(ok);
+        Assert.Contains("1 migration(s) were applied since (M2)", reason);
+        Assert.Contains("refused", reason);
+    }
+
+    [Fact]

+				<div class="col-md-5"><label class="snap-note">{{app.Localize('Note (optional)')}}</label><input class="form-control" maxlength="200" [(ngModel)]="note"></div>
+				<div class="col-md-3"><button type="button" class="btn btn-primary w-100" (click)="save()" [disabled]="busy || !name"><i class="fa fa-floppy-disk me-1"></i>{{app.Localize('Save snapshot')}}</button></div>

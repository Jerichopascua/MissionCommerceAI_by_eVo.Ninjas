+					<button type="button" class="btn btn-danger" (click)="restore()" [disabled]="busy || confirmText !== 'RESTORE'">{{app.Localize('Restore now')}}</button>
+					<button type="button" class="btn btn-outline-secondary" (click)="restoring = null">{{app.Localize('Cancel')}}</button>
+				</div>
+			</div>
+		</div>
+	</ng-container>

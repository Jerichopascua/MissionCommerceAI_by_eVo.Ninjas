+								<span class="pill no" *ngIf="!s.restorable">{{app.Localize('No')}}</span>
+								<div class="snap-note" *ngIf="!s.restorable" style="max-width:360px">{{s.reason}}</div>
+							</td>
+							<td class="text-end text-nowrap">

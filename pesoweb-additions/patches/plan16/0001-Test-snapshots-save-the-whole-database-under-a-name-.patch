+            return (true, null);
+        }
+        finally { Gate.Release(); }
+    }
+
+    // After a change to the database structure there is no initial snapshot for it. One is made, from the data as it is at that moment.
+    public async Task<string> StructureIdAsync() => (await SchemaAsync()).Fingerprint.Substring(0, 8);
+
+    public async Task<bool> EnsureInitialAsync()
+    {

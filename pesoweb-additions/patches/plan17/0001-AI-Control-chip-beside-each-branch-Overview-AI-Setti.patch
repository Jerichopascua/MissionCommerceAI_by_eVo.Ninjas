From e54ceaf9025297e20d8a99835916a394d5d2e953 Mon Sep 17 00:00:00 2001
From: unknown <jericho.pascua@gmail.com>
Date: Sat, 10 Oct 2026 13:57:37 +0800
Subject: [PATCH 1/3] AI / Control chip beside each branch (Overview, AI
 Settings) and AI/Control branch counts in the all-companies table

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 ClientApp/src/app/ai/aihub/aihub.component.html | 6 +++---
 Services/HubMetricsService.cs                   | 2 ++
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/ClientApp/src/app/ai/aihub/aihub.component.html b/ClientApp/src/app/ai/aihub/aihub.component.html
index d48b31f..47bd9b5 100644
--- a/ClientApp/src/app/ai/aihub/aihub.component.html
+++ b/ClientApp/src/app/ai/aihub/aihub.component.html
@@ -118,7 +118,7 @@
 					</thead>
 					<tbody>
 						<tr *ngFor="let b of branchRows">
-							<td>{{b.name}}<div class="hub-note" *ngIf="b.region">{{b.region}}</div></td>
+							<td>{{b.name}} <span class="pill" [class.ok]="b.aiBranch" [class.info]="!b.aiBranch" style="margin-left:6px">{{ b.aiBranch ? 'AI' : 'Control' }}</span><div class="hub-note" *ngIf="b.region">{{b.region}}</div></td>
 							<td class="bar-cell"><div>{{money(b.sales)}}</div><div class="bar"><span [style.width.%]="salesShare(b)"></span></div></td>
 							<td class="text-end">{{pct(b.marginPct)}}</td>
 							<td class="text-end">{{num(b.turnover, 2)}}&times;</td>
@@ -426,7 +426,7 @@
 					<thead><tr><th>{{app.Localize('Branch')}}</th><th>{{app.Localize('AI markdowns')}}</th><th>{{app.Localize('Not before')}}</th><th>{{app.Localize('Region')}}</th><th>{{app.Localize('Sales target per day')}}</th><th>{{app.Localize('Waste target (% of cost of sales)')}}</th><th></th></tr></thead>
 					<tbody>
 						<tr *ngFor="let b of branches">
-							<td>{{b.name}}</td>
+							<td>{{b.name}} <span class="pill" [class.ok]="b.pricingEnabled" [class.info]="!b.pricingEnabled" style="margin-left:6px">{{ b.pricingEnabled ? 'AI' : 'Control' }}</span></td>
 							<td>
 								<div class="form-check form-switch">
 									<input class="form-check-input" type="checkbox" role="switch" [(ngModel)]="b.pricingEnabled">
@@ -470,7 +470,7 @@
 							<td class="text-end">{{c.policyConfigured ? c.softMarginFloorPct + '%' : '-'}}</td>
 							<td>{{c.autoApprove ? app.Localize('On') : app.Localize('Off')}}</td>
 							<td class="text-end">{{c.waiting}}</td>
-							<td class="text-end">{{c.branches}}</td>
+							<td class="text-end">{{c.branches}}<div class="hub-note">{{c.branches - c.branchesAiOff}} AI / {{c.branchesAiOff}} {{app.Localize('Control')}}</div></td>
 							<td class="text-end">{{c.branchesAiOff}}</td>
 						</tr>
 					</tbody>
diff --git a/Services/HubMetricsService.cs b/Services/HubMetricsService.cs
index de99be5..4d29f6b 100644
--- a/Services/HubMetricsService.cs
+++ b/Services/HubMetricsService.cs
@@ -67,6 +67,7 @@ public class HubMetricsRow
     public decimal ExpiryAtRisk { get; set; }
     public decimal ExpiredUnwritten { get; set; }
     public string Region { get; set; }
+    public bool AiBranch { get; set; } = true;       // AI markdowns are on for this branch (off: it can serve as a control)
     public decimal? SalesTargetPerDay { get; set; }
     public decimal? SalesTarget { get; set; }       // the daily target over the period so far
     public decimal? TargetPct { get; set; }         // sales as a share of that target
@@ -200,6 +201,7 @@ public sealed class HubMetricsService : IHubMetricsService
         {
             var bs = branchSettings.FirstOrDefault(x => x.WarehouseId == r.WarehouseId);
             r.Region = string.IsNullOrWhiteSpace(bs?.Region) ? null : bs.Region;
+            r.AiBranch = bs?.PricingEnabled ?? true;
             r.SalesTargetPerDay = bs?.SalesTargetPerDay;
             r.WasteTargetPct = bs?.WasteTargetPct;
             if (r.SalesTargetPerDay is > 0m)

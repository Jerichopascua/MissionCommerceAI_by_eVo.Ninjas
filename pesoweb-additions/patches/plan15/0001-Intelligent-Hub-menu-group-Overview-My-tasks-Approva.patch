 ClientApp/src/app/app.component.html          | 110 +++++++++++++-----
 .../src/app/homemenu/homemenu.component.html  | 110 +++++++++++++-----
 3 files changed, 181 insertions(+), 55 deletions(-)

diff --git a/ClientApp/src/app/ai/aihub/aihub.component.ts b/ClientApp/src/app/ai/aihub/aihub.component.ts
index bbdd822..bca3f89 100644
--- a/ClientApp/src/app/ai/aihub/aihub.component.ts
+++ b/ClientApp/src/app/ai/aihub/aihub.component.ts
@@ -1,5 +1,6 @@
 import { Component, Inject, OnDestroy, OnInit } from '@angular/core';
 import { HttpClient } from '@angular/common/http';
+import { ActivatedRoute } from '@angular/router';
 import { AppService } from '../../services/app.service';
 
 // The Intelligence Hub: how the company is doing (by branch, for a period and category), what needs attention, and the AI settings
@@ -82,11 +83,14 @@ export class AiHubComponent implements OnInit, OnDestroy {
   constructor(
     private http: HttpClient,
     @Inject('BASE_URL') private baseUrl: string,
-    public app: AppService
+    public app: AppService,
+    private route: ActivatedRoute
   ) { }
 
   ngOnInit(): void {
     this.load();
+    // The Intelligent Hub menu opens a tab directly: /ai/hub?tab=tasks (also works while the page is already open).
+    this.route.queryParamMap.subscribe((q) => this.openTab(q.get('tab')));
     // The overview refreshes itself every minute while it is showing and auto-refresh is on.
     this.timer = setInterval(() => { if (this.autoRefresh && this.tab === 'overview') { this.loadMetrics(true); }
       if (this.autoRefresh) { this.loadTasks(); } }, 60000);
@@ -96,6 +100,16 @@ export class AiHubComponent implements OnInit, OnDestroy {
     if (this.timer) { clearInterval(this.timer); }
   }
 
+  public openTab(name: string | null): void {
+    if (!name || ['overview', 'tasks', 'reorders', 'missions', 'impact', 'rules', 'settings'].indexOf(name) < 0) { return; }
+    this.tab = name;
+    if (name === 'tasks') { this.loadTasks(); }
+    if (name === 'reorders') { this.loadReorders(); }
+    if (name === 'missions') { this.loadMissions(); }
+    if (name === 'impact') { this.loadImpact(); }
+    if (name === 'rules') { this.loadRules(); }
+  }
+
   public load(): void {
     this.loadMetrics(false);
     this.http.get<any[]>(this.baseUrl + 'api/ai/hub/categories').subscribe({ next: (c) => (this.categories = c), error: () => { } });

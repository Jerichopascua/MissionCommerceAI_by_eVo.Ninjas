+using System.Globalization;
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public sealed class ImpactMetrics
+{
+    public decimal Sales { get; set; }
+    public int Transactions { get; set; }
+    public decimal Cogs { get; set; }
+    public decimal Margin { get; set; }
+    public decimal? MarginPct { get; set; }
+    public decimal WriteOff { get; set; }
+    public decimal? WastePct { get; set; }
+}
+
+public interface IAiImpactService
+{
+    // Compares equal windows before and after the day the AI started pricing (default: the first applied AI price change), for the whole company
+    // and, when some branches have the AI switched off, AI branches against those control branches (difference in differences).
+    Task<object> GetAsync(int days, DateTime? switchDate, DateTime now);
+}
+
+public static class ImpactMath
+{
+    public static ImpactMetrics Build(decimal sales, int txns, decimal cogs, decimal writeOff) => new()
+    {
+        Sales = sales, Transactions = txns, Cogs = cogs, Margin = sales - cogs, MarginPct = HubMath.MarginPct(sales, cogs),
+        WriteOff = writeOff, WastePct = cogs > 0m ? Math.Round(writeOff / cogs * 100m, 2) : null
+    };
+
+    public static ImpactMetrics Sum(IEnumerable<ImpactMetrics> rows)
+    {
+        var l = rows.ToList();
+        return Build(l.Sum(r => r.Sales), l.Sum(r => r.Transactions), l.Sum(r => r.Cogs), l.Sum(r => r.WriteOff));
+    }
+
+    // Percent change in sales, and the change in margin rate and waste rate in percentage points. Null when either side has no data.
+    public static (decimal? SalesPct, decimal? MarginPts, decimal? WastePts) Change(ImpactMetrics before, ImpactMetrics after) => (
+        before.Sales > 0m ? Math.Round((after.Sales - before.Sales) / before.Sales * 100m, 1) : null,
+        before.MarginPct.HasValue && after.MarginPct.HasValue ? Math.Round(after.MarginPct.Value - before.MarginPct.Value, 1) : null,
+        before.WastePct.HasValue && after.WastePct.HasValue ? Math.Round(after.WastePct.Value - before.WastePct.Value, 2) : null);
+
+    public static decimal? Minus(decimal? a, decimal? b) => a.HasValue && b.HasValue ? a - b : null;
+}
+
+public sealed class AiImpactService : IAiImpactService
+{
+    public const int MinDays = 3;
+    public const int MaxDays = 60;
+    private readonly AppDBContext _db;
+
+    public AiImpactService(AppDBContext db) => _db = db;
+
+    private sealed record Flow(int WarehouseId, string Type, decimal InValue, decimal OutValue);
+
+    // Per branch: sales, cost of goods sold (sold out less returned in, at the cost on the ledger row) and expired stock written off.
+    private async Task<Dictionary<int, ImpactMetrics>> WindowAsync(DateTime start, DateTime end, IEnumerable<int> warehouseIds)
+    {
+        var sales = (await _db.Sales.AsNoTracking().Where(s => s.SaleDate >= start && s.SaleDate < end)
+            .GroupBy(s => s.WarehouseId).Select(g => new { g.Key, Total = g.Sum(s => s.TotalAmount), Count = g.Count() }).ToListAsync())
+            .ToDictionary(x => x.Key, x => (x.Total, x.Count));
+        var flows = await (from t in _db.InventoryTransactions.AsNoTracking()
+                           join p in _db.Products.AsNoTracking() on t.ProductId equals p.Id
+                           where t.TransactionDate >= start && t.TransactionDate < end
+                           group new { t, p } by new { t.WarehouseId, t.TransactionType } into g
+                           select new Flow(g.Key.WarehouseId, g.Key.TransactionType,
+                               g.Sum(x => x.t.QtyIn * (x.t.UnitCost ?? x.p.Cost)), g.Sum(x => x.t.QtyOut * (x.t.UnitCost ?? x.p.Cost)))).ToListAsync();
+        var result = new Dictionary<int, ImpactMetrics>();
+        foreach (var wh in warehouseIds)
+        {
+            sales.TryGetValue(wh, out var s);
+            decimal Out(string type) => flows.Where(f => f.WarehouseId == wh && f.Type == type).Sum(f => f.OutValue);
+            decimal In(string type) => flows.Where(f => f.WarehouseId == wh && f.Type == type).Sum(f => f.InValue);
+            result[wh] = ImpactMath.Build(s.Total, s.Count, Out("SALE_OUT") - In("SALE_RETURN_IN"), Out(ExpiryTransactionTypes.WriteOff));
+        }
+        return result;
+    }
+
+    private static string Pts(decimal? v) => v.HasValue ? v.Value.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) + " points" : "no data";
+    private static string Pct(decimal? v) => v.HasValue ? v.Value.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) + "%" : "no data";
+
+    public async Task<object> GetAsync(int days, DateTime? switchDate, DateTime now)
+    {
+        days = Math.Clamp(days, MinDays, MaxDays);
+        var warehouses = await _db.Warehouses.AsNoTracking().OrderBy(w => w.Id).Select(w => new { w.Id, w.WarehouseName }).ToListAsync();
+        var settings = await _db.AiBranchSettings.AsNoTracking().ToListAsync();
+        var aiChanges = await _db.PriceChanges.AsNoTracking().Where(c => c.Source == PriceChangeSource.Ai && c.Status == PriceChangeStatus.Applied)
+            .Select(c => new { c.WarehouseId, c.CreatedAt, IsMarkdown = c.BatchId != null || c.EndsAt != null }).ToListAsync();
+
+        string switchSource;
+        DateTime? first = aiChanges.Count > 0 ? aiChanges.Min(c => c.CreatedAt).Date : null;
+        DateTime day;
+        if (switchDate.HasValue) { day = switchDate.Value.Date; switchSource = "chosen"; }
+        else if (first.HasValue) { day = first.Value; switchSource = "the day of the first AI price change that was applied"; }
+        else return new { available = false, message = "The AI has not changed any price yet, so there is nothing to compare. Approve some proposals in the Approval Center, or let AI markdowns run, and come back after a few days.", days };
+
+        var afterDays = (int)Math.Floor((now - day).TotalDays);
+        var n = Math.Min(days, afterDays);
+        if (n < MinDays)
+            return new { available = false, switchDate = day, switchSource, message = $"Too early: the comparison needs at least {MinDays} full days after {day:MMM d} (there are {Math.Max(afterDays, 0)} so far).", days };
+
+        var beforeFrom = day.AddDays(-n); var afterTo = day.AddDays(n);
+        var ids = warehouses.Select(w => w.Id).ToList();
+        var before = await WindowAsync(beforeFrom, day, ids);
+        var after = await WindowAsync(day, afterTo, ids);
+
+        bool PricingOn(int wh) => settings.FirstOrDefault(s => s.WarehouseId == wh)?.PricingEnabled ?? true;
+        // A markdown is decided per branch, so a branch can sit it out; a list price is the product's price for the whole company, so no branch can.
+        int AppliedAfter(int wh) => aiChanges.Count(c => c.IsMarkdown && c.WarehouseId == wh && c.CreatedAt >= day && c.CreatedAt < afterTo);
+
+        var rows = warehouses.Select(w =>
+        {
+            var c = ImpactMath.Change(before[w.Id], after[w.Id]);
+            var applied = AppliedAfter(w.Id);
+            var role = !PricingOn(w.Id) ? (applied == 0 ? "Control" : "Excluded") : (applied > 0 ? "AI" : "Idle");
+            return new { warehouseId = w.Id, name = w.WarehouseName, role, aiMarkdowns = applied, before = before[w.Id], after = after[w.Id],
+                         change = new { salesPct = c.SalesPct, marginPts = c.MarginPts, wastePts = c.WastePts } };
+        }).ToList();
+
+        var allBefore = ImpactMath.Sum(before.Values); var allAfter = ImpactMath.Sum(after.Values);
+        var all = ImpactMath.Change(allBefore, allAfter);
+        var caveats = new List<string> { "Indicative, not proof: the season, promotions, supplier prices and the weather changed too. The more branches and days, the less a coincidence can explain." };
+        var summary = $"Over {n} days after {day:MMM d} compared with the {n} days before, the company's sales changed {Pct(all.SalesPct)}, its margin rate {Pts(all.MarginPts)} and its waste rate {Pts(all.WastePts)}.";
+
+        object control;
+        var ai = rows.Where(r => r.role == "AI").ToList();
+        var ctl = rows.Where(r => r.role == "Control").ToList();
+        if (ai.Count == 0 || ctl.Count == 0)
+        {
+            var why = ctl.Count == 0
+                ? "No branch is set aside as a control. Switch the AI markdowns off for one similar branch (Intelligence Hub, AI Settings, 'AI markdowns' off) and keep the others on; after a few days this compares them fairly."
+                : "No AI markdown was applied at any branch in the period, so there are no AI branches to compare with the control.";
+            control = new { available = false, message = why };
+        }
+        else
+        {
+            var aiB = ImpactMath.Sum(ai.Select(r => r.before)); var aiA = ImpactMath.Sum(ai.Select(r => r.after));
+            var cB = ImpactMath.Sum(ctl.Select(r => r.before)); var cA = ImpactMath.Sum(ctl.Select(r => r.after));
+            var ca = ImpactMath.Change(aiB, aiA); var cc = ImpactMath.Change(cB, cA);
+            var d = (salesPts: ImpactMath.Minus(ca.SalesPct, cc.SalesPct), marginPts: ImpactMath.Minus(ca.MarginPts, cc.MarginPts), wastePts: ImpactMath.Minus(ca.WastePts, cc.WastePts));
+            var reading = $"AI branches' margin rate moved {Pts(ca.MarginPts)} while control branches' moved {Pts(cc.MarginPts)}: {Pts(d.marginPts)} relative to the control. "
+                        + $"Sales: AI {Pct(ca.SalesPct)} against control {Pct(cc.SalesPct)}. Waste rate: AI {Pts(ca.WastePts)} against control {Pts(cc.WastePts)}.";
+            if (ai.Count < 2 || ctl.Count < 2) caveats.Add("Only " + (ai.Count < 2 ? "one AI branch" : "") + (ai.Count < 2 && ctl.Count < 2 ? " and " : "") + (ctl.Count < 2 ? "one control branch" : "")
+                + ": one shop is a weak comparison. Treat it as a hint.");
+            control = new
+            {
+                available = true, reading,
+                ai = new { branches = ai.Count, before = aiB, after = aiA, change = new { salesPct = ca.SalesPct, marginPts = ca.MarginPts, wastePts = ca.WastePts } },
+                control = new { branches = ctl.Count, before = cB, after = cA, change = new { salesPct = cc.SalesPct, marginPts = cc.MarginPts, wastePts = cc.WastePts } },
+                difference = new { salesPts = d.salesPts, marginPts = d.marginPts, wastePts = d.wastePts }
+            };
+        }
+        var listChanges = aiChanges.Count(c => !c.IsMarkdown && c.CreatedAt >= day && c.CreatedAt < afterTo);
+        if (listChanges > 0)
+            caveats.Add($"{listChanges} AI list-price change(s) were applied in the period. A list price is the same at every branch, so it also moved the control branches: the AI-against-control comparison measures the AI's markdowns only, and the company's before and after includes both.");
+        if (rows.Any(r => r.role == "Excluded"))
+            caveats.Add("Left out of the control: " + string.Join(", ", rows.Where(r => r.role == "Excluded").Select(r => r.name)) + " (AI markdowns are off now, but the AI marked prices down there during the period).");
+        if (rows.Any(r => r.role == "Idle"))
+            caveats.Add("Not counted as AI branches (AI on, but no markdown was applied in the period): " + string.Join(", ", rows.Where(r => r.role == "Idle").Select(r => r.name)) + ".");
+
+        return new
+        {
+            available = true, days, windowDays = n, switchDate = day, switchSource, generatedAt = now,
+            before = new { from = beforeFrom, to = day, metrics = allBefore }, after = new { from = day, to = afterTo, metrics = allAfter },
+            change = new { salesPct = all.SalesPct, marginPts = all.MarginPts, wastePts = all.WastePts, marginPerDay = Math.Round((allAfter.Margin - allBefore.Margin) / n, 2) },
+            aiPriceChanges = aiChanges.Count(c => c.CreatedAt >= day && c.CreatedAt < afterTo),
+            summary, branches = rows, control, caveats
+        };
+    }
+}

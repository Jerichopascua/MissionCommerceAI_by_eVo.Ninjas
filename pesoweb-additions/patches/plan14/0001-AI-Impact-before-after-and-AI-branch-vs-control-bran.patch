+  }
+
+  public pts(n: number | null | undefined): string { return n === null || n === undefined ? '-' : (n > 0 ? '+' : '') + Number(n).toFixed(1); }
+  public chg(n: number | null | undefined): string { return n === null || n === undefined ? '-' : (n > 0 ? '+' : '') + Number(n).toFixed(1) + '%'; }
+  public roleText(r: string): string {
+    return r === 'AI' ? 'AI on' : r === 'Control' ? 'Control (AI off)' : r === 'Excluded' ? 'Left out' : 'AI on, no change yet';
+  }

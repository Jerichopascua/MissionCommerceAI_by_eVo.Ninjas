+using GoPosify.Models;
+using GoPosify.Services;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class AiImpactMathTests
+{
+    [Fact]
+    public void Change_is_percent_for_sales_and_points_for_rates_and_null_without_data()
+    {
+        var before = ImpactMath.Build(1000m, 10, 800m, 20m);      // margin 20%, waste 2.5%
+        var after = ImpactMath.Build(1100m, 12, 825m, 8.25m);     // margin 25%, waste 1.0%
+        var c = ImpactMath.Change(before, after);
+        Assert.Equal(10.0m, c.SalesPct);
+        Assert.Equal(5.0m, c.MarginPts);
+        Assert.Equal(-1.5m, c.WastePts);
+        var none = ImpactMath.Change(ImpactMath.Build(0m, 0, 0m, 0m), after);
+        Assert.Null(none.SalesPct);
+        Assert.Null(none.MarginPts);
+    }
+
+    [Fact]
+    public void Sum_adds_up_before_working_out_the_rates()
+    {
+        var s = ImpactMath.Sum(new[] { ImpactMath.Build(1000m, 1, 800m, 0m), ImpactMath.Build(3000m, 1, 1800m, 0m) });
+        Assert.Equal(4000m, s.Sales);
+        Assert.Equal(35.0m, s.MarginPct);                         // 1400 / 4000, not the average of 20 and 40
+    }
+}
+
+public class AiImpactServiceTests
+{
+    private static readonly DateTime Now = new(2026, 10, 20, 12, 0, 0);
+    private static readonly DateTime Switch = new(2026, 10, 15);     // 5 full days after it
+
+    private sealed class World
+    {
+        public TestAppDbContext Db;
+        public AiImpactService Svc;
+        public Warehouse A, B;
+        public Product P;
+    }
+
+    private static async Task<World> CreateAsync(bool controlBranch = true)
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        var a = new Warehouse { WarehouseName = "AI branch", Email = "a@x.test", Phone = "1", Address = "a" };
+        var b = new Warehouse { WarehouseName = "Control branch", Email = "b@x.test", Phone = "1", Address = "b" };
+        db.Warehouses.AddRange(a, b);
+        await db.SaveChangesAsync();
+        var p = PricingFixtures.NewProduct(price: 100m, cost: 60m, monitorExpiry: false);
+        db.Products.Add(p);
+        await db.SaveChangesAsync();
+        if (controlBranch) db.AiBranchSettings.Add(new AiBranchSetting { WarehouseId = b.Id, PricingEnabled = false, UpdatedAt = Now });
+        await db.SaveChangesAsync();
+        return new World { Db = db, Svc = new AiImpactService(db), A = a, B = b, P = p };
+    }
+
+    private static async Task Day(World w, Warehouse wh, DateTime day, decimal sales, decimal cost, decimal writeOff = 0m)
+    {
+        var when = day.AddHours(10);
+        var sale = new Sale { WarehouseId = wh.Id, SaleDate = when, TotalAmount = sales, PaymentMethod = "Cash" };
+        w.Db.Sales.Add(sale);
+        w.Db.InventoryTransactions.Add(new InventoryTransaction { TransactionType = "SALE_OUT", WarehouseId = wh.Id, ProductId = w.P.Id, QtyOut = 1, UnitCost = cost, TransactionDate = when });
+        if (writeOff > 0m)
+            w.Db.InventoryTransactions.Add(new InventoryTransaction { TransactionType = ExpiryTransactionTypes.WriteOff, WarehouseId = wh.Id, ProductId = w.P.Id, QtyOut = 1, UnitCost = writeOff, TransactionDate = when });
+        await w.Db.SaveChangesAsync();
+    }
+
+    private static void AiChange(World w, Warehouse wh, DateTime when, bool markdown = true) =>
+        w.Db.PriceChanges.Add(new PriceChange { WarehouseId = wh.Id, ProductId = w.P.Id, PriceBefore = 100m, PriceAfter = 90m, Source = PriceChangeSource.Ai, Status = PriceChangeStatus.Applied, CreatedAt = when,
+            BatchId = markdown ? 1 : null, EndsAt = markdown ? when.AddDays(1) : null });
+
+    private static async Task Seed(World w)
+    {
+        for (var i = 1; i <= 5; i++)
+        {
+            await Day(w, w.A, Switch.AddDays(-i), 1000m, 800m, 25m);      // before: margin 20%
+            await Day(w, w.B, Switch.AddDays(-i), 1000m, 800m, 25m);
+            await Day(w, w.A, Switch.AddDays(i - 1), 1000m, 720m, 5m);    // after: margin 28%, less waste
+            await Day(w, w.B, Switch.AddDays(i - 1), 1000m, 790m, 25m);   // after: margin 21%, waste unchanged
+        }
+        AiChange(w, w.A, Switch.AddHours(9));
+        await w.Db.SaveChangesAsync();
+    }
+
+    private static T Get<T>(object o, string name) => (T)o.GetType().GetProperty(name)!.GetValue(o)!;
+
+    [Fact]
+    public async Task Nothing_to_compare_before_the_AI_has_changed_a_price()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var r = await w.Svc.GetAsync(14, null, Now);
+        Assert.False(Get<bool>(r, "available"));
+        Assert.Contains("has not changed any price", Get<string>(r, "message"));
+    }
+
+    [Fact]
+    public async Task Too_early_until_three_full_days_have_passed()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        AiChange(w, w.A, Now.AddDays(-2));
+        await w.Db.SaveChangesAsync();
+        var r = await w.Svc.GetAsync(14, null, Now);
+        Assert.False(Get<bool>(r, "available"));
+        Assert.Contains("Too early", Get<string>(r, "message"));
+    }
+
+    [Fact]
+    public async Task The_company_before_and_after_use_equal_windows_around_the_first_applied_AI_change()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await Seed(w);
+        var r = await w.Svc.GetAsync(14, null, Now);
+        Assert.True(Get<bool>(r, "available"));
+        Assert.Equal(5, Get<int>(r, "windowDays"));
+        Assert.Equal(Switch, Get<DateTime>(r, "switchDate"));
+        var before = Get<ImpactMetrics>(Get<object>(r, "before"), "metrics");
+        var after = Get<ImpactMetrics>(Get<object>(r, "after"), "metrics");
+        Assert.Equal(10000m, before.Sales);
+        Assert.Equal(10000m, after.Sales);
+        Assert.Equal(20.0m, before.MarginPct);
+        Assert.Equal(24.5m, after.MarginPct);         // (1000-720 + 1000-790) / 2000 per day
+        Assert.Equal(4.5m, Get<decimal?>(Get<object>(r, "change"), "marginPts"));
+    }
+
+    [Fact]
+    public async Task AI_branches_are_compared_with_control_branches_by_difference_in_differences()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await Seed(w);
+        var c = Get<object>(await w.Svc.GetAsync(14, null, Now), "control");
+        Assert.True(Get<bool>(c, "available"));
+        var d = Get<object>(c, "difference");
+        Assert.Equal(7.0m, Get<decimal?>(d, "marginPts"));       // AI +8.0 points, control +1.0
+        Assert.True(Get<decimal?>(d, "wastePts") < 0);           // AI waste fell, control waste did not
+        Assert.Contains("relative to the control", Get<string>(c, "reading"));
+    }
+
+    [Fact]
+    public async Task With_no_control_branch_it_says_how_to_set_one_up()
+    {
+        var w = await CreateAsync(controlBranch: false);
+        await using var _ = w.Db;
+        await Seed(w);
+        var c = Get<object>(await w.Svc.GetAsync(14, null, Now), "control");
+        Assert.False(Get<bool>(c, "available"));
+        Assert.Contains("No branch is set aside as a control", Get<string>(c, "message"));
+    }
+
+    [Fact]
+    public async Task A_switched_off_branch_that_the_AI_priced_during_the_period_is_not_a_clean_control()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await Seed(w);
+        AiChange(w, w.B, Switch.AddDays(2));
+        await w.Db.SaveChangesAsync();
+        var r = await w.Svc.GetAsync(14, null, Now);
+        Assert.False(Get<bool>(Get<object>(r, "control"), "available"));
+        Assert.Contains(Get<IEnumerable<string>>(r, "caveats"), s => s.StartsWith("Left out of the control") && s.Contains("Control branch"));
+    }
+
+    [Fact]
+    public async Task A_list_price_change_moves_every_branch_so_it_cannot_make_an_AI_branch_and_it_says_so()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        for (var i = 1; i <= 5; i++) { await Day(w, w.A, Switch.AddDays(-i), 1000m, 800m); await Day(w, w.B, Switch.AddDays(-i), 1000m, 800m); await Day(w, w.A, Switch.AddDays(i - 1), 1000m, 750m); await Day(w, w.B, Switch.AddDays(i - 1), 1000m, 750m); }
+        AiChange(w, w.A, Switch.AddHours(9), markdown: false);
+        await w.Db.SaveChangesAsync();
+        var r = await w.Svc.GetAsync(14, null, Now);
+        Assert.True(Get<bool>(r, "available"));
+        Assert.Equal(5.0m, Get<decimal?>(Get<object>(r, "change"), "marginPts"));       // the company moved
+        Assert.False(Get<bool>(Get<object>(r, "control"), "available"));                  // but no branch can be called an AI branch
+        Assert.Contains(Get<IEnumerable<string>>(r, "caveats"), s => s.Contains("same at every branch"));
+    }
+
+    [Fact]
+    public async Task A_chosen_switch_date_overrides_the_first_AI_change_and_the_window_is_capped_by_the_days_asked()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await Seed(w);
+        var r = await w.Svc.GetAsync(3, Switch, Now);
+        Assert.Equal(3, Get<int>(r, "windowDays"));
+        Assert.Equal("chosen", Get<string>(r, "switchSource"));
+    }
+
+    [Fact]
+    public async Task Every_comparison_carries_the_not_proof_caveat()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await Seed(w);
+        Assert.Contains(Get<IEnumerable<string>>(await w.Svc.GetAsync(14, null, Now), "caveats"), s => s.StartsWith("Indicative, not proof"));
+    }
+}

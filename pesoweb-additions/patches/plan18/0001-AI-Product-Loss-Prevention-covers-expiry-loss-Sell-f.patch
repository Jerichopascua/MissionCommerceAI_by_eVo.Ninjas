+
+    private static CountInput Fast(World w, Product p, long batch, int daysLeft, decimal atRisk = 6, decimal discount = 20, string proposal = "Proposed") => new()
+    {
+        WarehouseId = w.Branch.Id, ProductId = p.Id, Kind = CountKinds.SellFast, BatchId = batch, ExpiryDate = Now.Date.AddDays(daysLeft), DaysLeft = daysLeft,
+        BatchQty = 12, RatePerDay = 2, UnitsAtRisk = atRisk, ValueAtRisk = atRisk * 60, SuggestedDiscountPct = discount, SuggestedPrice = 80m, ProposalStatus = proposal,
+        Score = atRisk * 60, Reason = "6 units may expire unsold"
+    };
+
+    [Fact]
+    public async Task Sell_fast_items_keep_their_expiry_fields_and_are_listed_apart_from_count_items()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { In(w, w.B, 5), Fast(w, w.A, 77, 2) }, Now);
+        var fast = Assert.Single(await w.Svc.ListAsync(CountStatus.Open, 50, CountKinds.SellFast));
+        Assert.Equal(CountKinds.SellFast, fast.Kind);
+        Assert.Equal(77L, fast.BatchId);
+        Assert.Equal(2, fast.DaysLeft);
+        Assert.Equal(6m, fast.UnitsAtRisk);
+        Assert.Equal(360m, fast.ValueAtRiskAtCost);
+        Assert.Equal(20m, fast.SuggestedDiscountPct);
+        Assert.Equal("Proposed", fast.ProposalStatus);
+        var counts = Assert.Single(await w.Svc.ListAsync(CountStatus.Open, 50, CountKinds.Count));
+        Assert.Equal(w.B.Id, counts.ProductId);
+        Assert.Equal(2, (await w.Svc.ListAsync(CountStatus.Open, 50)).Count);
+    }
+
+    [Fact]
+    public async Task A_sell_fast_item_needs_a_batch_and_a_handled_batch_returns_after_three_days_not_before()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        var noBatch = Fast(w, w.A, 0, 2);
+        noBatch.BatchId = null;
+        var (added, skipped) = await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { noBatch, Fast(w, w.A, 77, 2) }, Now);
+        Assert.Equal((1, 1), (added, skipped));
+        var id = (await w.Svc.ListAsync(CountStatus.Open, 5, CountKinds.SellFast)).Single().Id;
+        Assert.True((await w.Svc.DecideAsync(id, CountStatus.Handled, 1, Now)).Ok);
+        Assert.Equal((0, 1), await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { Fast(w, w.A, 77, 1) }, Now.AddDays(1)));
+        Assert.Equal((1, 0), await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { Fast(w, w.A, 77, 1) }, Now.AddDays(4)));
+    }
+
+    [Fact]
+    public async Task Handling_a_batch_does_not_stop_the_product_being_suggested_for_a_count()
+    {
+        var w = await CreateAsync();
+        await using var _ = w.Db;
+        await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { Fast(w, w.A, 77, 2) }, Now);
+        await w.Svc.DecideAsync((await w.Svc.ListAsync(CountStatus.Open, 5, CountKinds.SellFast)).Single().Id, CountStatus.Handled, 1, Now);
+        var (added, _) = await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { In(w, w.A, 10) }, Now.AddHours(1));
+        Assert.Equal(1, added);

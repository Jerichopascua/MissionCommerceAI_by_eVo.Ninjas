     public const string Dismissed = "Dismissed";
     public const string Superseded = "Superseded";    // a newer run replaced it
 }
 
+public static class CountKinds
+{
+    public const string Count = "Count";          // count this on the shelf first (hidden shrink)
+    public const string SellFast = "SellFast";    // this batch may expire unsold: sell it fast, perhaps at a discount (expiry loss)
+}
+
 // One "count this first" suggestion from AI Product Loss Prevention: a product at a branch where a shortage would cost the most and is least
 // likely to be explained by a record (stock delivered with no receiving report, then high-value fast movers).

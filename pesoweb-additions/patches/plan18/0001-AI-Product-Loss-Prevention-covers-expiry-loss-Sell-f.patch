+        await w.Db.SaveChangesAsync();
+        await w.Svc.ReplaceOpenAsync(new[] { w.Branch.Id }, new[] { Fast(w, w.A, 1, 2), Fast(w, w.B, 2, 10), Fast(w, w.C, 3, -1, discount: 0, proposal: null) }, Now);
+        var tasks = new HubTaskService(w.Db, new ApprovalQueueService(w.Db, new ListPriceService(w.Db, PricingFixtures.Publisher(w.Db))), new ReplenishService(w.Db), w.Svc);
+        var mine = await tasks.MineAsync(Now, lane => lane == ApprovalLanes.Store, 1);
+        var sell = mine.Items.Where(i => i.Kind == "SellFast").ToList();
+        Assert.Equal(3, sell.Count);

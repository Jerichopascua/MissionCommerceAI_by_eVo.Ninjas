@@ -34,6 +41,41 @@ public partial class CountSuggestion
     [StringLength(400)]
     public string Reason { get; set; }
 
+    // Count (default) or SellFast. The fields below are for SellFast: a batch with an expiry date that may not sell in time.
+    [Required]
+    [StringLength(10)]
+    public string Kind { get; set; } = CountKinds.Count;
+
+    public long? BatchId { get; set; }
+
+    public DateTime? ExpiryDate { get; set; }
+
+    // Days to the expiry date; negative means it has already expired (write it off).
+    public int? DaysLeft { get; set; }
+
+    [Column(TypeName = "decimal(18, 2)")]
+    public decimal? BatchQty { get; set; }
+
+    [Column(TypeName = "decimal(18, 3)")]
+    public decimal? RatePerDay { get; set; }
+
+    // Units expected to be left unsold at the expiry date, and what they are worth at cost.
+    [Column(TypeName = "decimal(18, 2)")]
+    public decimal? UnitsAtRisk { get; set; }
+
+    [Column(TypeName = "decimal(18, 2)")]
+    public decimal? ValueAtRisk { get; set; }
+
+    [Column(TypeName = "decimal(9, 2)")]
+    public decimal? SuggestedDiscountPct { get; set; }
+
+    [Column(TypeName = "decimal(18, 2)")]
+    public decimal? SuggestedPrice { get; set; }
+
+    // What happened to the markdown the AI proposed for it: Proposed (waiting in the Approval Center), Applied, or Refused: <code>.
+    [StringLength(60)]
+    public string ProposalStatus { get; set; }
+
     [Required]
     [StringLength(12)]
     public string Status { get; set; }

+using GoPosify.Services;
+using GoPosify.Services.Interfaces;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+// Purchase receiving now passes the line's unit cost to the batch. These tests pin the service behavior it relies on.
+public class InventoryBatchCostTests
+{
+    private static readonly DateTime Expiry = new(2026, 11, 1);
+
+    private static BatchReceiveInput Input(int productId, decimal qty, decimal? cost, string batchNo = "B-1")
+        => new()
+        {
+            TenantId = 5, WarehouseId = 1, ProductId = productId, Quantity = qty, UnitCost = cost,
+            BatchNo = batchNo, ExpiryDate = Expiry, TransactionType = "PURCHASE_IN"
+        };
+
+    private static async Task<(TestAppDbContext db, InventoryBatchService svc, int productId)> CreateAsync()
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        var product = PricingFixtures.NewProduct();
+        db.Products.Add(product);
+        await db.SaveChangesAsync();
+        return (db, new InventoryBatchService(db), product.Id);
+    }
+
+    [Fact]
+    public async Task Receiving_with_a_unit_cost_stores_it_on_the_batch_and_the_ledger()
+    {
+        var (db, svc, productId) = await CreateAsync();
+        await using var _ = db;
+
+        await svc.ReceiveAsync(Input(productId, 20, 42m));
+
+        var batch = Assert.Single(db.ProductBatches.ToList());
+        Assert.Equal(42m, batch.Cost);
+        var tx = Assert.Single(db.InventoryTransactions.ToList());
+        Assert.Equal(42m, tx.UnitCost);
+        Assert.Equal(20m, tx.QtyIn);
+    }
+
+    [Fact]
+    public async Task Receiving_into_an_existing_batch_without_a_cost_keeps_the_old_cost()
+    {
+        var (db, svc, productId) = await CreateAsync();
+        await using var _ = db;
+        await svc.ReceiveAsync(Input(productId, 20, 42m));
+
+        await svc.ReceiveAsync(Input(productId, 5, null));
+
+        var batch = Assert.Single(db.ProductBatches.ToList());
+        Assert.Equal(25m, batch.QtyOnHand);
+        Assert.Equal(42m, batch.Cost);
+    }
+
+    [Fact]
+    public async Task Receiving_into_an_existing_batch_with_a_new_cost_uses_the_latest_cost()
+    {
+        var (db, svc, productId) = await CreateAsync();
+        await using var _ = db;
+        await svc.ReceiveAsync(Input(productId, 20, 42m));
+
+        await svc.ReceiveAsync(Input(productId, 5, 50m));
+
+        var batch = Assert.Single(db.ProductBatches.ToList());
+        Assert.Equal(25m, batch.QtyOnHand);
+        Assert.Equal(50m, batch.Cost);      // latest cost wins; it is not a weighted average
+    }
+
+    [Fact]
+    public async Task A_different_batch_number_gets_its_own_cost()
+    {
+        var (db, svc, productId) = await CreateAsync();
+        await using var _ = db;
+
+        await svc.ReceiveAsync(Input(productId, 10, 40m, "B-1"));
+        await svc.ReceiveAsync(Input(productId, 10, 55m, "B-2"));
+
+        var costs = db.ProductBatches.OrderBy(b => b.BatchNo).Select(b => b.Cost).ToList();
+        Assert.Equal(new decimal?[] { 40m, 55m }, costs);
+    }
+}

@@ -0,0 +1,179 @@
+using GoPosify.Data;
+using GoPosify.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GoPosify.Services;
+
+public class OverviewMetrics
+{
+    public decimal SalesToday { get; set; }
+    public int TransactionsToday { get; set; }
+    public int OpenShifts { get; set; }
+    public decimal CashVarianceToday { get; set; }
+    public decimal ExpiryAtRiskPesos { get; set; }
+    public decimal ExpiredUnwrittenPesos { get; set; }
+    public decimal WrittenOffPesos { get; set; }
+    public int ActiveMarkdowns { get; set; }
+    public int OpenExceptions { get; set; }
+
+    public void Add(OverviewMetrics o)
+    {
+        SalesToday += o.SalesToday;
+        TransactionsToday += o.TransactionsToday;
+        OpenShifts += o.OpenShifts;
+        CashVarianceToday += o.CashVarianceToday;
+        ExpiryAtRiskPesos += o.ExpiryAtRiskPesos;
+        ExpiredUnwrittenPesos += o.ExpiredUnwrittenPesos;
+        WrittenOffPesos += o.WrittenOffPesos;
+        ActiveMarkdowns += o.ActiveMarkdowns;
+        OpenExceptions += o.OpenExceptions;
+    }
+}
+
+public sealed class BranchOverview : OverviewMetrics
+{
+    public int WarehouseId { get; set; }
+    public string Name { get; set; }
+}
+
+public sealed class GroupTotals : OverviewMetrics
+{
+    public int Branches { get; set; }
+}
+
+public sealed class TenantOverview
+{
+    public int TenantId { get; set; }
+    public string CompanyName { get; set; }
+    public int Subscription { get; set; }
+    public int BranchCount { get; set; }
+    public GroupTotals Totals { get; set; } = new();
+    public List<BranchOverview> Branches { get; set; } = new();
+}
+
+public sealed class GroupOverview
+{
+    public DateTime GeneratedAt { get; set; }
+    public GroupTotals Totals { get; set; } = new();
+    public List<TenantOverview> Tenants { get; set; } = new();
+}
+
+public interface IGroupOverviewService
+{
+    Task<GroupOverview> GetAsync(DateTime now);
+}
+
+// Read-only roll-up across every tenant (company) and branch for the central company. It bypasses the tenant
+// query filter on purpose, so it must only ever be exposed to the root SuperAdmin. It never writes.
+public sealed class GroupOverviewService : IGroupOverviewService
+{
+    private const int CriticalDays = 2;
+
+    private readonly AppDBContext _db;
+
+    public GroupOverviewService(AppDBContext db)
+    {
+        _db = db;
+    }
+
+    public async Task<GroupOverview> GetAsync(DateTime now)
+    {
+        var today = now.Date;
+        var tomorrow = today.AddDays(1);
+
+        var settings = await _db.AppSettings.IgnoreQueryFilters().AsNoTracking()
+            .Select(s => new { s.TenantID, s.CompanyName }).ToListAsync();
+        var warehouses = await _db.Warehouses.IgnoreQueryFilters().AsNoTracking()
+            .Select(w => new { w.TenantID, w.Id, w.WarehouseName }).ToListAsync();
+        var users = await _db.Users.IgnoreQueryFilters().AsNoTracking()
+            .Select(u => new { u.TenantID, u.Id, u.Subscription }).ToListAsync();
+
+        var sales = await _db.Sales.IgnoreQueryFilters().AsNoTracking()
+            .Where(s => s.SaleDate >= today && s.SaleDate < tomorrow)
+            .GroupBy(s => new { s.TenantID, s.WarehouseId })
+            .Select(g => new { g.Key.TenantID, g.Key.WarehouseId, Total = g.Sum(s => s.TotalAmount), Count = g.Count() })
+            .ToListAsync();
+        var openShifts = await _db.CashShifts.IgnoreQueryFilters().AsNoTracking()
+            .Where(s => s.Status == CashShiftStatus.Open)
+            .GroupBy(s => new { s.TenantID, s.WarehouseId })
+            .Select(g => new { g.Key.TenantID, g.Key.WarehouseId, Count = g.Count() })
+            .ToListAsync();
+        var variances = await _db.CashShifts.IgnoreQueryFilters().AsNoTracking()
+            .Where(s => s.Status == CashShiftStatus.Closed && s.ClosedAt >= today && s.ClosedAt < tomorrow)
+            .GroupBy(s => new { s.TenantID, s.WarehouseId })
+            .Select(g => new { g.Key.TenantID, g.Key.WarehouseId, Total = g.Sum(s => s.Variance ?? 0m) })
+            .ToListAsync();
+        var markdowns = await _db.ActiveMarkdowns.IgnoreQueryFilters().AsNoTracking()
+            .Where(m => m.IsActive)
+            .GroupBy(m => new { m.TenantID, m.WarehouseId })
+            .Select(g => new { g.Key.TenantID, g.Key.WarehouseId, Count = g.Count() })
+            .ToListAsync();
+        var exceptions = await _db.ExceptionRecords.IgnoreQueryFilters().AsNoTracking()
+            .Where(e => e.Status == ExceptionStatus.Open)
+            .GroupBy(e => new { e.TenantID, e.WarehouseId })
+            .Select(g => new { g.Key.TenantID, g.Key.WarehouseId, Count = g.Count() })
+            .ToListAsync();
+        var writeOffs = (await _db.InventoryTransactions.IgnoreQueryFilters().AsNoTracking()
+                .Where(t => t.TransactionType == ExpiryTransactionTypes.WriteOff)
+                .Select(t => new { t.TenantID, t.WarehouseId, t.QtyOut, t.UnitCost }).ToListAsync())
+            .GroupBy(t => new { t.TenantID, t.WarehouseId })
+            .ToDictionary(g => (g.Key.TenantID, g.Key.WarehouseId), g => g.Sum(t => t.QtyOut * (t.UnitCost ?? 0m)));
+
+        var batches = await _db.ProductBatches.IgnoreQueryFilters().AsNoTracking().Include(b => b.Product)
+            .Where(b => b.QtyOnHand > 0 && b.ExpiryDate.HasValue && b.Product.MonitorExpiry).ToListAsync();
+        var atRisk = new Dictionary<(int, int), decimal>();
+        var expiredUnwritten = new Dictionary<(int, int), decimal>();
+        foreach (var b in batches)
+        {
+            var days = (b.ExpiryDate.Value.Date - today).Days;
+            var alert = b.Product.ExpiryAlertDays > 0 ? b.Product.ExpiryAlertDays : 30;
+            var pesos = b.QtyOnHand * (b.Cost ?? b.Product.Cost);
+            var key = (b.TenantID, b.WarehouseId);
+            if (days < 0) expiredUnwritten[key] = expiredUnwritten.GetValueOrDefault(key) + pesos;
+            else if (days <= alert) atRisk[key] = atRisk.GetValueOrDefault(key) + pesos;
+        }
+
+        var names = settings.GroupBy(s => s.TenantID).ToDictionary(g => g.Key, g => g.First().CompanyName);
+        var subscriptions = users.GroupBy(u => u.TenantID).ToDictionary(g => g.Key, g => g.OrderBy(u => u.Id).First().Subscription);
+        var tenantIds = names.Keys.Union(warehouses.Select(w => w.TenantID)).Distinct().OrderBy(x => x).ToList();
+
+        var overview = new GroupOverview { GeneratedAt = now };
+        foreach (var tenantId in tenantIds)
+        {
+            var tenant = new TenantOverview
+            {
+                TenantId = tenantId,
+                CompanyName = names.TryGetValue(tenantId, out var n) ? n : $"Tenant {tenantId}",
+                Subscription = subscriptions.TryGetValue(tenantId, out var sub) ? sub : 5
+            };
+
+            foreach (var w in warehouses.Where(w => w.TenantID == tenantId).OrderBy(w => w.Id))
+            {
+                var key = (tenantId, w.Id);
+                var branch = new BranchOverview { WarehouseId = w.Id, Name = w.WarehouseName };
+                var s = sales.FirstOrDefault(x => x.TenantID == tenantId && x.WarehouseId == w.Id);
+                if (s != null) { branch.SalesToday = s.Total; branch.TransactionsToday = s.Count; }
+                branch.OpenShifts = openShifts.FirstOrDefault(x => x.TenantID == tenantId && x.WarehouseId == w.Id)?.Count ?? 0;
+                branch.CashVarianceToday = variances.FirstOrDefault(x => x.TenantID == tenantId && x.WarehouseId == w.Id)?.Total ?? 0m;
+                branch.ActiveMarkdowns = markdowns.FirstOrDefault(x => x.TenantID == tenantId && x.WarehouseId == w.Id)?.Count ?? 0;
+                branch.OpenExceptions = exceptions.FirstOrDefault(x => x.TenantID == tenantId && x.WarehouseId == w.Id)?.Count ?? 0;
+                branch.ExpiryAtRiskPesos = atRisk.GetValueOrDefault(key);
+                branch.ExpiredUnwrittenPesos = expiredUnwritten.GetValueOrDefault(key);
+                branch.WrittenOffPesos = writeOffs.GetValueOrDefault(key);
+                tenant.Branches.Add(branch);
+                tenant.Totals.Add(branch);
+            }
+
+            // Exceptions that are not tied to a branch still count for the company.
+            tenant.Totals.OpenExceptions += exceptions.Where(x => x.TenantID == tenantId && x.WarehouseId == null).Sum(x => x.Count);
+
+            tenant.BranchCount = tenant.Branches.Count;
+            tenant.Totals.Branches = tenant.BranchCount;
+            overview.Tenants.Add(tenant);
+            overview.Totals.Add(tenant.Totals);
+            overview.Totals.Branches += tenant.BranchCount;
+        }
+
+        return overview;
+    }
+}
-- 

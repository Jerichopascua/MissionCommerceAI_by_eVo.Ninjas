+using GoPosify.Models;
+using GoPosify.Services;
+using Microsoft.EntityFrameworkCore;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class GroupOverviewServiceTests
+{
+    private static readonly DateTime Now = new(2026, 10, 20, 15, 0, 0);
+
+    // InMemory enforces [Required]: AppSetting has many required strings.
+    // AppSetting.Id is ValueGeneratedNever, so every company needs its own explicit id.
+    private static AppSetting Setting(int id, string company) => new()
+    {
+        Id = id, CompanyName = company, AppName = "PesoWeb", Logo = "-", AppIcon = "-", Copyright = "-", CompanyEmail = "c@example.test",
+        CompanyPhone = "-", CompanyAddress = "-", CompanyTaxNumber = "-", DefaultTimezone = "Asia/Manila", DefaultLanguage = "en",
+        DefaultCurrency = "PHP", MailProtocol = "-", MailEncryption = "-", MailHost = "-", MailUserName = "-", MailPassword = "-",
+        InvoiceTemplate = "-", ThemeLayout = "-", ThemeColor = "-", ThemeAppBar = "-", ThemeSideBar = "-"
+    };
+
+    private static Warehouse Branch(string name) => new() { WarehouseName = name, Address = "-", Email = "b@example.test", Phone = "-" };
+
+    private static User Owner(string name, int subscription) => new()
+    {
+        FullName = name, UserName = name, Email = name + "@example.test", Password = "x", Subscription = subscription
+    };
+
+    private sealed class World
+    {
+        public string Name;
+        public int A1, A2, B1, B2, C1;       // warehouse ids: company 5 (A1, A2), company 6 (B1, B2), company 7 (C1, idle)
+    }
+
+    private static async Task<World> SeedAsync()
+    {
+        var name = TestAppDbContext.NewDbName();
+        var w = new World { Name = name };
+
+        // company 5 "Alpha"
+        await using (var a = new TestAppDbContext(name, 5))
+        {
+            a.AppSettings.Add(Setting(5, "Alpha"));
+            a.Users.Add(Owner("alpha", 4));
+            var wa1 = Branch("A1"); var wa2 = Branch("A2");
+            a.Warehouses.AddRange(wa1, wa2);
+            var milk = PricingFixtures.NewProduct(price: 10m, cost: 5m);
+            a.Products.Add(milk);
+            await a.SaveChangesAsync();
+            w.A1 = wa1.Id; w.A2 = wa2.Id;
+
+            a.Sales.AddRange(
+                new Sale { WarehouseId = w.A1, CustomerId = 1, PaymentMethod = "Cash", SaleDate = Now.AddHours(-3), TotalAmount = 100m },
+                new Sale { WarehouseId = w.A1, CustomerId = 1, PaymentMethod = "Cash", SaleDate = Now.AddHours(-1), TotalAmount = 50m },
+                new Sale { WarehouseId = w.A1, CustomerId = 1, PaymentMethod = "Cash", SaleDate = Now.AddDays(-1), TotalAmount = 999m });   // yesterday, ignored
+            a.CashShifts.Add(new CashShift { WarehouseId = w.A1, CashierId = 1, Status = CashShiftStatus.Open, OpenedAt = Now.AddHours(-5) });
+            a.ProductBatches.AddRange(
+                PricingFixtures.NewBatch(milk.Id, Now.Date.AddDays(-1), qty: 10, cost: 5, warehouseId: w.A1),   // expired: 50 unwritten
+                PricingFixtures.NewBatch(milk.Id, Now.Date.AddDays(1), qty: 20, cost: 5, warehouseId: w.A1));   // at risk: 100
+            a.InventoryTransactions.Add(new InventoryTransaction { WarehouseId = w.A1, ProductId = milk.Id, TransactionType = ExpiryTransactionTypes.WriteOff, QtyOut = 3m, UnitCost = 5m });   // 15 written off
+            a.ActiveMarkdowns.AddRange(
+                new ActiveMarkdown { WarehouseId = w.A1, ProductId = milk.Id, BatchId = 1, Price = 8m, IsActive = true, StartsAt = Now },
+                new ActiveMarkdown { WarehouseId = w.A1, ProductId = milk.Id, BatchId = 2, Price = 8m, IsActive = false, StartsAt = Now });
+            a.ExceptionRecords.AddRange(
+                new ExceptionRecord { WarehouseId = w.A1, Type = ExceptionTypes.LowStock, Severity = "Low", Status = ExceptionStatus.Open, Source = "System", DetectedAt = Now },
+                new ExceptionRecord { WarehouseId = w.A1, Type = ExceptionTypes.NegativeStock, Severity = "High", Status = ExceptionStatus.Open, Source = "System", DetectedAt = Now },
+                new ExceptionRecord { WarehouseId = w.A1, Type = ExceptionTypes.ExpiredStock, Severity = "High", Status = ExceptionStatus.Resolved, Source = "System", DetectedAt = Now },   // resolved: not counted
+                new ExceptionRecord { WarehouseId = null, Type = ExceptionTypes.CashVariance, Severity = "High", Status = ExceptionStatus.Open, Source = "System", DetectedAt = Now });      // company-level
+            await a.SaveChangesAsync();
+        }
+
+        // company 6 "Beta"
+        await using (var b = new TestAppDbContext(name, 6))
+        {
+            b.AppSettings.Add(Setting(6, "Beta"));
+            b.Users.Add(Owner("beta", 3));
+            var wb1 = Branch("B1"); var wb2 = Branch("B2");
+            b.Warehouses.AddRange(wb1, wb2);
+            var oil = PricingFixtures.NewProduct(price: 100m, cost: 10m);
+            b.Products.Add(oil);
+            await b.SaveChangesAsync();
+            w.B1 = wb1.Id; w.B2 = wb2.Id;
+
+            b.Sales.Add(new Sale { WarehouseId = w.B1, CustomerId = 1, PaymentMethod = "Cash", SaleDate = Now.AddHours(-2), TotalAmount = 70m });
+            b.CashShifts.AddRange(
+                new CashShift { WarehouseId = w.B1, CashierId = 2, Status = CashShiftStatus.Closed, OpenedAt = Now.AddHours(-9), ClosedAt = Now.AddHours(-1), Variance = -30m },
+                new CashShift { WarehouseId = w.B1, CashierId = 3, Status = CashShiftStatus.Closed, OpenedAt = Now.AddDays(-2), ClosedAt = Now.AddDays(-1), Variance = -999m });   // yesterday, ignored
+            b.ProductBatches.Add(PricingFixtures.NewBatch(oil.Id, Now.Date.AddDays(5), qty: 4, cost: 10, warehouseId: w.B1));   // at risk: 40
+            b.ActiveMarkdowns.Add(new ActiveMarkdown { WarehouseId = w.B1, ProductId = oil.Id, BatchId = 3, Price = 80m, IsActive = true, StartsAt = Now });
+            b.ExceptionRecords.Add(new ExceptionRecord { WarehouseId = w.B1, Type = ExceptionTypes.LowStock, Severity = "Low", Status = ExceptionStatus.Open, Source = "System", DetectedAt = Now });
+            await b.SaveChangesAsync();
+        }
+
+        // company 7 "Gamma": one idle branch, no activity
+        await using (var c = new TestAppDbContext(name, 7))
+        {
+            c.AppSettings.Add(Setting(7, "Gamma"));
+            var wc1 = Branch("C1");
+            c.Warehouses.Add(wc1);
+            await c.SaveChangesAsync();
+            w.C1 = wc1.Id;
+        }
+
+        return w;
+    }
+
+    [Fact]
+    public async Task Each_branch_reports_its_own_numbers()
+    {
+        var w = await SeedAsync();
+        await using var db = new TestAppDbContext(w.Name, 1);
+
+        var o = await new GroupOverviewService(db).GetAsync(Now);
+
+        var alpha = o.Tenants.Single(t => t.TenantId == 5);
+        var a1 = alpha.Branches.Single(b => b.WarehouseId == w.A1);
+        Assert.Equal("A1", a1.Name);
+        Assert.Equal(150m, a1.SalesToday);
+        Assert.Equal(2, a1.TransactionsToday);
+        Assert.Equal(1, a1.OpenShifts);
+        Assert.Equal(100m, a1.ExpiryAtRiskPesos);
+        Assert.Equal(50m, a1.ExpiredUnwrittenPesos);
+        Assert.Equal(15m, a1.WrittenOffPesos);
+        Assert.Equal(1, a1.ActiveMarkdowns);
+        Assert.Equal(2, a1.OpenExceptions);
+
+        var b1 = o.Tenants.Single(t => t.TenantId == 6).Branches.Single(b => b.WarehouseId == w.B1);
+        Assert.Equal(70m, b1.SalesToday);
+        Assert.Equal(-30m, b1.CashVarianceToday);          // only the shift closed today
+        Assert.Equal(40m, b1.ExpiryAtRiskPesos);
+        Assert.Equal(1, b1.ActiveMarkdowns);
+        Assert.Equal(1, b1.OpenExceptions);
+    }
+
+    [Fact]
+    public async Task Companies_and_branches_with_no_activity_still_appear_with_zeros()
+    {
+        var w = await SeedAsync();
+        await using var db = new TestAppDbContext(w.Name, 1);
+
+        var o = await new GroupOverviewService(db).GetAsync(Now);
+
+        var gamma = o.Tenants.Single(t => t.TenantId == 7);
+        Assert.Equal("Gamma", gamma.CompanyName);
+        Assert.Equal(1, gamma.BranchCount);
+        var c1 = Assert.Single(gamma.Branches);
+        Assert.Equal(0m, c1.SalesToday);
+        Assert.Equal(0, c1.OpenExceptions);
+        Assert.Equal(0m, gamma.Totals.ExpiryAtRiskPesos);
+        var a2 = o.Tenants.Single(t => t.TenantId == 5).Branches.Single(b => b.WarehouseId == w.A2);
+        Assert.Equal(0m, a2.SalesToday);
+    }
+
+    [Fact]
+    public async Task Company_totals_sum_the_branches_and_include_company_level_exceptions()
+    {
+        var w = await SeedAsync();
+        await using var db = new TestAppDbContext(w.Name, 1);
+
+        var o = await new GroupOverviewService(db).GetAsync(Now);
+
+        var alpha = o.Tenants.Single(t => t.TenantId == 5);
+        Assert.Equal(2, alpha.BranchCount);
+        Assert.Equal(150m, alpha.Totals.SalesToday);
+        Assert.Equal(3, alpha.Totals.OpenExceptions);        // 2 on A1 + 1 not tied to a branch
+        Assert.Equal(4, alpha.Subscription);                 // owner's tier
+        Assert.Equal(3, o.Tenants.Single(t => t.TenantId == 6).Subscription);
+    }
+
+    [Fact]
+    public async Task Group_totals_equal_the_sum_of_the_companies_and_nothing_leaks_across()
+    {
+        var w = await SeedAsync();
+        await using var db = new TestAppDbContext(w.Name, 1);
+
+        var o = await new GroupOverviewService(db).GetAsync(Now);
+
+        Assert.Equal(3, o.Tenants.Count);
+        Assert.Equal(o.Tenants.Sum(t => t.Totals.SalesToday), o.Totals.SalesToday);
+        Assert.Equal(220m, o.Totals.SalesToday);
+        Assert.Equal(3, o.Totals.TransactionsToday);
+        Assert.Equal(140m, o.Totals.ExpiryAtRiskPesos);       // 100 + 40
+        Assert.Equal(2, o.Totals.ActiveMarkdowns);
+        Assert.Equal(4, o.Totals.OpenExceptions);             // 3 (Alpha) + 1 (Beta)
+        Assert.Equal(5, o.Totals.Branches);
+        Assert.Equal(1, o.Totals.OpenShifts);
+        Assert.Equal(-30m, o.Totals.CashVarianceToday);
+        // Alpha's branches never contain Beta's sales
+        Assert.DoesNotContain(o.Tenants.Single(t => t.TenantId == 5).Branches, b => b.WarehouseId == w.B1);
+    }
+
+    [Fact]
+    public async Task The_overview_does_not_modify_any_data()
+    {
+        var w = await SeedAsync();
+        await using var db = new TestAppDbContext(w.Name, 1);
+        int Rows() => db.Sales.IgnoreQueryFilters().Count() + db.CashShifts.IgnoreQueryFilters().Count()
+                      + db.ProductBatches.IgnoreQueryFilters().Count() + db.ExceptionRecords.IgnoreQueryFilters().Count()
+                      + db.InventoryTransactions.IgnoreQueryFilters().Count() + db.ActiveMarkdowns.IgnoreQueryFilters().Count();
+        var before = Rows();
+
+        await new GroupOverviewService(db).GetAsync(Now);
+
+        Assert.Equal(before, Rows());
+        Assert.False(db.ChangeTracker.HasChanges());
+    }
+}

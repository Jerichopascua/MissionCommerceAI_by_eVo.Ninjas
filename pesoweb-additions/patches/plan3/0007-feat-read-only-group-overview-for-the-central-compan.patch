+using GoPosify.Data;
+using GoPosify.Services;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+namespace GoPosify.Controllers
+{
+    // Central-company monitoring: every company (tenant) and branch in one read-only view.
+    // Root SuperAdmin only. Never writes.
+    [Route("api/[controller]/[action]")]
+    [ApiController]
+    [Authorize]
+    public class GroupController : BaseController
+    {
+        private readonly IGroupOverviewService _group;
+
+        public GroupController(AppDBContext dbContext, IGroupOverviewService group) : base(dbContext)
+        {
+            _group = group;
+        }
+
+        // GET: api/group/overview
+        [HttpGet]
+        [Authorize(Policy = "Subscription.Tenants")]
+        public async Task<IActionResult> Overview()
+        {
+            try
+            {
+                var current = await GetCurrentUserRecordAsync();
+                if (!IsRootSuperAdmin(current))
+                {
+                    return Forbid();
+                }
+
+                return Ok(await _group.GetAsync(CurrentDateTime()));
+            }
+            catch (Exception ex)
+            {
+                return HandleServerError(ex, "An error occurred while building the group overview.", "Group", "Overview");
+            }
+        }
+    }
+}

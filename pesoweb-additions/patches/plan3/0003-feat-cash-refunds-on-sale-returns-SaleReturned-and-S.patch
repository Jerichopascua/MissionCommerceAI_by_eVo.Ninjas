+    public async Task<CashMovement> RecordCashRefundAsync(int warehouseId, int cashierId, string originalPaymentMethod, decimal amount, string referenceNo, DateTime now)
+    {
+        if (amount <= 0m || !string.Equals(originalPaymentMethod, "Cash", StringComparison.OrdinalIgnoreCase))
+        {
+            return null;
+        }
+
+        var shift = await _db.CashShifts.FirstOrDefaultAsync(s =>
+            s.CashierId == cashierId && s.WarehouseId == warehouseId && s.Status == CashShiftStatus.Open);
+        if (shift == null)
+        {
+            return null;
+        }
+
+        return await AddMovementAsync(shift.Id, CashMovementType.Refund, amount, "Sale return refunded in cash", referenceNo, cashierId, now);
+    }

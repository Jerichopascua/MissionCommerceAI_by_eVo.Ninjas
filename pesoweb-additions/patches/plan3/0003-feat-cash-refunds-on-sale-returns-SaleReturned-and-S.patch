@@ -0,0 +1,96 @@
+using GoPosify.Models;
+using GoPosify.Services;
+using Microsoft.AspNetCore.Http;
+using Retailo.Tests.Support;
+using Xunit;
+
+namespace Retailo.Tests;
+
+public class CashRefundTests
+{
+    private static readonly DateTime T0 = new(2026, 10, 20, 8, 0, 0);
+
+    private static (TestAppDbContext db, CashShiftService svc) Create()
+    {
+        var db = new TestAppDbContext(TestAppDbContext.NewDbName(), 5);
+        var publisher = new BusinessEventPublisher(db, new HttpContextAccessor { HttpContext = new DefaultHttpContext() });
+        return (db, new CashShiftService(db, publisher));
+    }
+
+    [Fact]
+    public async Task Cash_return_on_an_open_shift_records_a_refund_and_lowers_expected_cash()
+    {
+        var (db, svc) = Create();
+        await using var _ = db;
+        var shift = await svc.OpenAsync(1, 77, "POS-01", 1000m, T0);
+
+        var movement = await svc.RecordCashRefundAsync(1, 77, "Cash", 250m, "sr-9", T0.AddHours(1));
+
+        Assert.NotNull(movement);
+        Assert.Equal(CashMovementType.Refund, movement.MovementType);
+        Assert.Equal(250m, movement.Amount);
+        Assert.Equal("sr-9", movement.ReferenceNo);
+        Assert.Equal(shift.Id, movement.ShiftId);
+        Assert.Equal(750m, (await svc.SummarizeAsync(shift.Id)).ExpectedCash);
+    }
+
+    [Fact]
+    public async Task Payment_method_match_is_case_insensitive()
+    {
+        var (db, svc) = Create();
+        await using var _ = db;
+        await svc.OpenAsync(1, 77, "POS-01", 0m, T0);
+
+        Assert.NotNull(await svc.RecordCashRefundAsync(1, 77, "cash", 10m, "sr-1", T0));
+    }
+
+    [Theory]
+    [InlineData("GCash")]
+    [InlineData("Card")]
+    [InlineData(null)]
+    public async Task A_non_cash_original_payment_records_nothing(string method)
+    {
+        var (db, svc) = Create();
+        await using var _ = db;
+        await svc.OpenAsync(1, 77, "POS-01", 0m, T0);
+
+        Assert.Null(await svc.RecordCashRefundAsync(1, 77, method, 100m, "sr-2", T0));
+        Assert.Empty(db.CashMovements.ToList());
+    }
+
+    [Fact]
+    public async Task No_open_shift_for_that_cashier_and_branch_records_nothing()
+    {
+        var (db, svc) = Create();
+        await using var _ = db;
+        var other = await svc.OpenAsync(1, 99, "POS-02", 0m, T0);          // a different cashier is open
+        await svc.OpenAsync(2, 77, "POS-03", 0m, T0);                      // same cashier, other branch
+
+        Assert.Null(await svc.RecordCashRefundAsync(1, 77, "Cash", 100m, "sr-3", T0));
+        Assert.Empty(db.CashMovements.ToList());
+        Assert.Equal(0m, (await svc.SummarizeAsync(other.Id)).CashRefunds);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-5)]
+    public async Task A_zero_or_negative_amount_records_nothing(int amount)
+    {
+        var (db, svc) = Create();
+        await using var _ = db;
+        await svc.OpenAsync(1, 77, "POS-01", 0m, T0);
+
+        Assert.Null(await svc.RecordCashRefundAsync(1, 77, "Cash", amount, "sr-4", T0));
+    }
+
+    [Fact]
+    public async Task A_closed_shift_is_not_used()
+    {
+        var (db, svc) = Create();
+        await using var _ = db;
+        var shift = await svc.OpenAsync(1, 77, "POS-01", 100m, T0);
+        await svc.CloseAsync(shift.Id, 100m, null, T0.AddHours(8));
+
+        Assert.Null(await svc.RecordCashRefundAsync(1, 77, "Cash", 50m, "sr-5", T0.AddHours(9)));
+    }
+}

--- /dev/null
+++ b/ClientApp/src/app/ai/aicontrol/aicontrol.component.ts
@@ -0,0 +1,87 @@
+import { Component, Inject, OnDestroy, OnInit } from '@angular/core';
+import { HttpClient } from '@angular/common/http';
+import { AppService } from '../../services/app.service';
+
+// The owner's switchboard for the six AI features: switch each on or off, and ask the agent to run now.
+// The agent itself is a separate program; this screen only records what the owner wants and shows what the agent reported.
+@Component({
+  selector: 'app-aicontrol',
+  templateUrl: './aicontrol.component.html'
+})
+export class AiControlComponent implements OnInit, OnDestroy {
+  public features: any[] = [];
+  public loading = false;
+  public busyKey = '';
+  public error = '';
+  public message = '';
+  private timer: any = null;
+
+  constructor(
+    private http: HttpClient,
+    @Inject('BASE_URL') private baseUrl: string,
+    public app: AppService
+  ) { }
+
+  ngOnInit(): void {
+    this.load();
+    // While a run is waiting or running, look again every few seconds so the result appears by itself.
+    this.timer = setInterval(() => { if (this.features.some(f => f.openRun)) { this.load(true); } }, 4000);
+  }
+
+  ngOnDestroy(): void {
+    if (this.timer) { clearInterval(this.timer); }
+  }
+
+  public load(quiet = false): void {
+    if (!quiet) { this.loading = true; }
+    this.http.get<any[]>(this.baseUrl + 'api/ai/control').subscribe({
+      next: (r) => { this.features = r; this.loading = false; },
+      error: (e) => { this.error = this.messageOf(e, 'Could not load the AI features.'); this.loading = false; }
+    });
+  }
+
+  public get onCount(): number {
+    return this.features.filter(f => f.enabled).length;
+  }
+
+  public toggle(f: any): void {
+    if (this.busyKey) { return; }
+    const enabled = !f.enabled;
+    this.busyKey = f.key;
+    this.error = ''; this.message = '';
+    this.http.put<any[]>(this.baseUrl + 'api/ai/control/' + f.key, { enabled }).subscribe({
+      next: (r) => {
+        this.features = r; this.busyKey = '';
+        this.message = f.name + (enabled ? ' is on.' : ' is off. Its proposals are now refused and any waiting run was cancelled.');
+      },
+      error: (e) => { this.busyKey = ''; this.error = this.messageOf(e, 'Could not change the switch.'); this.load(); }
+    });
+  }
+
+  public run(f: any): void {
+    if (this.busyKey) { return; }
+    this.busyKey = f.key;
+    this.error = ''; this.message = '';
+    this.http.post<any>(this.baseUrl + 'api/ai/control/run/' + f.key, {}).subscribe({
+      next: () => { this.busyKey = ''; this.message = 'Run requested for ' + f.name + '. The agent picks it up when it next checks.'; this.load(); },
+      error: (e) => { this.busyKey = ''; this.error = this.messageOf(e, 'Could not request a run.'); this.load(); }
+    });
+  }
+
+  public stateLabel(f: any): string {
+    return f.buildState === 'Built' ? 'Built' : f.buildState === 'Partial' ? 'Partly built' : 'Not built yet';
+  }
+
+  public stateClass(f: any): string {
+    return f.buildState === 'Built' ? 'bg-success' : f.buildState === 'Partial' ? 'bg-warning text-dark' : 'bg-secondary';
+  }
+
+  public waitingLong(f: any): boolean {
+    if (!f.openRun || f.openRun.status !== 'Requested') { return false; }
+    return Date.now() - new Date(f.openRun.requestedAt).getTime() > 90 * 1000;
+  }
+
+  private messageOf(e: any, fallback: string): string {
+    return (e && e.error && (e.error.message || e.error.title)) || fallback;
+  }
+}

+<!-- Main Content -->
+<div class="main-content">
+	<div class="page-header">
+		<div class="page-block">
+			<div class="row align-items-center">
+				<div class="col-auto">
+					<div class="page-header-title">
+						<h4>{{app.Localize('AI Control')}}</h4>
+					</div>
+					<ul class="breadcrumb">
+						<li class="breadcrumb-item">
+							<a [routerLink]="['/']">
+								<i class="fa fa-home me-1"></i>
+								{{app.Localize('Home')}}
+							</a>
+						</li>
+						<li class="breadcrumb-item">{{app.Localize('AI Control')}}</li>
+					</ul>
+				</div>
+				<div class="col">
+					<div class="float-end">
+						<button type="button" class="btn btn-outline-secondary" (click)="load()" [disabled]="loading">
+							<i class="fa fa-rotate me-1"></i>{{app.Localize('Refresh')}}
+						</button>
+					</div>
+				</div>
+			</div>
+		</div>
+	</div>
+
+	<div class="alert alert-danger" *ngIf="error">{{error}}</div>
+	<div class="alert alert-success" *ngIf="message">{{message}}</div>
+
+	<p class="text-muted">
+		{{onCount}} of {{features.length}} AI features are on for your company. Switching one off takes effect at once: PesoWeb refuses what that AI proposes,
+		so it cannot change a price even if the agent keeps running. Your margin rules and the Approval Center still apply to everything that is on.
+	</p>
+
+	<div class="row g-3">
+		<div class="col-md-6 col-xl-4" *ngFor="let f of features">
+			<div class="card h-100" [class.border-success]="f.enabled && f.buildState !== 'NotBuilt'">
+				<div class="card-body d-flex flex-column">
+					<div class="d-flex justify-content-between align-items-start">
+						<h5 class="mb-1">{{f.name}}</h5>
+						<div class="form-check form-switch">
+							<input class="form-check-input" type="checkbox" role="switch" [id]="'sw-' + f.key" [checked]="f.enabled" [disabled]="busyKey === f.key" (change)="toggle(f)">
+							<label class="form-check-label small" [for]="'sw-' + f.key">{{f.enabled ? app.Localize('On') : app.Localize('Off')}}</label>
+						</div>
+					</div>
+					<div class="mb-2"><span class="badge" [ngClass]="stateClass(f)">{{stateLabel(f)}}</span></div>
+					<p class="small text-muted flex-grow-1">{{f.description}}</p>
+
+					<div class="small mb-2" *ngIf="f.openRun">
+						<i class="fa fa-spinner fa-spin me-1"></i>
+						<span *ngIf="f.openRun.status === 'Requested'">{{app.Localize('Run requested, waiting for the agent')}}</span>
+						<span *ngIf="f.openRun.status === 'Running'">{{app.Localize('The agent is running now')}}</span>
+						<div class="text-warning" *ngIf="waitingLong(f)">
+							The agent has not picked this up. Start the agent runner (python -m simpeso.agent_service) for this company.
+						</div>
+					</div>
+					<div class="small mb-2" *ngIf="!f.openRun && f.lastRun">
+						<span class="fw-bold" [class.text-success]="f.lastRun.status === 'Done'" [class.text-danger]="f.lastRun.status === 'Failed'" [class.text-muted]="f.lastRun.status === 'Cancelled'">Last run: {{f.lastRun.status}}</span>
+						<span *ngIf="f.lastRun.finishedAt"> · {{f.lastRun.finishedAt | date:'medium'}}</span>
+						<div class="text-muted">{{f.lastRun.summary}}</div>
+					</div>
+
+					<div>
+						<button type="button" class="btn btn-sm btn-primary" *ngIf="f.canRun" (click)="run(f)" [disabled]="!f.enabled || !!f.openRun || busyKey === f.key">
+							<i class="fa fa-play me-1"></i>{{app.Localize('Run now')}}
+						</button>
+						<span class="small text-muted" *ngIf="!f.canRun">{{app.Localize('Nothing to run yet')}}</span>
+					</div>
+				</div>
+			</div>
+		</div>
+	</div>
+</div>
diff --git a/ClientApp/src/app/ai/aicontrol/aicontrol.component.ts b/ClientApp/src/app/ai/aicontrol/aicontrol.component.ts
